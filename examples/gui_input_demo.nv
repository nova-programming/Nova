import gui

# ═══════════════════════════════════════════════════════════════════════════
#  Nova GUI — Live Keyboard Input & Screen Display Demo
#  All visual styling is separated into examples/styles/input_demo.nss
# ═══════════════════════════════════════════════════════════════════════════

# --- Output Display Target ---
screen_display = txt("Waiting for input...", {"class": "monitor-text"})

# --- Live Input Field ---
user_input = input_field("Type your message here...", {"class": "text-input"})

# --- Action Buttons with direct class, id, onClick parameters ---
submit_btn = btn("btn-primary", "print_btn", "submit", "Print to Screen", {
    "source": user_input,
    "target": screen_display,
    "prefix": "Text: "
})

clear_btn = btn("btn-secondary", "clear_btn", "clear", "Clear Screen", {
    "target": screen_display
})

# --- Main Layout Tree ---
app_ui = div([

    # Header bar
    row([
        badge("NV", {"class": "brand-badge"}),
        h2("Nova Text Input", {"class": "app-title"}),
        spacer({}),
        badge("Live Typing", {"class": "badge-live"})
    ], {"class": "header-row"}),

    divider({"class": "divider"}),

    # Textbox input section card
    card([
        label("INTERACTIVE TEXTBOX", {"class": "section-label"}),
        h3("Type Your Text Below", {"class": "section-title"}),
        txt("Click the box to focus. Type any characters, or press Backspace to edit.", {
            "class": "section-description"
        }),
        user_input,
        row([
            submit_btn,
            clear_btn
        ], {"class": "button-row"})
    ], {"class": "card-section"}),

    # UI Monitor / Screen Display Card
    card([
        row([
            badge("MONITOR", {"class": "monitor-badge"}),
            h3("UI Display Screen", {"class": "section-title"}),
            spacer({}),
            label("LIVE OUTPUT", {"class": "monitor-status"})
        ], {"class": "header-row"}),

        card([
            screen_display
        ], {"class": "monitor-box"})
    ], {"class": "card-section"})

], {"class": "app-root"})

# Launch GUI with NSS stylesheet
gui("Nova Live Text Input Showcase", 520, 580, app_ui, {
    "nss": "examples/styles/input_demo.nss"
})
