import gui

# ═══════════════════════════════════════════════════════════════════════════
#  Nova GUI — Live Keyboard Input & Screen Display Demo
#  All visual styling is separated into examples/styles/input_demo.nss
# ═══════════════════════════════════════════════════════════════════════════

# --- Output Display Target ---
screen_display = txt("monitor-text", "screen_display", "Waiting for input...", {})

# --- Live Input Field ---
user_input = input_field("text-input", "user_input", "Type your message here...", {})

# --- Action Buttons with direct class, id, onClick parameters ---
submit_btn = btn("btn-primary", "print_btn", "submit", "Print to Screen", {
    "source": user_input,
    "target": screen_display,
    "prefix": "Text: "
})

clear_btn = btn("btn-secondary", "clear_btn", "clear", "Clear Screen", {
    "target": screen_display
})

# --- Main Layout Tree ---
app_ui = div("app-root", "", [

    # Header bar
    row("header-row", "", [
        badge("brand-badge", "", "NV", {}),
        h2("app-title", "", "Nova Text Input", {}),
        spacer("", "", {}),
        badge("badge-live", "", "Live Typing", {})
    ], {}),

    divider("divider", "", {}),

    # Textbox input section card
    card("card-section", "", [
        label("section-label", "", "INTERACTIVE TEXTBOX", {}),
        h3("section-title", "", "Type Your Text Below", {}),
        txt("section-description", "", "Click the box to focus. Type any characters, or press Backspace to edit.", {}),
        user_input,
        row("button-row", "", [
            submit_btn,
            clear_btn
        ], {})
    ], {}),

    # UI Monitor / Screen Display Card
    card("card-section", "", [
        row("header-row", "", [
            badge("monitor-badge", "", "MONITOR", {}),
            h3("section-title", "", "UI Display Screen", {}),
            spacer("", "", {}),
            label("monitor-status", "", "LIVE OUTPUT", {})
        ], {}),

        card("monitor-box", "", [
            screen_display
        ], {})
    ], {})

], {})

# Launch GUI with NSS stylesheet
gui("Nova Live Text Input Showcase", 520, 580, app_ui, {
    "nss": "examples/styles/input_demo.nss"
})
