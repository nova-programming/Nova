import gui

# 1. Header Bar: Logo Badge + Title + Live Status Pill
logo = Container([
    Text("NV", properties={
        "color": "#cba6f7",
        "font-size": 15,
        "font-weight": "bold"
    })
], properties={
    "background-color": "#313244",
    "border-radius": 6,
    "padding-left": 10,
    "padding-right": 10,
    "padding-top": 4,
    "padding-bottom": 4
})

title = Text("Nova Developer Studio", properties={
    "color": "#cdd6f4",
    "font-size": 22,
    "font-weight": "bold"
})

status_text = Text("60 FPS Direct GDI", properties={
    "color": "#a6e3a1",
    "font-size": 12,
    "font-weight": "bold"
})

status_badge = Container([
    status_text
], properties={
    "background-color": "#1e1e2e",
    "border-radius": 14,
    "border-width": 1,
    "border-color": "#313244",
    "padding-left": 12,
    "padding-right": 12,
    "padding-top": 5,
    "padding-bottom": 5
})

header_bar = Row([
    logo,
    title,
    status_badge
], properties={
    "align-items": "center",
    "gap": 14
})

subtitle = Text("Pure native desktop canvas with zero web bloat and full NSS styling.", properties={
    "color": "#a6adc8",
    "font-size": 13
})

# 2. Three Metric Cards Row (Fully responsive - backend distributes remaining row width)
card_speed_val = Text("0 clicks", properties={
    "color": "#89b4fa",
    "font-size": 20,
    "font-weight": "bold",
    "value": 0
})

card_speed = Container([
    Text("EVENT COUNTER", properties={
        "color": "#a6adc8",
        "font-size": 11,
        "font-weight": "bold"
    }),
    card_speed_val,
    Text("Live Responsive State", properties={
        "color": "#6c7086",
        "font-size": 11
    })
], properties={
    "background-color": "#1e1e2e",
    "border-radius": 8,
    "border-width": 1,
    "border-color": "#313244",
    "padding": 14,
    "gap": 4
})

card_ram = Container([
    Text("RAM FOOTPRINT", properties={
        "color": "#a6adc8",
        "font-size": 11,
        "font-weight": "bold"
    }),
    Text("1.8 MB", properties={
        "color": "#a6e3a1",
        "font-size": 20,
        "font-weight": "bold"
    }),
    Text("Zero WebViews", properties={
        "color": "#6c7086",
        "font-size": 11
    })
], properties={
    "background-color": "#1e1e2e",
    "border-radius": 8,
    "border-width": 1,
    "border-color": "#313244",
    "padding": 14,
    "gap": 4
})

card_arch = Container([
    Text("TARGET ARCH", properties={
        "color": "#a6adc8",
        "font-size": 11,
        "font-weight": "bold"
    }),
    Text("x86_64", properties={
        "color": "#f9e2af",
        "font-size": 20,
        "font-weight": "bold"
    }),
    Text("Win32 Dual-Buffer", properties={
        "color": "#6c7086",
        "font-size": 11
    })
], properties={
    "background-color": "#1e1e2e",
    "border-radius": 8,
    "border-width": 1,
    "border-color": "#313244",
    "padding": 14,
    "gap": 4
})

metrics_row = Row([
    card_speed,
    card_ram,
    card_arch
], properties={
    "gap": 14
})

# 3. Interactive Action Center Card
ctrl_title = Text("INTERACTIVE CONTROLS", properties={
    "color": "#cdd6f4",
    "font-size": 14,
    "font-weight": "bold"
})

ctrl_desc = Text("Hover and click to test real-time native hit-testing and event dispatching:", properties={
    "color": "#a6adc8",
    "font-size": 12
})

console_log = Text("  [LIVE] Ready for user interaction. Click any button above.", properties={
    "color": "#a6adc8",
    "font-size": 12
})

btn_inc = Button("+ Increment Count", 1, properties={
    "background-color": "#89b4fa",
    "hover-background-color": "#b4befe",
    "pressed-background-color": "#74c7ec",
    "color": "#11111b",
    "font-size": 13,
    "border-radius": 8,
    "padding-left": 18,
    "padding-right": 18,
    "padding-top": 9,
    "padding-bottom": 9,
    "action": "increment",
    "target": card_speed_val,
    "suffix": " clicks",
    "log-target": console_log
})

btn_reset = Button("Reset", 2, properties={
    "background-color": "#313244",
    "hover-background-color": "#45475a",
    "pressed-background-color": "#181825",
    "color": "#cdd6f4",
    "font-size": 13,
    "border-radius": 8,
    "padding-left": 18,
    "padding-right": 18,
    "padding-top": 9,
    "padding-bottom": 9,
    "action": "reset",
    "target": card_speed_val,
    "linked-button": btn_inc,
    "suffix": " clicks",
    "log-target": console_log
})

btn_mode = Button("Toggle Turbo", 3, properties={
    "background-color": "#fab387",
    "hover-background-color": "#f9e2af",
    "pressed-background-color": "#e0a177",
    "color": "#11111b",
    "font-size": 13,
    "border-radius": 8,
    "padding-left": 18,
    "padding-right": 18,
    "padding-top": 9,
    "padding-bottom": 9,
    "action": "toggle",
    "target": status_text,
    "state1": "60 FPS Direct GDI",
    "state2": "120 FPS Turbo GDI",
    "log-target": console_log
})

button_row = Row([
    btn_inc,
    btn_reset,
    btn_mode
], properties={
    "gap": 12
})

control_card = Container([
    ctrl_title,
    ctrl_desc,
    button_row
], properties={
    "background-color": "#1e1e2e",
    "border-radius": 10,
    "border-width": 1,
    "border-color": "#313244",
    "padding": 20,
    "gap": 14
})

# 4. Embedded Terminal Output Block
console_card = Container([
    Text("> nova run examples/gui_counter.nv", properties={
        "color": "#89b4fa",
        "font-size": 12
    }),
    Text("  [OK] 100% Native binary compiled with zero external dependencies", properties={
        "color": "#a6e3a1",
        "font-size": 12
    }),
    console_log
], properties={
    "background-color": "#11111b",
    "border-radius": 8,
    "border-width": 1,
    "border-color": "#313244",
    "padding": 16,
    "gap": 6
})

# 5. Root Layout Container
root = Container([
    header_bar,
    subtitle,
    metrics_row,
    control_card,
    console_card
], properties={
    "background-color": "#181825",
    "padding": 26,
    "gap": 16
})

# 6. Launch Application with Full Lifecycle Management
gui("Nova Developer Studio", 620, 580, root, properties={
    "background-color": "#181825"
})
