import gui

def run() {
    title = gui.Title("Hello World", {})
    sub = gui.Text("Welcome to Nova! Your native desktop app is running at 60 FPS.", {"color": "#a6adc8"})
    btn = gui.Button("Click Me!", 1, {"bg": "#89b4fa", "color": "#11111b", "bold": 1})
    root = gui.Column([title, sub, btn], {"padding": 24, "gap": 12, "bg": "#11111b"})
    gui.App("My First Nova App", root, 460, 280, {})
}

run()

