/* =============================================================================
   Nova Style Sheet (NSS) — Widgets Showcase Theme
   Demonstrating NSS pseudo-classes (:hover, :active) & rich interactive widgets
   ============================================================================= */

#window {
    bg: #181825;
}

.header {
    bg: #181825;
    p: 14;
    gap: 10;
    align: center;
}

.brand-badge {
    bg: #cba6f7;
    color: #11111b;
    r: 8;
    px: 10;
    py: 4;
    bold;
    size: 11;
}

.app-title {
    color: #cdd6f4;
    size: 20;
    bold;
}

.badge-secondary {
    bg: #313244;
    color: #a6adc8;
    r: 8;
    px: 8;
    py: 3;
    size: 11;
    border: 1;
    border_color: #45475a;
}

.divider {
    bg: #313244;
    h: 1;
}

.main-content {
    gap: 12;
    p: 12;
}

.col-panel {
    gap: 12;
    flex: 1;
}

.card {
    bg: #1e1e2e;
    r: 8;
    p: 14;
    gap: 10;
    border: 1;
    border_color: #313244;
}

.card:hover {
    border_color: #45475a;
}

.card-title {
    color: #cdd6f4;
    size: 15;
    bold;
}

.card-subtitle {
    color: #6c7086;
    size: 11;
    bold;
}

.btn-primary {
    bg: #89b4fa;
    color: #11111b;
    r: 6;
    px: 14;
    py: 7;
    size: 13;
    bold;
}

.btn-primary:hover {
    bg: #b4befe;
    color: #11111b;
}

.btn-primary:active {
    bg: #74c7ec;
    color: #11111b;
}

.btn-secondary {
    bg: #313244;
    color: #cdd6f4;
    r: 6;
    px: 12;
    py: 7;
    size: 13;
    border: 1;
    border_color: #45475a;
}

.btn-secondary:hover {
    bg: #45475a;
    color: #ffffff;
    border_color: #585b70;
}

.btn-secondary:active {
    bg: #181825;
    color: #a6adc8;
}

.status-bar {
    bg: #181825;
    p: 10;
    r: 6;
    border: 1;
    border_color: #313244;
}

.status-text {
    color: #a6adc8;
    size: 12;
}

.value-display {
    color: #89b4fa;
    size: 16;
    bold;
}
