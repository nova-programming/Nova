/* =============================================================================
   Nova Style Sheet (NSS) — Modern Dark Theme
   All visual styling for the Nova GUI application.
   ============================================================================= */

#window {
    bg: #181825;
}

.header {
    bg: #181825;
    p: 14;
    gap: 10;
    align: center;
}

.brand-badge {
    bg: #cba6f7;
    color: #11111b;
    r: 8;
    px: 10;
    py: 4;
    bold;
    size: 11;
}

.app-title {
    color: #cdd6f4;
    size: 20;
    bold;
}

.badge-secondary {
    bg: #313244;
    color: #a6adc8;
    r: 8;
    px: 8;
    py: 3;
    size: 11;
    border: 1;
    border_color: #45475a;
}

.divider {
    bg: #313244;
    h: 1;
}

.main-content {
    gap: 12;
    p: 12;
}

.nav-sidebar {
    bg: #1e1e2e;
    p: 10;
    gap: 4;
    w: 180;
    border: 1;
    border_color: #313244;
    r: 8;
}

.nav-label {
    color: #6c7086;
    size: 10;
    bold;
    px: 6;
    py: 4;
}

.nav-item {
    bg: #1e1e2e;
    color: #cdd6f4;
    hover: #313244;
    press: #45475a;
    r: 6;
    px: 10;
    py: 6;
    size: 12;
}

.nav-item-active {
    bg: #313244;
    color: #89b4fa;
    hover: #45475a;
    press: #181825;
    r: 6;
    px: 10;
    py: 6;
    size: 12;
    bold;
}

.content-area {
    gap: 12;
    w: 500;
}

.card {
    bg: #1e1e2e;
    r: 8;
    border: 1;
    border_color: #313244;
    p: 16;
    gap: 12;
}

.card-title {
    color: #cdd6f4;
    size: 15;
    bold;
}

.card-subtitle {
    color: #6c7086;
    size: 11;
}

.counter-display {
    color: #89b4fa;
    size: 28;
    bold;
}

.btn-primary {
    bg: #89b4fa;
    color: #11111b;
    hover: #b4befe;
    press: #74c7ec;
    r: 6;
    px: 18;
    py: 8;
    size: 13;
    bold;
}

.btn-secondary {
    bg: #313244;
    color: #cdd6f4;
    hover: #45475a;
    press: #181825;
    r: 6;
    px: 18;
    py: 8;
    size: 13;
}

.status-text {
    color: #6c7086;
    size: 12;
}

.search-input {
    bg: #181825;
    color: #cdd6f4;
    border: 1;
    border_color: #45475a;
    r: 6;
    px: 12;
    py: 8;
    hover: #313244;
}

.pill-blue {
    bg: #89b4fa;
    color: #11111b;
    r: 6;
    px: 8;
    py: 3;
    size: 11;
}

.pill-green {
    bg: #a6e3a1;
    color: #11111b;
    r: 6;
    px: 8;
    py: 3;
    size: 11;
}

.pill-yellow {
    bg: #f9e2af;
    color: #11111b;
    r: 6;
    px: 8;
    py: 3;
    size: 11;
}

.pill-purple {
    bg: #cba6f7;
    color: #11111b;
    r: 6;
    px: 8;
    py: 3;
    size: 11;
}

.pill-pink {
    bg: #f5c2e7;
    color: #11111b;
    r: 6;
    px: 8;
    py: 3;
    size: 11;
}
