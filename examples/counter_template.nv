import gui

def run() {
    count = gui.StateInt(0)
    badge = gui.Text("0", {"bind": count, "prefix": "Count: ", "suffix": " clicks", "size": 18, "bold": 1, "color": "#89b4fa"})
    inc_btn = gui.Button("Increase (+1)", 1, {"action": "increment", "state": count})
    rst_btn = gui.Button("Reset (0)", 2, {"action": "reset", "state": count})

    card = gui.Card([
        gui.Heading("Reactive Counter", {}),
        badge,
        gui.Row([inc_btn, rst_btn], {"gap": 8})
    ], {"padding": 20, "gap": 12})

    root = gui.Column([card], {"padding": 24, "bg": "#11111b"})
    gui.App("Nova Counter App", root, 420, 260, {})
}

run()

