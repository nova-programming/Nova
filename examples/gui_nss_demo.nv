import gui

# ═══════════════════════════════════════════════════════════════════════════
#  Nova GUI — NSS Showcase
#  All visual styling lives in examples/styles/app.nss
#  Behavior uses native action properties so compiled executables can dispatch it.
# ═══════════════════════════════════════════════════════════════════════════

# --- Shared state widgets ---
counter_val = txt("counter-display", "counter_val", "0 clicks", {})
status_log  = txt("status-text", "status_log", "Ready — click a button below.", {})

# --- UI Structure ---
app_ui = div("root-window", "", [

    # ── Header bar ──────────────────────────────────────────────────────────
    row("header", "", [
        badge("brand-badge", "", "NV", {}),
        h2("app-title", "", "Nova GUI", {}),
        spacer("spacer", "", {}),
        badge("badge-secondary", "", "v2.0  NSS Styled", {})
    ], {}),

    divider("divider", "", {}),

    # ── Main content area ───────────────────────────────────────────────────
    row("main-content", "", [

        # Left panel — navigation sidebar
        col("nav-sidebar", "", [
            label("nav-label", "", "SECTIONS", {}),
            nav_item("nav-item-active", "", "  Overview", {}),
            nav_item("nav-item", "", "  Counter", {}),
            nav_item("nav-item", "", "  Components", {}),
            nav_item("nav-item", "", "  Settings", {}),
            divider("divider", "", {}),
            label("nav-label", "", "RESOURCES", {}),
            nav_item("nav-item", "", "  Documentation", {}),
            nav_item("nav-item", "", "  Examples", {}),
            nav_item("nav-item", "", "  Galaxy Pkgs", {})
        ], {}),

        # Right panel — content area
        col("content-area", "", [

            # Search bar
            input_field("search-input", "search_bar", "Search components or actions...", {}),

            # Counter card
            card("card", "", [
                label("card-subtitle", "", "INTERACTIVE EVENT COUNTER", {}),
                row("counter-row", "", [
                    counter_val,
                    spacer("spacer", "", {}),
                    col("counter-meta", "", [
                        label("card-subtitle", "", "clicks", {}),
                        label("card-subtitle", "", "recorded", {})
                    ], {})
                ], {}),

                # Native action dispatch keeps this demo compatible with
                # compiled executables. Dynamic call("name", args) is VM-only.
                row("button-row", "", [
                    btn("btn-primary", "", "increment", "+ Increment", {
                        "target": counter_val, "suffix": " clicks", "log": status_log}),
                    btn("btn-secondary", "", "reset", "Reset", {
                        "target": counter_val, "suffix": " clicks", "log": status_log})
                ], {})
            ], {}),

            # Widget gallery card
            card("card", "", [
                h3("card-title", "", "Widget Gallery", {}),
                txt("card-subtitle", "", "Clean HTML+CSS separation — zero inline styling in .nv source:", {}),
                row("badge-row", "", [
                    badge("pill-blue", "", "btn()", {}),
                    badge("pill-green", "", "div()", {}),
                    badge("pill-yellow", "", "row()", {}),
                    badge("pill-purple", "", "card()", {}),
                    badge("pill-pink", "", "input_field()", {})
                ], {})
            ], {}),

            # Status bar
            status_log

        ], {})

    ], {})

], {})

gui("Nova GUI — NSS Demo", 740, 580, app_ui, {"style": "examples/styles/app.nss"})
