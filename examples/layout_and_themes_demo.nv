import gui

def run_layout_demo() {
    # 1. Space-between top bar with Title, Theme Switcher button and status badge
    top_title = gui.Title("Nova Layout & Themes", {"size": 20})
    theme_btn = gui.Button("Toggle Theme", 101, {"action": "toggle_theme", "bold": 1})
    stat_badge = gui.Text("Theme Active", {"size": 12, "color": "#a6e3a1"})

    header_bar = gui.Row([top_title, theme_btn, stat_badge], {
        "justify": "space-between",
        "align": "center",
        "w": 660,
        "h": 46,
        "bg": "#181825",
        "px": 16,
        "r": 6
    })

    # 2. Flexible columns: Sidebar (flex: 1 with min_w) & Content (flex: 2)
    nav_item1 = gui.Button("Dashboard", 201, {"w": 160, "h": 32, "bg": "#313244", "color": "#cdd6f4"})
    nav_item2 = gui.Button("Components", 202, {"w": 160, "h": 32, "bg": "#1e1e2e", "color": "#a6adc8"})
    nav_item3 = gui.Button("Settings", 203, {"w": 160, "h": 32, "bg": "#1e1e2e", "color": "#a6adc8"})

    sidebar = gui.Column([
        gui.Heading("Navigation", {"size": 14}),
        nav_item1,
        nav_item2,
        nav_item3
    ], {
        "flex": 1,
        "min_w": 180,
        "max_w": 220,
        "bg": "#181825",
        "p": 12,
        "gap": 8,
        "r": 6
    })

    content_card = gui.Card([
        gui.Heading("Responsive Flex Area (Flex: 2)", {"size": 16}),
        gui.Text("This card takes double the flexible width of the sidebar and honors min/max constraints.", {"color": "#cdd6f4"}),
        gui.Divider({}),
        gui.Text("Space-Between & Space-Around justification distributing space automatically.", {"color": "#6c7086"}),
        gui.Row([
            gui.Button("Action Alpha", 301, {"bg": "#89b4fa", "color": "#11111b"}),
            gui.Button("Action Beta", 302, {"bg": "#313244", "color": "#cdd6f4"})
        ], {"gap": 10, "justify": "start"})
    ], {
        "flex": 2,
        "p": 16,
        "gap": 10
    })

    body_row = gui.Row([sidebar, content_card], {
        "w": 660,
        "h": 380,
        "gap": 12
    })

    # 3. Root container
    root = gui.Column([
        header_bar,
        gui.Spacer({"height": 8}),
        body_row
    ], {
        "w": 700,
        "h": 500,
        "p": 20,
        "gap": 10,
        "bg": "#11111b"
    })

    gui.App("Nova Layout & Themes Showcase", root, 700, 520, {})
}

run_layout_demo()

