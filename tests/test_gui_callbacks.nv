# Regression test for GUI first-class function callbacks in nova/stdlib/gui.nv
import gui

def on_button_clicked(w: Widget) {
    c = 0
    if w.props.has("test_clicks") == 1 {
        c = w.props.get("test_clicks")
    }
    c = c + 1
    w.props.set("test_clicks", c)
    w.text = "Clicked " + str(c)
}

def on_btn2_clicked(w: Widget) {
    w.text = "Btn2 Clicked"
}

def on_checkbox_toggled(state: int, w: Widget) {
    w.props.set("test_toggled", state)
}

def on_slider_changed(val: int, w: Widget) {
    w.props.set("test_val", val)
}

def on_input_submitted(txt: string, w: Widget) {
    w.props.set("test_submitted", txt)
}

def main() {
    print("=== Test 1: Button Shorthand with Callback ===")
    btn = gui.button("Click Me", on_button_clicked)
    if btn.on_click_fn == 0 {
        print("FAIL: btn.on_click_fn is 0")
        return
    }
    gui.dispatchAction(btn, btn.on_click_id)
    c1 = btn.props.get("test_clicks")
    if c1 != 1 {
        print("FAIL: clicks expected 1, got " + str(c1))
        return
    }
    gui.dispatchAction(btn, btn.on_click_id)
    c2 = btn.props.get("test_clicks")
    if c2 != 2 {
        print("FAIL: clicks expected 2, got " + str(c2))
        return
    }
    if btn.text != "Clicked 2" {
        print("FAIL: btn.text expected 'Clicked 2', got " + btn.text)
        return
    }
    print("Test 1 Passed: clicks = " + str(c2))

    print("=== Test 2: on_click Builder Pattern ===")
    btn2 = gui.Button("Button 2", 99, {})
    gui.on_click(btn2, on_btn2_clicked)
    gui.dispatchAction(btn2, 99)
    if btn2.text != "Btn2 Clicked" {
        print("FAIL: btn2.text expected 'Btn2 Clicked', got " + btn2.text)
        return
    }
    print("Test 2 Passed: text = " + btn2.text)

    print("=== Test 3: Checkbox Toggle Callback ===")
    chk = gui.Checkbox("Enable Turbo", 0, 101, {"on_toggle": on_checkbox_toggled})
    gui.dispatchAction(chk, 101)
    t1 = chk.props.get("test_toggled")
    if t1 != 1 {
        print("FAIL: last_toggle expected 1, got " + str(t1))
        return
    }
    gui.dispatchAction(chk, 101)
    t2 = chk.props.get("test_toggled")
    if t2 != 0 {
        print("FAIL: last_toggle expected 0, got " + str(t2))
        return
    }
    print("Test 3 Passed: toggle states 1 then 0 verified")

    print("=== Test 4: Slider on_change Callback via hitTest ===")
    sld = gui.Slider(0, 0, 100, 202, {"on_change": on_slider_changed, "padding-left": 0, "padding-right": 0})
    sld.pos_x = 0
    sld.pos_y = 0
    sld.width = 100
    sld.height = 20
    # Simulate click at middle (x=50)
    _ = gui.hitTestEx(sld, 50, 10, 1, 0)
    s_val = sld.props.get("test_val")
    if s_val != 50 {
        print("FAIL: last_slider expected 50, got " + str(s_val))
        return
    }
    print("Test 4 Passed: slider val = " + str(s_val))

    print("=== Test 5: Input on_submit Key Dispatch (Enter=13) ===")
    inp = gui.Input("Enter name...", {"on_submit": on_input_submitted})
    inp.props.set("is_focused", 1)
    inp.text = "NovaGUI"
    gui._dispatch_key_event(inp, 13)
    in_val = inp.props.get("test_submitted")
    if in_val != "NovaGUI" {
        print("FAIL: last_submit expected NovaGUI, got " + in_val)
        return
    }
    print("Test 5 Passed: submitted = " + in_val)

    print("=== Test 6: Backward-Compatible String Action ===")
    st = gui.StateInt(10)
    act_btn = gui.Button("Inc", 303, {"action": "increment", "state": st})
    gui.dispatchAction(act_btn, 303)
    if st.val_int != 11 {
        print("FAIL: state expected 11, got " + str(st.val_int))
        return
    }
    print("Test 6 Passed: state = " + str(st.val_int))

    print("ALL GUI CALLBACK TESTS PASSED")
}

main()
