def add(a: int, b: int) -> int {
    return a + b
}

def sub(a: int, b: int) -> int {
    return a - b
}

def apply_op(f: fn, x: int, y: int) -> int {
    return f(x, y)
}

def get_op(choice: int) -> fn {
    if choice == 1 {
        return add
    }
    return sub
}

def main() {
    print("=== Test 1: Storing Function in Local Variable ===")
    my_fn = add
    res1 = my_fn(15, 25)
    print(res1)

    print("=== Test 2: Passing Function as Argument ===")
    res2 = apply_op(add, 100, 50)
    print(res2)
    res3 = apply_op(sub, 100, 50)
    print(res3)

    print("=== Test 3: Returning Function Pointer ===")
    chosen_fn = get_op(2)
    res4 = chosen_fn(80, 30)
    print(res4)

    print("=== Test 4: Function in Dictionary Dispatch ===")
    ops = {"add": add, "sub": sub}
    add_fn = ops["add"]
    res5 = add_fn(12, 18)
    print(res5)

    print("ALL FIRST-CLASS FUNCTION TESTS PASSED")
}

main()
