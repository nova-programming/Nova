# Nova Bare-Metal Hardware & MMIO Primitives Test

# 1. Binary Literals & Bitwise Operations
let mask = 0b10110001
let flag = 0b00000001
let is_set = mask & flag
if is_set == 1 {
    print("PASS: Binary literal and bitwise AND")
}

# 2. Hardware Memory Primitives (mem.read & mem.write with dot notation)
let buf = alloc(64)
mem.write_u8(buf, 0x5A)
mem.write_u16(buf + 2, 0x1234)
mem.write_u32(buf + 4, 0x789ABCDE)
mem.write_u64(buf + 8, 0x0123456789ABCDEF)

let v8 = mem.read_u8(buf)
let v16 = mem.read_u16(buf + 2)
let v32 = mem.read_u32(buf + 4)
let v64 = mem.read_u64(buf + 8)

if v8 == 0x5A {
    print("PASS: mem.read_u8 and mem.write_u8")
}
if v16 == 0x1234 {
    print("PASS: mem.read_u16 and mem.write_u16")
}
if v32 == 0x789ABCDE {
    print("PASS: mem.read_u32 and mem.write_u32")
}

# 3. CPU Intrinsics with clean dot notation
cpu.cli()
cpu.sti()
cpu.outb(0x3F8, 0x41)
let port_val = cpu.inb(0x3F8)

# Invalidate page TLB instruction
cpu.invlpg(0x100000)

print("ALL BAREMETAL TESTS PASSED")


