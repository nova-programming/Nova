def steps(n) {
    count = 0
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2
        } else {
            n = n * 3 + 1
        }
        count = count + 1
    }
    return count
}
best = 0
best_n = 0
for n in range(1, 400000) {
    s = steps(n)
    if s > best {
        best = s
        best_n = n
    }
}
print(best_n)
print(best)
