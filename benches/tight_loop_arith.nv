# Control case: few variables, all of which already fit in the available registers under
# the current declaration-order allocator. A register-allocation change should not regress
# this one -- it's the "already as good as it gets" baseline.
def sum_to(n) {
    s = 0
    i = 1
    while i <= n {
        s = s + i
        i = i + 1
    }
    return s
}

print(sum_to(50000000))
