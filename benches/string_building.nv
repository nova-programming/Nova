# Repeated string concatenation -- each "+" allocates a new ARC-managed string, so this
# is mostly a stress test of _nova_arc_alloc/free churn rather than arithmetic.
def build(n) {
    s = ""
    i = 0
    while i < n {
        s = s + "x"
        i = i + 1
    }
    return len(s)
}

print(build(40000))
