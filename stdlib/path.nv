# Portable path helpers.
# Inputs may use either slash style. These helpers return slash-separated
# paths so source code remains portable; OS backends accept both styles.

def join(pathParts: list[string]) -> string {
    result = ""
    i = 0
    while i < len(pathParts) {
        part = pathParts[i]
        if len(part) > 0 {
            if len(result) > 0 {
                result = result + "/"
            }
            result = result + part
        }
        i = i + 1
    }
    return result
}

def base(targetPath: string) -> string {
    end = len(targetPath)
    i = end - 1
    while i >= 0 {
        if targetPath[i] == "/" or targetPath[i] == "\\" {
            return str_sub(targetPath, i + 1, end)
        }
        i = i - 1
    }
    return targetPath
}

def dir(targetPath: string) -> string {
    end = len(targetPath)
    i = end - 1
    while i >= 0 {
        if targetPath[i] == "/" or targetPath[i] == "\\" {
            if i == 0 {
                return "/"
            }
            return str_sub(targetPath, 0, i)
        }
        i = i - 1
    }
    return "."
}

# True for a leading "/" or "\", or a Windows drive prefix like "C:/" or "C:\".
def isAbsolute(targetPath: string) -> int {
    if len(targetPath) == 0 {
        return 0
    }
    if targetPath[0] == "/" or targetPath[0] == "\\" {
        return 1
    }
    if len(targetPath) >= 3 and targetPath[1] == ":" {
        if targetPath[2] == "/" or targetPath[2] == "\\" {
            return 1
        }
    }
    return 0
}

# Collapses "." segments, resolves ".." against the segments seen so far, and reduces runs of
# "/"/"\\" to a single "/". A leading drive prefix ("C:") or absolute slash is preserved; a
# ".." that would escape an absolute path's root, or past a relative path's known segments, is
# kept literally.
def normalize(targetPath: string) -> string {
    prefix = ""
    rest = targetPath
    if len(targetPath) >= 2 and targetPath[1] == ":" {
        prefix = str_sub(targetPath, 0, 2)
        rest = str_sub(targetPath, 2, len(targetPath))
    }
    absolute = 0
    if len(rest) > 0 and (rest[0] == "/" or rest[0] == "\\") {
        absolute = 1
    }

    segments = []
    n = len(rest)
    i = 0
    while i < n {
        while i < n and (rest[i] == "/" or rest[i] == "\\") {
            i = i + 1
        }
        start = i
        while i < n and rest[i] != "/" and rest[i] != "\\" {
            i = i + 1
        }
        if i > start {
            seg = str_sub(rest, start, i)
            if seg == "." {
                # drop
            } elif seg == ".." {
                if len(segments) > 0 and segments[len(segments) - 1] != ".." {
                    segments.pop()
                } elif absolute == 0 {
                    segments.append(seg)
                }
            } else {
                segments.append(seg)
            }
        }
    }

    joined = join(segments)
    result = prefix
    if absolute == 1 {
        result = result + "/"
    }
    result = result + joined
    if len(result) == 0 {
        return "."
    }
    return result
}

def ext(targetPath: string) -> string {
    name = base(targetPath)
    i = len(name) - 1
    while i >= 0 {
        if name[i] == "." {
            return str_sub(name, i, len(name))
        }
        i = i - 1
    }
    return ""
}

# Normalizes all backslashes to forward slashes for deterministic cross-platform path handling
def toForward(targetPath: string) -> string {
    result = ""
    i = 0
    n = len(targetPath)
    while i < n {
        ch = targetPath[i]
        if ch == "\\" {
            result = result + "/"
        } else {
            result = result + ch
        }
        i = i + 1
    }
    return result
}
