import system

def args() -> list[string] {
    return get_args()
}

def platform() -> string {
    return platform()
}

def get(variableName: string) -> string {
    return system_env_get(variableName)
}

def set(variableName: string, variableValue: string) -> int {
    return system_env_set(variableName, variableValue)
}
