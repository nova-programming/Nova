# ============================================================
# Nova Self-Hosted Parser (stdlib/parser.nv)
# ============================================================

import lexer
import errors

# Text of a Nova string literal body (escape backslash and double quote) for generated source snippets.
def escape_for_source(s: string) -> string {
    out = ""
    i = 0
    while i < len(s) {
        ch = s[i]
        if ch == "\\" { out = out + "/" }
        elif ch == "\"" { out = out + "'" }
        elif ch == "\n" { out = out + " " }
        else { out = out + ch }
        i = i + 1
    }
    return out
}

# assert(cond) / assert(cond, "message")
#   inside a `test` block: print the failure and end the test (the runner counts it)
#   anywhere else: print the failure and stop the program with exit code 1
# Built by parsing a small snippet and plugging the caller's expressions into it.
def build_assert(state: ParserState, call: AstNode, line: int) -> AstNode {
    where = escape_for_source(state.filename) + ":" + str(line)
    has_msg = 0
    if len(call.args) >= 2 { has_msg = 1 }
    text = "    assertion failed (" + where + ")"
    if has_msg == 1 { text = text + ": \" + __assert_msg + \"" }
    leave = "sys_exit(1)"
    if state.in_test == 1 { leave = "return 1" } else { state.needs_system = 1 }
    src = "if not __assert_cond \{\n    print(\"" + text + "\")\n    " + leave + "\n\}\n"
    parsed = parse(tokenize(src), state.filename)
    stmt = parsed[len(parsed) - 1]
    stmt.line = line
    stmt.cond.left = call.args[0]
    if has_msg == 1 {
        # print("..." + __assert_msg + "") : the Variable sits in the middle of two string concatenations
        pnode = stmt.body[0]
        concat = pnode.left
        slot = concat
        if slot.left.kind == "BinOp" { slot = slot.left }
        if slot.right.kind == "Variable" and slot.right.val_str == "__assert_msg" {
            slot.right = call.args[1]
        } elif slot.left.kind == "Variable" and slot.left.val_str == "__assert_msg" {
            slot.left = call.args[1]
        }
    }
    return stmt
}

def canonicalMember(name: string) -> string {
    if name == "asList" { return "as_list" }
    if name == "valueByte" { return "value_byte" }
    if name == "valueWord" { return "value_word" }
    if name == "valueDword" { return "value_dword" }
    if name == "valueQword" { return "value_qword" }
    if name == "getU8" { return "get_u8" }
    if name == "setU8" { return "set_u8" }
    if name == "getU16" { return "get_u16" }
    if name == "setU16" { return "set_u16" }
    if name == "getI32" { return "get_i32" }
    if name == "setI32" { return "set_i32" }
    if name == "copyFrom" { return "copy_from" }
    if name == "fillI32" { return "fill_i32" }
    return name
}

def publicConst(module: string, constName: string) -> int {
    if module == "align" {
        if constName == "left" or constName == "center" or constName == "right" or constName == "top" or constName == "middle" or constName == "bottom" { return 1 }
    }
    if module == "size" {
        if constName == "fit" or constName == "fill" { return 1 }
    }
    if module == "style" {
        if constName == "plain" or constName == "hover" or constName == "primary" { return 1 }
    }
    if module == "ui" {
        if constName == "left" or constName == "center" or constName == "right" or constName == "top" or constName == "middle" or constName == "bottom" or constName == "plain" or constName == "hover" or constName == "primary" or constName == "default" or constName == "text" or constName == "secondary" or constName == "muted" or constName == "accent" or constName == "ok" or constName == "warn" or constName == "err" or constName == "fit" or constName == "fill" { return 1 }
    }
    return 0
}

def moduleConst(module: string, constName: string) -> int {
    if module == "align" {
        if constName == "left" { return 0 }
        if constName == "center" { return 1 }
        if constName == "right" { return 2 }
        if constName == "top" { return 0 }
        if constName == "middle" { return 1 }
        if constName == "bottom" { return 2 }
    }
    if module == "size" {
        if constName == "fit" { return 0 - 1 }
        if constName == "fill" { return 0 - 2 }
    }
    if module == "style" {
        if constName == "plain" { return 0 }
        if constName == "hover" { return 1 }
        if constName == "primary" { return 2 }
    }
    if module == "ui" {
        if constName == "left" { return 0 }
        if constName == "center" { return 1 }
        if constName == "right" { return 2 }
        if constName == "top" { return 0 }
        if constName == "middle" { return 1 }
        if constName == "bottom" { return 2 }
        if constName == "plain" { return 0 }
        if constName == "hover" { return 1 }
        if constName == "primary" { return 2 }
        if constName == "default" { return 0 }
        if constName == "text" { return 1 }
        if constName == "secondary" { return 2 }
        if constName == "muted" { return 3 }
        if constName == "accent" { return 4 }
        if constName == "ok" { return 5 }
        if constName == "warn" { return 6 }
        if constName == "err" { return 7 }
        if constName == "fit" { return 0 - 1 }
        if constName == "fill" { return 0 - 2 }
    }
    return 0
}

data AstNode {
    kind: string
    val_int: int
    val_str: string
    line: int
    col: int
    is_float: int
    left: AstNode
    right: AstNode
    cond: AstNode
    body: list
    else_body: list
    params: list
    args: list
    methods: list
    param_types: list
    name: string
    return_type: string
    lib: string
    inferred_type: any
    param_defaults: list
    arg_names: list
    arg_is_kw: list
    file: string
}

data ParserState {
    tokens: list
    pos: int
    filename: string
    comp_counter: int
    imported_modules: dict
    data_fields: dict
    ctors_used: list
    const_table: dict
    containers: dict
    container_ends: dict
    data_field_defaults: dict
    in_test: int
    needs_system: int
    test_mode: string
    test_count: int
}

def current_tok(state: ParserState) -> Token {
    if state.pos < len(state.tokens) {
        return state.tokens[state.pos]
    }
    t = Token()
    t.kind = "EOF"
    t.val = ""
    t.line = 0
    t.col = 0
    return t
}

def peek_tok(state: ParserState, offset: int) -> Token {
    target = state.pos + offset
    if target < len(state.tokens) {
        return state.tokens[target]
    }
    t = Token()
    t.kind = "EOF"
    t.val = ""
    t.line = 0
    t.col = 0
    return t
}

def eat_tok(state: ParserState, expected_kind: string) -> Token {
    tok = current_tok(state)
    if tok.kind == expected_kind {
        state.pos = state.pos + 1
        return tok
    }
    errors.err("Syntax", state.filename, tok.line, "expected " + expected_kind + " but got " + tok.kind, "check the syntax around this token — did you forget a closing brace, parenthesis, or keyword?", tok.col)
    return tok
}

def eat_prop_name(state: ParserState) -> Token {
    tok = current_tok(state)
    if tok.kind == "IDENT" {
        state.pos = state.pos + 1
        return tok
    }
    if tok.kind == "HAS" {
        state.pos = state.pos + 1
        return tok
    }
    if tok.kind == "OPEN" {
        state.pos = state.pos + 1
        return tok
    }
    if tok.kind == "READ" {
        state.pos = state.pos + 1
        return tok
    }
    if tok.kind == "WRITE" {
        state.pos = state.pos + 1
        return tok
    }
    if tok.kind == "CLOSE" {
        state.pos = state.pos + 1
        return tok
    }
    if tok.kind == "LEN" {
        state.pos = state.pos + 1
        return tok
    }
    if tok.kind == "STR" {
        state.pos = state.pos + 1
        return tok
    }
    if tok.kind == "ALLOC" {
        state.pos = state.pos + 1
        return tok
    }
    if tok.kind == "FREE" {
        state.pos = state.pos + 1
        return tok
    }
    errors.err("Syntax", state.filename, tok.line, "expected property name but got " + tok.kind, "property names must be identifiers or built-in method names", tok.col)
    return tok
}

def make_var(name: string, line: int) -> AstNode {
    n = AstNode()
    n.kind = "Variable"
    n.val_str = name
    n.line = line
    return n
}

def make_num(val: int, line: int) -> AstNode {
    return make_number_node(val, line, 0)
}

def parse_list_comprehension(state: ParserState, expr: AstNode) -> AstNode {
    eat_tok(state, "FOR")
    var_name = eat_tok(state, "IDENT").val
    eat_tok(state, "IN")
    iterable = parse_expr(state)
    filter_expr = 0
    check = current_tok(state)
    if check.kind == "IF" {
        eat_tok(state, "IF")
        filter_expr = parse_expr(state)
    }
    eat_tok(state, "RBRACK")
    
    c = state.comp_counter
    state.comp_counter = c + 1
    result_var_name = "__comp_" + str(c)
    iter_var_name = "__iter_" + str(c)
    index_var_name = "__i_" + str(c)
    line = expr.line
    
    block = AstNode()
    block.kind = "Block"
    block.line = line
    block.body = []
    
    # __comp_N = []
    comp_list = AstNode()
    comp_list.kind = "ListLiteral"
    comp_list.line = line
    comp_list.args = []
    
    assign1 = AstNode()
    assign1.kind = "Assignment"
    assign1.line = line
    assign1.val_str = result_var_name
    assign1.left = comp_list
    block.body.append(assign1)
    
    # __iter_N = iterable
    assign2 = AstNode()
    assign2.kind = "Assignment"
    assign2.line = line
    assign2.val_str = iter_var_name
    assign2.left = iterable
    block.body.append(assign2)
    
    # ForLoop body: x = __iter_N[__i_N]; __comp_N.append(expr)
    body_stmts = []
    
    target_assign = AstNode()
    target_assign.kind = "Assignment"
    target_assign.line = line
    target_assign.val_str = var_name
    index_node = AstNode()
    index_node.kind = "ArrayIndex"
    index_node.line = line
    index_node.left = make_var(iter_var_name, line)
    index_node.right = make_var(index_var_name, line)
    target_assign.left = index_node
    body_stmts.append(target_assign)
    
    append_call = AstNode()
    append_call.kind = "MethodCall"
    append_call.line = line
    append_call.left = make_var(result_var_name, line)
    append_call.val_str = "append"
    append_call.args = [expr]
    
    if filter_expr != 0 {
        if_node = AstNode()
        if_node.kind = "IfElse"
        if_node.line = line
        if_node.cond = filter_expr
        if_node.body = [append_call]
        if_node.else_body = []
        body_stmts.append(if_node)
    } else {
        body_stmts.append(append_call)
    }
    
    # for __i_N = 0 to len(__iter_N) - 1 step 1
    for_node = AstNode()
    for_node.kind = "ForLoop"
    for_node.line = line
    for_node.val_str = index_var_name
    for_node.val_int = 0
    for_node.left = make_num(0, line)
    
    len_node = AstNode()
    len_node.kind = "Len"
    len_node.line = line
    len_node.left = make_var(iter_var_name, line)
    
    for_node.right = AstNode()
    for_node.right.kind = "BinOp"
    for_node.right.line = line
    for_node.right.val_str = "-"
    for_node.right.left = len_node
    for_node.right.right = make_num(1, line)
    
    for_node.cond = make_num(1, line)
    for_node.body = body_stmts
    block.body.append(for_node)
    
    block.body.append(make_var(result_var_name, line))
    return block
}

# ---------------- EXPRESSIONS ----------------

def parse_primary(state: ParserState) -> AstNode {
    tok = current_tok(state)
    node = AstNode()
    node.line = tok.line
    node.col = tok.col
    
    if tok.kind == "NUMBER" {
        eat_tok(state, "NUMBER")
        node.kind = "Number"
        has_dot = 0
        ci = 0
        while ci < len(tok.val) {
            if tok.val[ci] == "." { has_dot = 1 }
            ci = ci + 1
        }
        if has_dot == 1 {
            node.is_float = 1
            node.val_str = tok.val
            node.val_int = 0
        } else {
            node.is_float = 0
            node.val_int = atoi(tok.val)
        }
    } elif tok.kind == "STRING" {
        eat_tok(state, "STRING")
        node.kind = "String"
        node.val_str = str_sub(tok.val, 1, len(tok.val) - 1)
    } elif tok.kind == "TRUE" {
        eat_tok(state, "TRUE")
        node.kind = "Boolean"
        node.val_int = 1
    } elif tok.kind == "FALSE" {
        eat_tok(state, "FALSE")
        node.kind = "Boolean"
        node.val_int = 0
    } elif tok.kind == "NULL" {
        eat_tok(state, "NULL")
        node.kind = "Null"
        node.val_int = 0
    } elif tok.kind == "LBRACK" {
        eat_tok(state, "LBRACK")
        node.kind = "ListLiteral"
        node.args = []
        check = current_tok(state)
        if check.kind != "RBRACK" {
            node.args.append(parse_expr(state))
            check = current_tok(state)
            if check.kind == "FOR" {
                node = parse_list_comprehension(state, node.args[0])
            } else {
                while check.kind == "COMMA" {
                    eat_tok(state, "COMMA")
                    node.args.append(parse_expr(state))
                    check = current_tok(state)
                }
                eat_tok(state, "RBRACK")
            }
        } else {
            eat_tok(state, "RBRACK")
        }
    } elif tok.kind == "LBRACE" {
        eat_tok(state, "LBRACE")
        node.kind = "DictLiteral"
        node.args = []
        check = current_tok(state)
        if check.kind != "RBRACE" {
            node.args.append(parse_dict_key(state))
            eat_tok(state, "COLON")
            node.args.append(parse_expr(state))
            check = current_tok(state)
            while check.kind == "COMMA" {
                eat_tok(state, "COMMA")
                node.args.append(parse_dict_key(state))
                eat_tok(state, "COLON")
                node.args.append(parse_expr(state))
                check = current_tok(state)
            }
        }
        eat_tok(state, "RBRACE")
    } elif tok.kind == "LEN" {
        eat_tok(state, "LEN")
        eat_tok(state, "LPAREN")
        node.kind = "Len"
        node.left = parse_expr(state)
        eat_tok(state, "RPAREN")
    } elif tok.kind == "STR" {
        eat_tok(state, "STR")
        eat_tok(state, "LPAREN")
        node.kind = "StrConvert"
        node.left = parse_expr(state)
        eat_tok(state, "RPAREN")
    } elif tok.kind == "SIZEOF" {
        eat_tok(state, "SIZEOF")
        eat_tok(state, "LPAREN")
        node.kind = "SizeOf"
        node.left = parse_expr(state)
        eat_tok(state, "RPAREN")
    } elif tok.kind == "COMPTIME" {
        eat_tok(state, "COMPTIME")
        if current_tok(state).kind == "LBRACE" {
            body = parse_block(state)
            block_node = AstNode()
            block_node.kind = "Block"
            block_node.body = body
            block_node.line = node.line
            block_node.col = node.col
            node.kind = "Comptime"
            node.left = block_node
        } elif current_tok(state).kind == "LPAREN" {
            eat_tok(state, "LPAREN")
            node.kind = "Comptime"
            node.left = parse_expr(state)
            eat_tok(state, "RPAREN")
        } else {
            node.kind = "Comptime"
            node.left = parse_expr(state)
        }
    } elif tok.kind == "OPEN" {
        # `open(path, mode)` returns a raw file handle (int), matching the bootstrap parser's
        # OpenFile node. It must NOT desugar to Openf: openf() returns a wrapper struct, so
        # write(fd, ...)/read(fd)/close(fd) would then receive a wrapper pointer as the handle.
        eat_tok(state, "OPEN")
        eat_tok(state, "LPAREN")
        path_node = parse_expr(state)
        eat_tok(state, "COMMA")
        mode_node = parse_expr(state)
        eat_tok(state, "RPAREN")
        node.kind = "OpenFile"
        node.left = path_node
        node.right = mode_node
    } elif tok.kind == "OPENF" {
        eat_tok(state, "OPENF")
        eat_tok(state, "LPAREN")
        path_node = parse_expr(state)
        mode_node = AstNode()
        mode_node.kind = "String"
        mode_node.val_str = "r"
        mode_node.line = node.line
        mode_node.col = node.col
        
        check_comma = current_tok(state)
        if check_comma.kind == "COMMA" {
            eat_tok(state, "COMMA")
            mode_node = parse_expr(state)
        }
        eat_tok(state, "RPAREN")
        node.kind = "Openf"
        node.left = path_node
        node.right = mode_node
    } elif tok.kind == "READ" {
        eat_tok(state, "READ")
        eat_tok(state, "LPAREN")
        node.kind = "ReadFile"
        node.left = parse_expr(state)
        eat_tok(state, "RPAREN")
    } elif tok.kind == "WRITE" {
        eat_tok(state, "WRITE")
        eat_tok(state, "LPAREN")
        fd_node = parse_expr(state)
        eat_tok(state, "COMMA")
        content_node = parse_expr(state)
        eat_tok(state, "RPAREN")
        node.kind = "WriteFile"
        node.left = fd_node
        node.right = content_node
    } elif tok.kind == "CLOSE" {
        eat_tok(state, "CLOSE")
        eat_tok(state, "LPAREN")
        node.kind = "CloseFile"
        node.left = parse_expr(state)
        eat_tok(state, "RPAREN")
    } elif tok.kind == "ALLOC" {
        eat_tok(state, "ALLOC")
        elem_name = ""
        elem_size = 1
        if current_tok(state).kind == "LBRACK" {
            eat_tok(state, "LBRACK")
            t = current_tok(state)
            if t.kind == "TYPE_INT" { elem_name = "int" }
            elif t.kind == "TYPE_FLOAT" { elem_name = "float" }
            elif t.kind == "TYPE_BOOL" { elem_name = "bool" }
            elif t.kind == "TYPE_STRING" { elem_name = "string" }
            elif t.kind == "TYPE_BYTE" { elem_name = "byte" }
            elif t.kind == "TYPE_VOID" { elem_name = "void" }
            elif t.kind == "IDENT" { elem_name = t.val }
            else {
                errors.err("Syntax", state.filename, t.line, "unexpected token: expected element type inside alloc[T]", "use int, float, bool, string, byte, or a struct name - e.g. alloc[int](10)", t.col)
            }
            eat_tok(state, t.kind)
            eat_tok(state, "RBRACK")
            if elem_name == "byte" {
                elem_size = 1
            } else {
                elem_size = 8
            }
        }
        eat_tok(state, "LPAREN")
        node.kind = "Alloc"
        node.left = parse_expr(state)
        node.val_str = elem_name
        node.val_int = elem_size
        eat_tok(state, "RPAREN")
    } elif tok.kind == "FREE" {
        eat_tok(state, "FREE")
        eat_tok(state, "LPAREN")
        node.kind = "Free"
        node.left = parse_expr(state)
        eat_tok(state, "RPAREN")
    } elif tok.kind == "CLASS" {
        eat_tok(state, "CLASS")
        node.kind = "Variable"
        node.val_str = "class"
    } elif tok.kind == "IDENT" {
        eat_tok(state, "IDENT")
        next_tok = current_tok(state)
        if next_tok.kind == "LPAREN" {
            eat_tok(state, "LPAREN")
            node.kind = "Call"
            node.val_str = tok.val
            node.args = []
            call_arg_names = []
            call_arg_is_kw = []
            has_seen_kw = 0
            check = current_tok(state)
            if check.kind != "RPAREN" {
                nt = peek_tok(state, 1)
                pending_kw = "-"
                pending_is_kw = 0
                if (check.kind == "IDENT" or check.kind == "CLASS") and nt.kind == "EQUALS" {
                    pending_kw = eat_tok(state, check.kind).val
                    pending_is_kw = 1
                    eat_tok(state, "EQUALS")
                    has_seen_kw = 1
                }
                node.args.append(parse_expr(state))
                call_arg_names.append(pending_kw)
                call_arg_is_kw.append(pending_is_kw)
                check = current_tok(state)
                while check.kind == "COMMA" {
                    eat_tok(state, "COMMA")
                    check = current_tok(state)
                    if check.kind != "RPAREN" {
                        nt = peek_tok(state, 1)
                        pending_kw = "-"
                        pending_is_kw = 0
                        if (check.kind == "IDENT" or check.kind == "CLASS") and nt.kind == "EQUALS" {
                            pending_kw = eat_tok(state, check.kind).val
                            pending_is_kw = 1
                            eat_tok(state, "EQUALS")
                            has_seen_kw = 1
                        } else {
                            if has_seen_kw == 1 {
                                errors.err("Syntax", state.filename, tok.line, "positional argument follows keyword argument", "positional arguments must appear before keyword arguments", tok.col)
                            }
                        }
                        node.args.append(parse_expr(state))
                        call_arg_names.append(pending_kw)
                        call_arg_is_kw.append(pending_is_kw)
                        check = current_tok(state)
                    }
                }
            }
            eat_tok(state, "RPAREN")
            node.arg_names = call_arg_names
            node.arg_is_kw = call_arg_is_kw
            if node.val_str == "char_code" and len(node.args) == 1 {
                node.args.append(make_num(0, 0))
            }
            has_defs = 0
            if state.data_field_defaults != 0 and state.data_field_defaults.has(node.val_str) {
                defs_list = state.data_field_defaults.get(node.val_str)
                di = 0
                while di < len(defs_list) {
                    if defs_list[di] != 0 { has_defs = 1 }
                    di = di + 1
                }
            }
            if (len(node.args) > 0 or has_defs == 1) and state.data_fields.has(node.val_str) {
                data_constructor_call(state, node, call_arg_names, call_arg_is_kw, tok)
            }
        } else {
            if state.const_table.has(tok.val) {
                return make_number_node(state.const_table.get(tok.val), tok.line, tok.col)
            }
            node.kind = "Variable"
            node.val_str = tok.val
        }
    } elif tok.kind == "LPAREN" {
        eat_tok(state, "LPAREN")
        node = parse_expr(state)
        eat_tok(state, "RPAREN")
    } elif tok.kind == "SELF" {
        eat_tok(state, "SELF")
        node.kind = "Variable"
        node.val_str = "self"
    } elif tok.kind == "RBRACE" {
        eat_tok(state, "RBRACE")
        node.kind = "NONE"
    } elif tok.kind == "COMMA" {
        eat_tok(state, "COMMA")
        node.kind = "Variable"
        node.val_str = ","
    } else {
        errors.err("Syntax", state.filename, tok.line, "unexpected token: " + tok.kind, "this token does not belong here — check for misplaced operators, missing expressions, or extra punctuation", tok.col)
        state.pos = state.pos + 1
    }
    
    # Handle array index, property access, or dot/method access
    loop = 1
    while loop == 1 {
        next_tok = current_tok(state)
        if next_tok.kind == "DOT" {
            eat_tok(state, "DOT")
            prop_tok = eat_prop_name(state)
            prop_tok.val = canonicalMember(prop_tok.val)
            next_after = current_tok(state)
            if next_after.kind == "LPAREN" {
                # Method call: obj.method()
                eat_tok(state, "LPAREN")
                method_node = AstNode()
                method_node.line = tok.line
                method_node.col = tok.col
                method_node.kind = "MethodCall"
                method_node.left = node  # instance
                method_node.val_str = prop_tok.val  # method name
                method_node.args = []
                method_arg_names = []
                method_arg_is_kw = []
                m_has_seen_kw = 0
                check = current_tok(state)
                if check.kind != "RPAREN" {
                    nt = peek_tok(state, 1)
                    pending_kw = "-"
                    pending_is_kw = 0
                    if (check.kind == "IDENT" or check.kind == "CLASS") and nt.kind == "EQUALS" {
                        pending_kw = eat_tok(state, check.kind).val
                        pending_is_kw = 1
                        eat_tok(state, "EQUALS")
                        m_has_seen_kw = 1
                    }
                    method_node.args.append(parse_expr(state))
                    method_arg_names.append(pending_kw)
                    method_arg_is_kw.append(pending_is_kw)
                    check = current_tok(state)
                    while check.kind == "COMMA" {
                        eat_tok(state, "COMMA")
                        check = current_tok(state)
                        if check.kind != "RPAREN" {
                            nt = peek_tok(state, 1)
                            pending_kw = "-"
                            pending_is_kw = 0
                            if (check.kind == "IDENT" or check.kind == "CLASS") and nt.kind == "EQUALS" {
                                pending_kw = eat_tok(state, check.kind).val
                                pending_is_kw = 1
                                eat_tok(state, "EQUALS")
                                m_has_seen_kw = 1
                            } else {
                                if m_has_seen_kw == 1 {
                                    errors.err("Syntax", state.filename, tok.line, "positional argument follows keyword argument", "positional arguments must appear before keyword arguments", tok.col)
                                }
                            }
                            method_node.args.append(parse_expr(state))
                            method_arg_names.append(pending_kw)
                            method_arg_is_kw.append(pending_is_kw)
                            check = current_tok(state)
                        }
                    }
                }
                eat_tok(state, "RPAREN")
                method_node.arg_names = method_arg_names
                method_node.arg_is_kw = method_arg_is_kw
                if method_node.left.kind == "Variable" and state.data_fields.has("__enum_" + method_node.left.val_str) {
                    enum_name = method_node.left.val_str
                    variant_name = method_node.val_str
                    tag_val = 0
                    tag_key = "__enum_tag_" + enum_name + "." + variant_name
                    if state.data_fields.has(tag_key) {
                        tag_val = state.data_fields.get(tag_key)[0]
                    }
                    tag_node = make_number_node(tag_val, method_node.line, method_node.col)
                    call_node = AstNode()
                    call_node.line = method_node.line
                    call_node.col = method_node.col
                    call_node.kind = "Call"
                    call_node.val_str = enum_name + "_" + variant_name
                    call_node.args = [tag_node]
                    ak = 0
                    while ak < len(method_node.args) {
                        call_node.args.append(method_node.args[ak])
                        ak = ak + 1
                    }
                    call_node.arg_names = []
                    call_node.arg_is_kw = []
                    data_constructor_call(state, call_node, call_node.arg_names, call_node.arg_is_kw, tok)
                    method_node = call_node
                } elif method_node.left.kind == "Variable" and (method_node.left.val_str == "cpu" or method_node.left.val_str == "mem") {
                    ns = method_node.left.val_str
                    fn = method_node.val_str
                    call_node = AstNode()
                    call_node.line = method_node.line
                    call_node.col = method_node.col
                    call_node.kind = "Call"
                    call_node.args = method_node.args
                    call_node.arg_names = method_node.arg_names
                    call_node.arg_is_kw = method_node.arg_is_kw
                    if ns == "cpu" {
                        if fn == "halt" { call_node.val_str = "cpu_hlt" }
                        elif fn == "cli" or fn == "disable" or fn == "disable_interrupts" { call_node.val_str = "cpu_cli" }
                        elif fn == "sti" or fn == "enable" or fn == "enable_interrupts" { call_node.val_str = "cpu_sti" }
                        elif fn == "in" or fn == "in8" or fn == "inb" or fn == "read_port" { call_node.val_str = "cpu_inb" }
                        elif fn == "in16" or fn == "inw" or fn == "read_port16" { call_node.val_str = "cpu_inw" }
                        elif fn == "in32" or fn == "ind" or fn == "read_port32" { call_node.val_str = "cpu_ind" }
                        elif fn == "out" or fn == "out8" or fn == "outb" or fn == "write_port" { call_node.val_str = "cpu_outb" }
                        elif fn == "out16" or fn == "outw" or fn == "write_port16" { call_node.val_str = "cpu_outw" }
                        elif fn == "out32" or fn == "outd" or fn == "write_port32" { call_node.val_str = "cpu_outd" }
                        elif fn == "read_cr3" or fn == "get_page_table" or fn == "cr3" { call_node.val_str = "cpu_read_cr3" }
                        elif fn == "write_cr3" or fn == "set_page_table" or fn == "set_cr3" { call_node.val_str = "cpu_write_cr3" }
                        elif fn == "read_cr2" or fn == "cr2" { call_node.val_str = "cpu_read_cr2" }
                        elif fn == "read_cr0" or fn == "cr0" { call_node.val_str = "cpu_read_cr0" }
                        elif fn == "write_cr0" or fn == "set_cr0" { call_node.val_str = "cpu_write_cr0" }
                        elif fn == "pause" { call_node.val_str = "cpu_pause" }
                        elif fn == "rdtsc" { call_node.val_str = "cpu_rdtsc" }
                        elif fn == "atomic_xchg" or fn == "xchg" { call_node.val_str = "cpu_atomic_xchg" }
                        elif fn == "atomic_cas" or fn == "cas" { call_node.val_str = "cpu_atomic_cas" }
                        elif fn == "invlpg" or fn == "invalidate_page" { call_node.val_str = "cpu_invlpg" }
                        else { call_node.val_str = "cpu_" + fn }
                    } elif ns == "mem" {
                        if fn == "alloc" or fn == "malloc" { call_node.val_str = "mem_alloc" }
                        elif fn == "free" { call_node.val_str = "mem_free" }
                        elif fn == "set_allocator" or fn == "hook" { call_node.val_str = "mem_set_allocator" }
                        elif fn == "heap_used" or fn == "used" { call_node.val_str = "mem_heap_used" }
                        elif fn == "heap_total" or fn == "total" { call_node.val_str = "mem_heap_total" }
                        elif fn == "view" { call_node.val_str = "mem_view" }
                        elif fn == "read_u8" or fn == "u8" { call_node.val_str = "mem_read_u8" }
                        elif fn == "read_u16" or fn == "u16" { call_node.val_str = "mem_read_u16" }
                        elif fn == "read_u32" or fn == "u32" { call_node.val_str = "mem_read_u32" }
                        elif fn == "read_u64" or fn == "u64" { call_node.val_str = "mem_read_u64" }
                        elif fn == "write_u8" or fn == "set_u8" { call_node.val_str = "mem_write_u8" }
                        elif fn == "write_u16" or fn == "set_u16" { call_node.val_str = "mem_write_u16" }
                        elif fn == "write_u32" or fn == "set_u32" { call_node.val_str = "mem_write_u32" }
                        elif fn == "write_u64" or fn == "set_u64" { call_node.val_str = "mem_write_u64" }
                        else { call_node.val_str = "mem_" + fn }
                    }
                    method_node = call_node
                } elif method_node.left.kind == "DataFieldAccess" and method_node.left.left.kind == "Variable" and method_node.left.left.val_str == "cpu" {
                    sub = method_node.left.val_str
                    fn = method_node.val_str
                    call_node = AstNode()
                    call_node.line = method_node.line
                    call_node.col = method_node.col
                    call_node.kind = "Call"
                    call_node.args = method_node.args
                    call_node.arg_names = method_node.arg_names
                    call_node.arg_is_kw = method_node.arg_is_kw
                    if sub == "in" {
                        if fn == "u8" or fn == "b" or fn == "byte" { call_node.val_str = "cpu_inb" }
                        elif fn == "u16" or fn == "w" or fn == "word" { call_node.val_str = "cpu_inw" }
                        elif fn == "u32" or fn == "d" or fn == "dword" { call_node.val_str = "cpu_ind" }
                        else { call_node.val_str = "cpu_inb" }
                    } elif sub == "out" {
                        if fn == "u8" or fn == "b" or fn == "byte" { call_node.val_str = "cpu_outb" }
                        elif fn == "u16" or fn == "w" or fn == "word" { call_node.val_str = "cpu_outw" }
                        elif fn == "u32" or fn == "d" or fn == "dword" { call_node.val_str = "cpu_outd" }
                        else { call_node.val_str = "cpu_outb" }
                    } elif sub == "cr3" {
                        if fn == "set" or fn == "write" { call_node.val_str = "cpu_write_cr3" }
                        elif fn == "get" or fn == "read" { call_node.val_str = "cpu_read_cr3" }
                        else { call_node.val_str = "cpu_write_cr3" }
                    } elif sub == "tlb" {
                        if fn == "flush" or fn == "invalidate" { call_node.val_str = "cpu_invlpg" }
                        else { call_node.val_str = "cpu_invlpg" }
                    } else {
                        call_node.val_str = "cpu_" + sub + "_" + fn
                    }
                    method_node = call_node
                }
                node = method_node
            } else {
                is_ptr = 0
                if node.inferred_type != 0 and node.inferred_type.kind == "struct" {
                    is_ptr = 0
                } elif prop_tok.val == "value" { is_ptr = 1 }
                elif prop_tok.val == "addr" { is_ptr = 1 }
                elif prop_tok.val == "isValid" { is_ptr = 1 }
                elif prop_tok.val == "isNull" { is_ptr = 1 }
                elif prop_tok.val == "bytes" { is_ptr = 1 }
                elif prop_tok.val == "value_byte" { is_ptr = 1 }
                elif prop_tok.val == "value_word" { is_ptr = 1 }
                elif prop_tok.val == "value_dword" { is_ptr = 1 }
                elif prop_tok.val == "value_qword" { is_ptr = 1 }
                elif prop_tok.val == "ptr" { is_ptr = 1 }

                if is_ptr == 1 {
                    if next_after.kind == "EQUALS" or next_after.kind == "PLUSEQ" or next_after.kind == "MINUSEQ" or next_after.kind == "STAREQ" or next_after.kind == "SLASHEQ" or next_after.kind == "PERCENTEQ" {
                        # Pointer property assignment: ptr.value += new_val
                        eat_tok(state, next_after.kind)
                        val_node = parse_expr(state)
                        if next_after.kind != "EQUALS" {
                            op_str = str_sub(next_after.val, 0, len(next_after.val) - 1)
                            access_node = AstNode()
                            access_node.line = tok.line
                            access_node.col = tok.col
                            access_node.kind = "PointerProperty"
                            access_node.left = node
                            access_node.val_str = prop_tok.val
                            bin_node = AstNode()
                            bin_node.line = tok.line
                            bin_node.col = tok.col
                            bin_node.kind = "BinOp"
                            bin_node.val_str = op_str
                            bin_node.left = access_node
                            bin_node.right = val_node
                            val_node = bin_node
                        }
                        assign_node = AstNode()
                        assign_node.line = tok.line
                        assign_node.col = tok.col
                        assign_node.kind = "PointerAssign"
                        assign_node.left = node  # instance
                        assign_node.val_str = prop_tok.val  # field name
                        assign_node.right = val_node  # value
                        return assign_node
                    } else {
                        # Pointer property access: ptr.value
                        access_node = AstNode()
                        access_node.line = tok.line
                        access_node.col = tok.col
                        access_node.kind = "PointerProperty"
                        access_node.left = node  # instance
                        access_node.val_str = prop_tok.val  # field name
                        node = access_node
                    }
                } else {
                    if next_after.kind == "EQUALS" or next_after.kind == "PLUSEQ" or next_after.kind == "MINUSEQ" or next_after.kind == "STAREQ" or next_after.kind == "SLASHEQ" or next_after.kind == "PERCENTEQ" {
                        # Field assignment: obj.field += value
                        eat_tok(state, next_after.kind)
                        val_node = parse_expr(state)
                        if next_after.kind != "EQUALS" {
                            op_str = str_sub(next_after.val, 0, len(next_after.val) - 1)
                            access_node = AstNode()
                            access_node.line = tok.line
                            access_node.col = tok.col
                            access_node.kind = "DataFieldAccess"
                            access_node.left = node
                            access_node.val_str = prop_tok.val
                            bin_node = AstNode()
                            bin_node.line = tok.line
                            bin_node.col = tok.col
                            bin_node.kind = "BinOp"
                            bin_node.val_str = op_str
                            bin_node.left = access_node
                            bin_node.right = val_node
                            val_node = bin_node
                        }
                        assign_node = AstNode()
                        assign_node.line = tok.line
                        assign_node.col = tok.col
                        assign_node.kind = "DataFieldAssign"
                        assign_node.left = node  # instance
                        assign_node.val_str = prop_tok.val  # field name
                        assign_node.right = val_node  # value
                        return assign_node
                    } else {
                        # Field access: obj.field
                        access_node = AstNode()
                        access_node.line = tok.line
                        access_node.col = tok.col
                        access_node.kind = "DataFieldAccess"
                        access_node.left = node  # instance
                        access_node.val_str = prop_tok.val  # field name
                        if node.kind == "Variable" and publicConst(node.val_str, prop_tok.val) == 1 {
                            val = moduleConst(node.val_str, prop_tok.val)
                            access_node = make_number_node(val, tok.line, tok.col)
                        } elif node.kind == "Variable" and state.data_fields.has("__enum_" + node.val_str) {
                            tag_key = "__enum_tag_" + node.val_str + "." + prop_tok.val
                            if state.data_fields.has(tag_key) {
                                tag_list = state.data_fields.get(tag_key)
                                access_node = make_number_node(tag_list[0], tok.line, tok.col)
                            }
                        }
                        node = access_node
                    }
                }
            }
        } else {
            if next_tok.kind == "LBRACK" {
            eat_tok(state, "LBRACK")

            # Check for slice [:end]
            check_colon = current_tok(state)
            if check_colon.kind == "COLON" {
                eat_tok(state, "COLON")
                end_node = 0
                check_end = current_tok(state)
                if check_end.kind != "RBRACK" {
                    end_node = parse_expr(state)
                }
                eat_tok(state, "RBRACK")
                slice_node = AstNode()
                slice_node.line = tok.line
                slice_node.col = tok.col
                slice_node.kind = "Slice"
                slice_node.left = node  # base
                slice_node.right = 0    # start = 0 (omitted)
                slice_node.cond = end_node     # end
                node = slice_node
            } else {
                index_node = parse_expr(state)
                check_colon2 = current_tok(state)
                if check_colon2.kind == "COLON" {
                    eat_tok(state, "COLON")
                    end_node = 0
                    check_end = current_tok(state)
                    if check_end.kind != "RBRACK" {
                        end_node = parse_expr(state)
                    }
                    eat_tok(state, "RBRACK")
                    slice_node = AstNode()
                    slice_node.line = tok.line
                    slice_node.col = tok.col
                    slice_node.kind = "Slice"
                    slice_node.left = node       # base
                    slice_node.right = index_node # start
                    slice_node.cond = end_node    # end
                    node = slice_node
                } else {
                    eat_tok(state, "RBRACK")
                    assign_tok = current_tok(state)
                    if assign_tok.kind == "EQUALS" or assign_tok.kind == "PLUSEQ" or assign_tok.kind == "MINUSEQ" or assign_tok.kind == "STAREQ" or assign_tok.kind == "SLASHEQ" or assign_tok.kind == "PERCENTEQ" {
                        eat_tok(state, assign_tok.kind)
                        val_node = parse_expr(state)
                        if assign_tok.kind != "EQUALS" {
                            op_str = str_sub(assign_tok.val, 0, len(assign_tok.val) - 1)
                            access_node = AstNode()
                            access_node.line = tok.line
                            access_node.col = tok.col
                            access_node.kind = "ArrayIndex"
                            access_node.left = node
                            access_node.right = index_node
                            bin_node = AstNode()
                            bin_node.line = tok.line
                            bin_node.col = tok.col
                            bin_node.kind = "BinOp"
                            bin_node.val_str = op_str
                            bin_node.left = access_node
                            bin_node.right = val_node
                            val_node = bin_node
                        }
                        array_assign = AstNode()
                        array_assign.line = tok.line
                        array_assign.col = tok.col
                        array_assign.kind = "ArrayIndexAssign"
                        array_assign.left = node  # base
                        array_assign.right = index_node # index
                        array_assign.cond = val_node # value
                        node = array_assign
                        return node
                    } else {
                        array_node = AstNode()
                        array_node.line = tok.line
                        array_node.col = tok.col
                        array_node.kind = "ArrayIndex"
                        array_node.left = node # base
                        array_node.right = index_node # index
                        node = array_node
                    }
                }
            }
        } else {
            loop = 0
        }
    }
}

    return node
}

# Typed helper so two strings pulled out of untyped lists compare by content.
def same_text(a: string, b: string) -> int {
    if a == b { return 1 }
    return 0
}

# Point(1, 2) / Point(x=1, y=2) -> __new_Point(...) with the values in field order.
def clone_ast_node(node: AstNode) -> AstNode {
    if node == 0 { return 0 }
    copy = AstNode()
    copy.kind = node.kind
    copy.val_int = node.val_int
    copy.val_str = node.val_str
    copy.line = node.line
    copy.col = node.col
    copy.is_float = node.is_float
    copy.left = clone_ast_node(node.left)
    copy.right = clone_ast_node(node.right)
    copy.cond = clone_ast_node(node.cond)
    copy.name = node.name
    copy.return_type = node.return_type
    copy.lib = node.lib
    copy.args = []
    if node.args != 0 {
        ai = 0
        while ai < len(node.args) {
            copy.args.append(clone_ast_node(node.args[ai]))
            ai = ai + 1
        }
    }
    return copy
}

def data_constructor_call(state: ParserState, node: AstNode, arg_names: list, arg_is_kw: list, tok: Token) {
    type_name = node.val_str
    fields = state.data_fields.get(type_name)
    defaults = []
    if state.data_field_defaults != 0 and state.data_field_defaults.has(type_name) {
        defaults = state.data_field_defaults.get(type_name)
    }
    kw_count = 0
    i = 0
    while i < len(arg_is_kw) {
        kw_count = kw_count + arg_is_kw[i]
        i = i + 1
    }
    ordered = []
    if kw_count > 0 {
        if kw_count != len(arg_names) {
            errors.err("Syntax", state.filename, tok.line, type_name + "(...) cannot mix positional and keyword values", "use only values or only name=value pairs", tok.col)
        }
        i = 0
        while i < len(arg_names) {
            known = 0
            f = 0
            while f < len(fields) {
                if same_text(fields[f], arg_names[i]) == 1 { known = 1 }
                f = f + 1
            }
            if known == 0 {
                errors.err("Name", state.filename, tok.line, "no field named " + arg_names[i] + " in " + type_name, "check the field names in the data declaration", tok.col)
            }
            i = i + 1
        }
        f = 0
        while f < len(fields) {
            value = 0
            i = 0
            while i < len(arg_names) {
                if same_text(arg_names[i], fields[f]) == 1 { value = node.args[i] }
                i = i + 1
            }
            if value == 0 {
                if f < len(defaults) and defaults[f] != 0 {
                    value = clone_ast_node(defaults[f])
                } else {
                    value = make_number_node(0, tok.line, tok.col)
                }
            }
            ordered.append(value)
            f = f + 1
        }
    } else {
        if len(node.args) > len(fields) {
            errors.err("Syntax", state.filename, tok.line, type_name + " has " + str(len(fields)) + " field(s) but " + str(len(node.args)) + " values were given", "remove the extra values", tok.col)
        }
        i = 0
        while i < len(fields) {
            if i < len(node.args) {
                ordered.append(node.args[i])
            } else {
                if i < len(defaults) and defaults[i] != 0 {
                    ordered.append(clone_ast_node(defaults[i]))
                } else {
                    ordered.append(make_number_node(0, tok.line, tok.col))
                }
            }
            i = i + 1
        }
    }
    node.val_str = "__new_" + type_name
    node.args = ordered
    node.arg_names = []
    node.arg_is_kw = []
    seen = 0
    i = 0
    while i < len(state.ctors_used) {
        if state.ctors_used[i] == type_name { seen = 1 }
        i = i + 1
    }
    if seen == 0 { state.ctors_used.append(type_name) }
}

# Source text of the hidden constructor for a data type that was built with values.
def constructor_source(type_name: string, fields: list) -> string {
    params = ""
    assigns = ""
    i = 0
    while i < len(fields) {
        if i > 0 { params = params + ", " }
        params = params + "a" + str(i)
        assigns = assigns + "    __self." + fields[i] + " = a" + str(i) + "\n"
        i = i + 1
    }
    return "def __new_" + type_name + "(" + params + ") -> " + type_name + " {\n    __self = " + type_name + "()\n" + assigns + "    return __self\n}\n"
}

def make_number_node(value: int, line: int, col: int) -> AstNode {
    n = AstNode()
    n.kind = "Number"
    n.val_int = value
    n.line = line
    n.col = col
    return n
}

# for i in range(n) / range(a, b) / range(a, b, step) -> counted ForLoop.
# range() excludes its end like Python; ForLoop's `to` includes it, so the end
# becomes b - 1 (or b + 1 when counting down). The step must be an integer literal.
def parse_range_loop(state: ParserState, var_name: string, line: int, col: int) -> AstNode {
    eat_tok(state, "IDENT")
    eat_tok(state, "LPAREN")
    range_args = [parse_expr(state)]
    check = current_tok(state)
    while check.kind == "COMMA" {
        eat_tok(state, "COMMA")
        range_args.append(parse_expr(state))
        check = current_tok(state)
    }
    eat_tok(state, "RPAREN")
    if len(range_args) > 3 {
        errors.err("Syntax", state.filename, line, "range() takes 1 to 3 arguments", "use range(stop), range(start, stop) or range(start, stop, step)", col)
    }
    start_expr = make_number_node(0, line, col)
    stop_expr = range_args[0]
    if len(range_args) >= 2 {
        start_expr = range_args[0]
        stop_expr = range_args[1]
    }
    step_val = 1
    if len(range_args) == 3 {
        step_node = range_args[2]
        if step_node.kind == "Number" and step_node.is_float == 0 {
            step_val = step_node.val_int
        } elif step_node.kind == "UnaryOp" and step_node.val_str == "-" and step_node.left.kind == "Number" {
            step_val = 0 - step_node.left.val_int
        } else {
            errors.err("Syntax", state.filename, line, "range() step must be an integer literal", "write the step as a number, e.g. range(0, 10, 2) or range(10, 0, -1)", col)
        }
        if step_val == 0 {
            errors.err("Syntax", state.filename, line, "range() step must not be zero", "use a positive or negative step", col)
            step_val = 1
        }
    }
    is_down = 0
    offset = 0 - 1
    if step_val < 0 {
        is_down = 1
        offset = 1
    }
    end_expr = AstNode()
    if stop_expr.kind == "Number" and stop_expr.is_float == 0 {
        end_expr = make_number_node(stop_expr.val_int + offset, line, col)
    } else {
        end_expr.kind = "BinOp"
        end_expr.line = line
        end_expr.col = col
        end_expr.left = stop_expr
        end_expr.right = make_number_node(1, line, col)
        if is_down == 1 {
            end_expr.val_str = "+"
        } else {
            end_expr.val_str = "-"
        }
    }
    abs_step = step_val
    if abs_step < 0 { abs_step = 0 - abs_step }
    body = parse_block(state)
    node = AstNode()
    node.line = line
    node.col = col
    node.kind = "ForLoop"
    node.val_str = var_name
    node.val_int = is_down
    node.left = start_expr
    node.right = end_expr
    node.cond = make_number_node(abs_step, line, col)
    node.body = body
    return node
}

def parse_unary(state: ParserState) -> AstNode {
    tok = current_tok(state)
    if tok.kind == "MINUS" or tok.kind == "NOT" or tok.kind == "TILDE" {
        eat_tok(state, tok.kind)
        node = AstNode()
        node.kind = "UnaryOp"
        node.val_str = tok.val
        node.line = tok.line
        node.col = tok.col
        node.left = parse_unary(state)
        return node
    }
    if tok.kind == "SPAWN" {
        eat_tok(state, "SPAWN")
        node = AstNode()
        node.kind = "Spawn"
        node.line = tok.line
        node.col = tok.col
        node.left = parse_unary(state)
        return node
    }
    if tok.kind == "AWAIT" {
        eat_tok(state, "AWAIT")
        node = AstNode()
        node.kind = "Await"
        node.line = tok.line
        node.col = tok.col
        node.left = parse_unary(state)
        return node
    }
    return parse_primary(state)
}

def parse_mul(state: ParserState) -> AstNode {
    left = parse_unary(state)
    loop = 1
    while loop == 1 {
        tok = current_tok(state)
        if tok.kind == "STAR" or tok.kind == "SLASH" or tok.kind == "PERCENT" or tok.kind == "AMPERSAND" or tok.kind == "GTGT" or tok.kind == "LTLT" or tok.kind == "PIPE" or tok.kind == "CARET" {
            eat_tok(state, tok.kind)
            right = parse_unary(state)
            
            if left.kind == "Number" and right.kind == "Number" and left.is_float == 0 and right.is_float == 0 {
                if tok.val == "*" { left.val_int = left.val_int * right.val_int }
                if tok.val == "/" and right.val_int != 0 { left.val_int = left.val_int / right.val_int }
                if tok.val == "%" and right.val_int != 0 { left.val_int = left.val_int % right.val_int }
                if tok.val == "<<" { left.val_int = left.val_int << right.val_int }
                if tok.val == ">>" { left.val_int = left.val_int >> right.val_int }
                if tok.val == "&" { left.val_int = left.val_int & right.val_int }
                if tok.val == "|" { left.val_int = left.val_int | right.val_int }
                if tok.val == "^" { left.val_int = left.val_int ^ right.val_int }
            } else {
                node = AstNode()
                node.kind = "BinOp"
                node.val_str = tok.val
                node.line = tok.line
                node.col = tok.col
                node.left = left
                node.right = right
                left = node
            }
        } else {
            loop = 0
        }
    }
    return left
}

def parse_add(state: ParserState) -> AstNode {
    left = parse_mul(state)
    loop = 1
    while loop == 1 {
        tok = current_tok(state)
        if tok.kind == "PLUS" or tok.kind == "MINUS" {
            eat_tok(state, tok.kind)
            right = parse_mul(state)
            
            if left.kind == "Number" and right.kind == "Number" and left.is_float == 0 and right.is_float == 0 {
                if tok.val == "+" {
                    left.val_int = left.val_int + right.val_int
                } else {
                    left.val_int = left.val_int - right.val_int
                }
            } elif tok.val == "+" and left.kind == "String" and right.kind == "String" {
                left.val_str = left.val_str + right.val_str
            } else {
                node = AstNode()
                node.kind = "BinOp"
                node.val_str = tok.val
                node.line = tok.line
                node.col = tok.col
                node.left = left
                node.right = right
                left = node
            }
        } else {
            loop = 0
        }
    }
    return left
}

def parse_compare(state: ParserState) -> AstNode {
    left = parse_add(state)
    loop = 1
    while loop == 1 {
        tok = current_tok(state)
        after_tok = peek_tok(state, 1)
        if tok.kind == "IN" or (tok.kind == "NOT" and after_tok.kind == "IN") {
            # `key in d` -> d.has(key); `key not in d` -> not d.has(key). Dictionaries only.
            negate = 0
            if tok.kind == "NOT" {
                negate = 1
                eat_tok(state, "NOT")
            }
            eat_tok(state, "IN")
            container = parse_add(state)
            has_node = AstNode()
            has_node.kind = "MethodCall"
            has_node.val_str = "has"
            has_node.line = tok.line
            has_node.col = tok.col
            has_node.left = container
            has_node.args = [left]
            left = has_node
            if negate == 1 {
                not_node = AstNode()
                not_node.kind = "UnaryOp"
                not_node.val_str = "not"
                not_node.line = tok.line
                not_node.col = tok.col
                not_node.left = left
                left = not_node
            }
        } elif tok.kind == "EQEQ" or tok.kind == "NOTEQ" or tok.kind == "LT" or tok.kind == "GT" or tok.kind == "LE" or tok.kind == "GE" or tok.kind == "HAS" {
            eat_tok(state, tok.kind)
            right = parse_add(state)
            node = AstNode()
            node.kind = "Compare"
            node.val_str = tok.val
            node.line = tok.line
            node.col = tok.col
            node.left = left
            node.right = right
            left = node
        } else {
            loop = 0
        }
    }
    return left
}

def parse_logic(state: ParserState) -> AstNode {
    left = parse_compare(state)
    loop = 1
    while loop == 1 {
        tok = current_tok(state)
        if tok.kind == "AND" or tok.kind == "OR" {
            is_and = 0
            if tok.kind == "AND" { is_and = 1 }
            eat_tok(state, tok.kind)
            right = parse_compare(state)

            if left.kind == "Boolean" {
                if is_and == 1 {
                    if left.val_int == 1 {
                        left = right
                    }
                } else {
                    if left.val_int == 0 {
                        left = right
                    }
                }
            } else {
                if left.kind == "Compare" and (right.kind == "Number" or right.kind == "String") {
                new_right = AstNode()
                new_right.kind = "Compare"
                new_right.val_str = left.val_str
                new_right.line = right.line
                new_right.col = right.col
                new_right.left = left.left
                new_right.right = right
                right = new_right
            }
            
            node = AstNode()
            node.kind = "BinOp"
            node.val_str = tok.val
            node.line = tok.line
            node.col = tok.col
            node.left = left
            node.right = right
            left = node
            }
        } else {
            loop = 0
        }
    }
    return left
}

def parse_dict_key(state: ParserState) -> AstNode {
    tok = current_tok(state)
    if tok.kind == "CLASS" {
        eat_tok(state, "CLASS")
        node = AstNode()
        node.kind = "String"
        node.val_str = "class"
        node.line = tok.line
        node.col = tok.col
        return node
    }
    return parse_expr(state)
}

def parse_expr(state: ParserState) -> AstNode {
    cond = parse_logic(state)
    tok = current_tok(state)
    if tok.kind == "QUESTION" {
        eat_tok(state, "QUESTION")
        true_expr = parse_expr(state)
        eat_tok(state, "COLON")
        false_expr = parse_expr(state)
        node = AstNode()
        node.kind = "Ternary"
        node.line = tok.line
        node.col = tok.col
        node.cond = cond
        node.left = true_expr
        node.right = false_expr
        return node
    }
    return cond
}

def parse_type_annotation(state: ParserState) -> string {
    tok = current_tok(state)
    type_name = ""
    
    k = tok.kind
    if k == "TYPE_INT" or k == "TYPE_FLOAT" or k == "TYPE_BOOL" or k == "TYPE_STRING" or k == "TYPE_BYTE" or k == "TYPE_VOID" or k == "IDENT" {
        type_name = tok.val
        eat_tok(state, k)
    } else {
        return ""
    }
    
    tok = current_tok(state)
    if tok.kind == "LBRACK" {
        eat_tok(state, "LBRACK")
        inner_type = parse_type_annotation(state)
        eat_tok(state, "RBRACK")
        return type_name + "[" + inner_type + "]"
    }
    return type_name
}

# ---------------- STATEMENTS ----------------

def parse_try_block(state: ParserState, stmt_line: int, stmt_col: int) -> AstNode {
    eat_tok(state, "TRY")
    body = parse_block(state)
    eat_tok(state, "CATCH")
    # No parens around the catch variable -- `catch e { ... }`, matching the Python
    # bootstrap parser (bootstrap/parser/parser.py's parse_try) and every existing test
    # (tests/test_exceptions.py, tests/test_native_exec.py). This previously expected
    # `catch(e) { ... }`, which no other part of the language or test suite ever used, so
    # the self-hosted parser rejected every real try/catch program with a syntax error.
    catch_var = eat_tok(state, "IDENT").val
    catch_body = parse_block(state)
    node = AstNode()
    node.line = stmt_line
    node.col = stmt_col
    node.kind = "TRY"
    node.val_str = catch_var
    node.body = body
    node.else_body = catch_body
    return node
}

def parse_if_tail(state: ParserState) -> list {
    check = current_tok(state)
    if check.kind == "ELSE" {
        eat_tok(state, "ELSE")
        return parse_block(state)
    }
    if check.kind == "ELIF" {
        eat_tok(state, "ELIF")
        elif_cond = parse_expr(state)
        elif_body = parse_block(state)
        tail = parse_if_tail(state)
        if elif_cond != 0 and elif_cond.kind == "Boolean" {
            if elif_cond.val_int == 1 {
                return elif_body
            }
            return tail
        }
        elif_node = AstNode()
        elif_node.line = check.line
        elif_node.col = check.col
        elif_node.kind = "IfElse"
        elif_node.cond = elif_cond
        elif_node.body = elif_body
        elif_node.else_body = tail
        return [elif_node]
    }
    return []
}

def parse_block(state: ParserState) -> list {
    eat_tok(state, "LBRACE")
    body = []
    loop = 1
    while loop == 1 {
        tok = current_tok(state)
        if tok.kind == "RBRACE" or tok.kind == "EOF" {
            loop = 0
        } else {
            stmt = parse_statement(state)
            if stmt.kind != "NONE" {
                body.append(stmt)
            }
        }
    }
    eat_tok(state, "RBRACE")
    return body
}

def inject_container_cleanup(stmts: list, end_node: AstNode) -> list {
    res = []
    i = 0
    while i < len(stmts) {
        s = stmts[i]
        if s.kind == "Return" or s.kind == "Break" {
            res.append(end_node)
            res.append(s)
        } elif s.kind == "IfElse" {
            if s.body != 0 {
                s.body = inject_container_cleanup(s.body, end_node)
            }
            if s.else_body != 0 {
                s.else_body = inject_container_cleanup(s.else_body, end_node)
            }
            res.append(s)
        } else {
            res.append(s)
        }
        i = i + 1
    }
    return res
}

# test "adds two numbers" { assert(1 + 1 == 2) }
# Lowered to `def __nova_test_N() -> int` (0 = passed). Whether it survives depends on the test_mode argument of parse():
#   drop  normal builds never see tests          keep  `nova check` type-checks them
#   run   `nova test` calls them from a generated runner
def parse_test_block(state: ParserState, stmt_line: int, stmt_col: int) -> AstNode {
    eat_tok(state, "IDENT")
    name_tok = eat_tok(state, "STRING")
    outer = state.in_test
    state.in_test = 1
    body = parse_block(state)
    state.in_test = outer

    if state.test_mode == "drop" {
        n = AstNode()
        n.kind = "NONE"
        n.line = stmt_line
        return n
    }
    idx = state.test_count
    state.test_count = state.test_count + 1
    # the first statement records the display name for the runner: __nova_test_name = "adds numbers"
    src = "def __nova_test_" + str(idx) + "() -> int \{\n"
    shown = name_tok.val
    if len(shown) >= 2 and shown[0] == "\"" and shown[len(shown) - 1] == "\"" { shown = str_sub(shown, 1, len(shown) - 1) }
    src = src + "    __nova_test_name = \"" + escape_for_source(shown) + "\"\n"
    src = src + "    return 0\n"
    src = src + "\}\n"
    snippet = parse(tokenize(src), state.filename)
    fn = snippet[0]
    fn.line = stmt_line
    fn.col = stmt_col
    new_body = [fn.body[0]]
    bi = 0
    while bi < len(body) {
        new_body.append(body[bi])
        bi = bi + 1
    }
    new_body.append(fn.body[1])
    fn.body = new_body
    return fn
}

def parse_statement(state: ParserState) -> AstNode {
    tok = current_tok(state)
    stmt_line = tok.line
    stmt_col = tok.col

    # `let x = ...` is an explicit declaration marker: it is consumed here and the declaration that follows is parsed
    # as the statement. (It used to survive as a stray read of an undefined variable called `let`.)
    if tok.kind == "IDENT" and tok.val == "let" {
        let_next = peek_tok(state, 1)
        if let_next.kind == "IDENT" {
            eat_tok(state, "IDENT")
            return parse_statement(state)
        }
    }

    # test "name" { ... }  (`test` is only special when a string literal follows it)
    if tok.kind == "IDENT" and tok.val == "test" {
        test_next = peek_tok(state, 1)
        if test_next.kind == "STRING" {
            return parse_test_block(state, stmt_line, stmt_col)
        }
    }

    if tok.kind == "PRINTD" {
        eat_tok(state, "PRINTD")
        eat_tok(state, "LPAREN")
        expr = parse_expr(state)
        eat_tok(state, "RPAREN")
        node = AstNode()
        node.line = stmt_line
        node.col = stmt_col
        node.kind = "PrintD"
        node.left = expr
        return node
    }

    if tok.kind == "PRINT" {
        eat_tok(state, "PRINT")
        eat_tok(state, "LPAREN")
        expr = parse_expr(state)
        eat_tok(state, "RPAREN")
        node = AstNode()
        node.line = stmt_line
        node.col = stmt_col
        node.kind = "Print"
        node.left = expr
        return node
    }
    
    if tok.kind == "IF" {
        eat_tok(state, "IF")
        cond = parse_expr(state)
        then_body = parse_block(state)
        else_body = parse_if_tail(state)
        if cond != 0 and cond.kind == "Boolean" {
            c = cond
            tb = then_body
            eb = else_body
            folded = 0
            chosen = []
            while folded == 0 {
                if c == 0 or c.kind != "Boolean" {
                    folded = 1
                } else {
                    if c.val_int == 1 {
                        chosen = tb
                    } else {
                        chosen = eb
                    }
                    if len(chosen) == 0 {
                        node = AstNode()
                        node.line = stmt_line
                        node.col = stmt_col
                        node.kind = "NONE"
                        return node
                    }
                    if len(chosen) == 1 and chosen[0] != 0 and chosen[0].kind == "IfElse" {
                        c = chosen[0].cond
                        tb = chosen[0].body
                        eb = chosen[0].else_body
                    } else {
                        if len(chosen) == 1 {
                            return chosen[0]
                        }
                        node = AstNode()
                        node.line = stmt_line
                        node.col = stmt_col
                        node.kind = "Block"
                        node.body = chosen
                        return node
                    }
                }
            }
        }
        node = AstNode()
        node.line = stmt_line
        node.col = stmt_col
        node.kind = "IfElse"
        node.cond = cond
        node.body = then_body
        node.else_body = else_body
        return node
    }

    if tok.kind == "SWITCH" {
        return parse_switch(state, stmt_line, stmt_col)
    }

    if tok.kind == "MATCH" {
        return parse_match(state, stmt_line, stmt_col)
    }
    
    if tok.kind == "WHILE" {
        eat_tok(state, "WHILE")
        cond = parse_expr(state)
        body = parse_block(state)
        if cond != 0 and cond.kind == "Boolean" and cond.val_int == 0 {
            node = AstNode()
            node.line = stmt_line
            node.col = stmt_col
            node.kind = "NONE"
            return node
        }
        node = AstNode()
        node.line = stmt_line
        node.col = stmt_col
        node.kind = "While"
        node.cond = cond
        node.body = body
        return node
    }

    if tok.kind == "FOR" {
        eat_tok(state, "FOR")
        var_name = eat_tok(state, "IDENT").val
        next_tok = current_tok(state)
        if next_tok.kind == "IN" {
            eat_tok(state, "IN")
            range_tok = current_tok(state)
            range_next = peek_tok(state, 1)
            if range_tok.kind == "IDENT" and range_tok.val == "range" and range_next.kind == "LPAREN" {
                return parse_range_loop(state, var_name, stmt_line, stmt_col)
            }
            collection = parse_expr(state)
            body = parse_block(state)
            node = AstNode()
            node.line = stmt_line
            node.col = stmt_col
            node.kind = "ForIn"
            node.val_str = var_name
            node.left = collection
            node.body = body
            return node
        }
        eat_tok(state, "EQUALS")
        start_expr = parse_expr(state)
        is_downto = 0
        next_tok = current_tok(state)
        if next_tok.kind == "DOWNTO" {
            eat_tok(state, "DOWNTO")
            is_downto = 1
        } else {
            eat_tok(state, "TO")
        }
        end_expr = parse_expr(state)
        
        step_expr = AstNode()
        step_expr.kind = "Number"
        step_expr.val_int = 1
        step_expr.line = stmt_line
        step_expr.col = stmt_col
        
        next_tok = current_tok(state)
        if next_tok.kind == "STEP" {
            eat_tok(state, "STEP")
            step_expr = parse_expr(state)
        }
        
        body = parse_block(state)
        
        node = AstNode()
        node.line = stmt_line
        node.col = stmt_col
        node.kind = "ForLoop"
        node.val_str = var_name
        node.val_int = is_downto
        node.left = start_expr
        node.right = end_expr
        node.cond = step_expr
        node.body = body
        return node
    }

    if tok.kind == "BREAK" {
        eat_tok(state, "BREAK")
        node = AstNode()
        node.line = stmt_line
        node.col = stmt_col
        node.kind = "Break"
        return node
    }
    if tok.kind == "CONTINUE" {
        eat_tok(state, "CONTINUE")
        node = AstNode()
        node.line = stmt_line
        node.col = stmt_col
        node.kind = "Continue"
        return node
    }
    
    if tok.kind == "RETURN" {
        eat_tok(state, "RETURN")
        check_tok = current_tok(state)
        expr = 0
        if check_tok.kind == "RBRACE" or check_tok.kind == "EOF" {
            expr = AstNode()
            expr.kind = "None"
            expr.line = stmt_line
            expr.col = stmt_col
        } else {
            expr = parse_expr(state)
        }
        # `return a, b, c` -- a comma after the first value means a multi-value return
        # (MultiReturn), matching bootstrap/parser/parser.py's identical check. Reuses
        # the generic `args` list field rather than adding a new one, the same way TRY
        # reuses `else_body` for its catch body.
        check_comma = current_tok(state)
        if check_comma.kind == "COMMA" {
            values = [expr]
            while check_comma.kind == "COMMA" {
                eat_tok(state, "COMMA")
                values.append(parse_expr(state))
                check_comma = current_tok(state)
            }
            node = AstNode()
            node.line = stmt_line
            node.col = stmt_col
            node.kind = "MultiReturn"
            node.args = values
            return node
        }
        node = AstNode()
        node.line = stmt_line
        node.col = stmt_col
        node.kind = "Return"
        node.left = expr
        return node
    }

    if tok.kind == "TRY" {
        return parse_try_block(state, stmt_line, stmt_col)
    }

    if tok.kind == "THROW" {
        eat_tok(state, "THROW")
        expr = parse_expr(state)
        node = AstNode()
        node.line = stmt_line
        node.col = stmt_col
        node.kind = "THROW"
        node.left = expr
        return node
    }

    if tok.kind == "DEFER" {
        eat_tok(state, "DEFER")
        node = AstNode()
        node.line = stmt_line
        node.col = stmt_col
        node.kind = "Defer"
        node.left = 0
        node.body = []
        if current_tok(state).kind == "LBRACE" {
            node.body = parse_block(state)
        } else {
            stmt = parse_statement(state)
            if stmt.kind == "NONE" {
                node.left = 0
            } else {
                node.left = stmt
            }
        }
        return node
    }

    is_entry = 0
    is_extern = 0
    extern_lib = ""
    is_container = 0

    while tok.kind == "CONTAINER" or tok.kind == "ENTRY" or tok.kind == "EXTERN" {
        if tok.kind == "CONTAINER" {
            eat_tok(state, "CONTAINER")
            is_container = 1
            tok = current_tok(state)
        } elif tok.kind == "ENTRY" {
            eat_tok(state, "ENTRY")
            is_entry = 1
            tok = current_tok(state)
        } elif tok.kind == "EXTERN" {
            eat_tok(state, "EXTERN")
            if current_tok(state).kind == "STRING" {
                extern_lib = eat_tok(state, "STRING").val
            }
            is_extern = 1
            tok = current_tok(state)
        }
    }

    if tok.kind != "DEF" and (is_entry == 1 or is_extern == 1 or is_container == 1) {
        errors.err("Syntax", state.filename, stmt_line, "unexpected token after attribute: expected def", "function attributes (@container, @entry, extern) must precede def", stmt_col)
        node = AstNode()
        node.line = stmt_line
        node.col = stmt_col
        node.kind = "NONE"
        return node
    }

    if tok.kind == "DEF" {
        eat_tok(state, "DEF")
        name = eat_tok(state, "IDENT").val
        if is_container == 1 {
            state.containers.set(name, 1)
            state.container_ends.set(name, "end_" + name)
        }
        eat_tok(state, "LPAREN")
        param_names = []
        param_types = []
        param_defaults = []
        has_default = 0
        if current_tok(state).kind != "RPAREN" {
            # First param
            p_first_tok = current_tok(state)
            if p_first_tok.kind == "CLASS" {
                param_names.append(eat_tok(state, "CLASS").val)
            } elif p_first_tok.kind == "SELF" {
                param_names.append(eat_tok(state, "SELF").val)
            } else {
                param_names.append(eat_tok(state, "IDENT").val)
            }
            
            p_type = ""
            if current_tok(state).kind == "COLON" {
                eat_tok(state, "COLON")
                p_type = parse_type_annotation(state)
            }
            param_types.append(p_type)

            p_def = 0
            if current_tok(state).kind == "EQUALS" {
                eat_tok(state, "EQUALS")
                p_def = parse_expr(state)
                has_default = 1
            }
            param_defaults.append(p_def)

            while current_tok(state).kind == "COMMA" {
                eat_tok(state, "COMMA")
                p_next_tok = current_tok(state)
                if p_next_tok.kind == "CLASS" {
                    param_names.append(eat_tok(state, "CLASS").val)
                } elif p_next_tok.kind == "SELF" {
                    param_names.append(eat_tok(state, "SELF").val)
                } else {
                    param_names.append(eat_tok(state, "IDENT").val)
                }
                p_type = ""
                if current_tok(state).kind == "COLON" {
                    eat_tok(state, "COLON")
                    p_type = parse_type_annotation(state)
                }
                param_types.append(p_type)

                p_def = 0
                if current_tok(state).kind == "EQUALS" {
                    eat_tok(state, "EQUALS")
                    p_def = parse_expr(state)
                    has_default = 1
                } else {
                    if has_default == 1 {
                        errors.err("Syntax", state.filename, stmt_line, "non-default argument follows default argument", "parameters with default values must come after parameters without defaults", stmt_col)
                    }
                }
                param_defaults.append(p_def)
            }
        }
        eat_tok(state, "RPAREN")
        
        return_type = ""
        ret_tok = current_tok(state)
        if ret_tok.kind == "ARROW" {
            eat_tok(state, "ARROW")
            if current_tok(state).kind == "LPAREN" {
                eat_tok(state, "LPAREN")
                return_type = "(" + parse_type_annotation(state)
                while current_tok(state).kind == "COMMA" {
                    eat_tok(state, "COMMA")
                    return_type = return_type + "," + parse_type_annotation(state)
                }
                eat_tok(state, "RPAREN")
                return_type = return_type + ")"
            } else {
                return_type = parse_type_annotation(state)
            }
        }
        
        body = []
        if is_extern == 0 {
            body = parse_block(state)
        }
        node = AstNode()
        node.line = stmt_line
        node.col = stmt_col
        node.kind = "Function"
        node.file = state.filename
        node.val_str = name
        node.name = name
        node.params = param_names
        node.param_types = param_types
        node.param_defaults = param_defaults
        node.return_type = return_type
        node.body = body
        node.val_int = 0
        if is_entry == 1 {
            node.val_int = 1
        }
        if is_extern == 1 {
            node.val_int = 2
            node.lib = extern_lib
        }
        return node
    }

    if tok.kind == "DATA" {
        eat_tok(state, "DATA")
        name = eat_tok(state, "IDENT").val
        fields = []
        field_types = []
        field_defaults = []
        eat_tok(state, "LBRACE")
        check = current_tok(state)
        while check.kind != "RBRACE" and check.kind != "EOF" {
            field_name = ""
            if check.kind == "IDENT" or check.kind == "LEN" or check.kind == "TYPE_INT" or check.kind == "TYPE_STRING" or check.kind == "TYPE_FLOAT" or check.kind == "TYPE_BOOL" or check.kind == "TYPE_BYTE" {
                field_name = eat_tok(state, check.kind).val
            } else {
                field_name = eat_tok(state, "IDENT").val
                # eat_tok only reports on a mismatch; skip the bad token so the loop always makes progress
                state.pos = state.pos + 1
            }
            check_type = current_tok(state)
            field_type = ""
            if check_type.kind == "COLON" {
                eat_tok(state, "COLON")
                field_type = parse_type_annotation(state)
            }
            check_eq = current_tok(state)
            default_val = 0
            if check_eq.kind == "EQUALS" {
                eat_tok(state, "EQUALS")
                default_val = parse_expr(state)
            }
            fields.append(field_name)
            field_types.append(field_type)
            field_defaults.append(default_val)
            check = current_tok(state)
            # fields may be separated by newlines or (optionally) commas: data P { x: int, y: int }
            if check.kind == "COMMA" {
                eat_tok(state, "COMMA")
                check = current_tok(state)
            }
        }
        eat_tok(state, "RBRACE")
        node = AstNode()
        node.line = stmt_line
        node.col = stmt_col
        node.kind = "Data"
        state.data_fields.set(name, fields)
        state.data_field_defaults.set(name, field_defaults)
        node.val_str = name
        node.params = fields
        node.param_types = field_types
        node.param_defaults = field_defaults
        return node
    }

    if tok.kind == "CLASS" and peek_tok(state, 1).kind == "IDENT" {
        eat_tok(state, "CLASS")
        name = eat_tok(state, "IDENT").val
        fields = []
        field_types = []
        methods = []
        eat_tok(state, "LBRACE")
        check = current_tok(state)
        while check.kind != "RBRACE" and check.kind != "EOF" {
            if check.kind == "DEF" {
                # Parse method
                eat_tok(state, "DEF")
                mname = eat_tok(state, "IDENT").val
                eat_tok(state, "LPAREN")
                mparams = []
                mparam_types = []
                if current_tok(state).kind != "RPAREN" {
                    m_tok = current_tok(state)
                    if m_tok.kind == "SELF" {
                        mparams.append(eat_tok(state, "SELF").val)
                    } elif m_tok.kind == "CLASS" {
                        mparams.append(eat_tok(state, "CLASS").val)
                    } else {
                        mparams.append(eat_tok(state, "IDENT").val)
                    }
                    
                    p_type = ""
                    if current_tok(state).kind == "COLON" {
                        eat_tok(state, "COLON")
                        p_type = parse_type_annotation(state)
                    }
                    mparam_types.append(p_type)

                    while current_tok(state).kind == "COMMA" {
                        eat_tok(state, "COMMA")
                        m_next = current_tok(state)
                        if m_next.kind == "SELF" {
                            mparams.append(eat_tok(state, "SELF").val)
                        } elif m_next.kind == "CLASS" {
                            mparams.append(eat_tok(state, "CLASS").val)
                        } else {
                            mparams.append(eat_tok(state, "IDENT").val)
                        }
                        p_type = ""
                        if current_tok(state).kind == "COLON" {
                            eat_tok(state, "COLON")
                            p_type = parse_type_annotation(state)
                        }
                        mparam_types.append(p_type)
                    }
                }
                eat_tok(state, "RPAREN")
                mreturn_type = ""
                ret_tok = current_tok(state)
                if ret_tok.kind == "ARROW" {
                    eat_tok(state, "ARROW")
                    if current_tok(state).kind == "LPAREN" {
                        eat_tok(state, "LPAREN")
                        mreturn_type = "(" + parse_type_annotation(state)
                        while current_tok(state).kind == "COMMA" {
                            eat_tok(state, "COMMA")
                            mreturn_type = mreturn_type + "," + parse_type_annotation(state)
                        }
                        eat_tok(state, "RPAREN")
                        mreturn_type = mreturn_type + ")"
                    } else {
                        mreturn_type = parse_type_annotation(state)
                    }
                }
                mbody = parse_block(state)
                mnode = AstNode()
                mnode.kind = "Function"
                mnode.file = state.filename
                mnode.val_str = mname
                mnode.line = tok.line
                mnode.col = tok.col
                mnode.params = mparams
                mnode.param_types = mparam_types
                mnode.return_type = mreturn_type
                mnode.body = mbody
                methods.append(mnode)
            } else {
                # Parse field
                field_name = eat_tok(state, "IDENT").val
                check_type = current_tok(state)
                field_type = ""
                if check_type.kind == "COLON" {
                    eat_tok(state, "COLON")
                    field_type = parse_type_annotation(state)
                }
                fields.append(field_name)
                field_types.append(field_type)
            }
            check = current_tok(state)
        }
        eat_tok(state, "RBRACE")
        state.data_fields.set(name, fields)
        node = AstNode()
        node.line = stmt_line
        node.col = stmt_col
        node.kind = "ClassDef"
        node.val_str = name
        node.params = fields
        node.param_types = field_types
        node.methods = methods
        return node
    }

    if tok.kind == "RAW" {
        eat_tok(state, "RAW")
        eat_tok(state, "LBRACE")
        body = []
        exports = []
        while 1 == 1 {
            check = current_tok(state)
            if check.kind == "RBRACE" or check.kind == "EOF" { break }
            if check.kind == "EXPORT" {
                exp = parse_export(state)
                j = 0
                while j < len(exp) {
                    exports.append(exp[j])
                    j = j + 1
                }
            } else {
                stmt = parse_statement(state)
                if stmt.kind != "NONE" {
                    body.append(stmt)
                }
            }
        }
        eat_tok(state, "RBRACE")
        node = AstNode()
        node.line = stmt_line
        node.col = stmt_col
        node.kind = "RawBlock"
        node.body = body
        node.args = exports
        return node
    }

    if tok.kind == "IMPORT" {
        eat_tok(state, "IMPORT")
        node = AstNode()
        node.line = stmt_line
        node.col = stmt_col
        node.kind = "Import"
        node.name = ""
        # Check for FFI string import `import "c" as libc`
        check = current_tok(state)
        if check.kind == "STRING" {
            lib_path = eat_tok(state, "STRING").val
            eat_tok(state, "AS")
            node.val_str = eat_tok(state, "IDENT").val
            node.name = lib_path
        } else {
            node.val_str = eat_tok(state, "IDENT").val
            check = current_tok(state)
            local_mod = node.val_str
            if check.kind == "AS" {
                eat_tok(state, "AS")
                node.name = eat_tok(state, "IDENT").val
                local_mod = node.name
            }
            state.imported_modules.set(local_mod, node.val_str)
        }
        return node
    }

    if tok.kind == "ENUM" {
        return parse_enum_def(state, stmt_line, stmt_col)
    }

    # Assignment or standalone expr
    is_const = 0
    if tok.kind == "CONST" {
        eat_tok(state, "CONST")
        is_const = 1
    }
    
    # Skip unexpected RBRACE at statement level (e.g. from a poorly parsed construct)
    if tok.kind == "RBRACE" {
        eat_tok(state, "RBRACE")
        node = AstNode()
        node.line = stmt_line
        node.col = stmt_col
        node.kind = "NONE"
        return node
    }
    
    if tok.kind == "IDENT" and state.const_table.has(tok.val) {
        peek1 = peek_tok(state, 1)
        if peek1.kind == "EQUALS" or peek1.kind == "PLUSEQ" or peek1.kind == "MINUSEQ" or peek1.kind == "STAREQ" or peek1.kind == "SLASHEQ" or peek1.kind == "PERCENTEQ" {
            errors.err("Syntax", state.filename, tok.line, "cannot assign to const '" + tok.val + "'", "constants are immutable and cannot be reassigned", tok.col)
        }
    }

    expr = parse_expr(state)
    next_tok = current_tok(state)
    if next_tok.kind == "EQUALS" or next_tok.kind == "PLUSEQ" or next_tok.kind == "MINUSEQ" or next_tok.kind == "STAREQ" or next_tok.kind == "SLASHEQ" or next_tok.kind == "PERCENTEQ" {
        eat_tok(state, next_tok.kind)
        val_expr = parse_expr(state)
        if expr.kind == "Variable" {
            if next_tok.kind != "EQUALS" {
                op_str = str_sub(next_tok.val, 0, len(next_tok.val) - 1)
                bin_node = AstNode()
                bin_node.line = stmt_line
                bin_node.col = stmt_col
                bin_node.kind = "BinOp"
                bin_node.val_str = op_str
                bin_node.left = expr
                bin_node.right = val_expr
                val_expr = bin_node
            }
            node = AstNode()
            node.line = stmt_line
            node.col = stmt_col
            node.kind = "Assignment"
            node.val_str = expr.val_str
            node.val_int = 0  # is_const = 0 (false) by default
            if is_const == 1 {
                node.val_int = 1
                if val_expr.kind == "Number" and val_expr.is_float == 0 {
                    state.const_table.set(expr.val_str, val_expr.val_int)
                } elif val_expr.kind == "UnaryOp" and val_expr.val_str == "-" and val_expr.left.kind == "Number" and val_expr.left.is_float == 0 {
                    state.const_table.set(expr.val_str, 0 - val_expr.left.val_int)
                }
            }
            node.left = val_expr
            return node
        }
    } elif next_tok.kind == "COMMA" {
        # `a, b = f()` -- destructures a MultiReturn call's values, matching
        # bootstrap/parser/parser.py's identical check. Reuses `args` for the target
        # list and `left` for the RHS expression, the same way MultiReturn above
        # reuses `args` for its value list.
        targets = [expr]
        check = next_tok
        while check.kind == "COMMA" {
            eat_tok(state, "COMMA")
            targets.append(parse_expr(state))
            check = current_tok(state)
        }
        if check.kind == "EQUALS" {
            eat_tok(state, "EQUALS")
            value_expr = parse_expr(state)
            node = AstNode()
            node.line = stmt_line
            node.col = stmt_col
            node.kind = "UnpackAssign"
            node.args = targets
            node.left = value_expr
            return node
        }
    }

    if current_tok(state).kind == "LBRACE" {
        brace_tok = current_tok(state)
        if brace_tok.line != stmt_line {
            errors.err("Syntax", state.filename, brace_tok.line, "trailing block opening brace must be on the same line as the call", "move the opening brace to the same line as the container call", brace_tok.col)
        }
        fn_name = ""
        if expr.kind == "Call" {
            fn_name = expr.val_str
        } elif expr.kind == "MethodCall" {
            fn_name = expr.val_str
        } elif expr.kind == "Variable" {
            fn_name = expr.val_str
            call_expr = AstNode()
            call_expr.line = stmt_line
            call_expr.col = stmt_col
            call_expr.kind = "Call"
            call_expr.val_str = fn_name
            call_expr.args = []
            expr = call_expr
        } elif expr.kind == "DataFieldAccess" {
            fn_name = expr.val_str
            call_expr = AstNode()
            call_expr.line = stmt_line
            call_expr.col = stmt_col
            call_expr.kind = "Call"
            call_expr.val_str = fn_name
            call_expr.args = []
            expr = call_expr
        } else {
            errors.err("Syntax", state.filename, brace_tok.line, "trailing block requires a call or container identifier", "ensure the trailing block follows a container function call", brace_tok.col)
        }

        short_name = fn_name
        if len(fn_name) > 3 and str_sub(fn_name, 0, 3) == "ui_" {
            short_name = str_sub(fn_name, 3, len(fn_name))
        }

        is_cont = 0
        if state.containers.has(fn_name) == 1 or state.containers.has(short_name) == 1 {
            is_cont = 1
        }
        if is_cont == 0 {
            errors.err("Syntax", state.filename, brace_tok.line, "function '" + fn_name + "' is not marked with @container and cannot take a trailing block", "mark container functions with '@container def " + fn_name + "(...)'", brace_tok.col)
        }

        end_fn = "end_" + short_name
        if state.container_ends.has(fn_name) == 1 {
            end_fn = state.container_ends.get(fn_name)
        } elif state.container_ends.has(short_name) == 1 {
            end_fn = state.container_ends.get(short_name)
        }
        if len(fn_name) > 3 and str_sub(fn_name, 0, 3) == "ui_" and (len(end_fn) <= 3 or str_sub(end_fn, 0, 3) != "ui_") {
            end_fn = "ui_" + end_fn
        }

        raw_body = parse_block(state)

        end_node = AstNode()
        end_node.line = brace_tok.line
        end_node.col = brace_tok.col
        end_node.kind = "Call"
        end_node.val_str = end_fn
        end_node.args = []

        transformed = inject_container_cleanup(raw_body, end_node)
        transformed.append(end_node)

        block_node = AstNode()
        block_node.line = stmt_line
        block_node.col = stmt_col
        block_node.kind = "Block"
        block_node.body = [expr]
        bi = 0
        while bi < len(transformed) {
            block_node.body.append(transformed[bi])
            bi = bi + 1
        }
        return block_node
    }

    if expr.kind == "Call" and expr.val_str == "assert" and len(expr.args) >= 1 and len(expr.args) <= 2 {
        return build_assert(state, expr, stmt_line)
    }

    return expr
}

def parse_export(state: ParserState) -> list {
    eat_tok(state, "EXPORT")
    eat_tok(state, "LBRACE")
    names = []
    check = current_tok(state)
    while check.kind != "RBRACE" {
        name_tok = eat_tok(state, "IDENT")
        names.append(name_tok.val)
        check = current_tok(state)
        if check.kind == "COMMA" {
            eat_tok(state, "COMMA")
            check = current_tok(state)
        }
    }
    eat_tok(state, "RBRACE")
    return names
}

def parse_switch(state: ParserState, stmt_line: int, stmt_col: int) -> AstNode {
    eat_tok(state, "SWITCH")
    expr = parse_expr(state)
    eat_tok(state, "LBRACE")
    case_exprs = []
    case_bodies = []
    else_body = []
    
    check = current_tok(state)
    while check.kind != "RBRACE" and check.kind != "EOF" {
        if check.kind == "CASE" {
            eat_tok(state, "CASE")
            case_exprs.append(parse_expr(state))
            case_bodies.append(parse_block(state))
        } elif check.kind == "ELSE" {
            eat_tok(state, "ELSE")
            else_body = parse_block(state)
        } else {
            break
        }
        check = current_tok(state)
    }
    eat_tok(state, "RBRACE")
    
    if len(case_exprs) == 0 {
        if len(else_body) > 0 { return else_body[0] }
        node = AstNode()
        node.line = stmt_line
        node.col = stmt_col
        node.kind = "NONE"
        return node
    }
    
    i = len(case_exprs) - 1
    current_else = else_body
    while i >= 0 {
        cond_node = AstNode()
        cond_node.line = stmt_line
        cond_node.col = stmt_col
        cond_node.kind = "Compare"
        cond_node.val_str = "=="
        cond_node.left = expr
        cond_node.right = case_exprs[i]
        
        if_node = AstNode()
        if_node.line = stmt_line
        if_node.col = stmt_col
        if_node.kind = "IfElse"
        if_node.cond = cond_node
        if_node.body = case_bodies[i]
        if_node.else_body = current_else
        
        current_else = [if_node]
        i = i - 1
    }
    
    return current_else[0]
}

def parse_match_arm_body(state: ParserState) -> list {
    check = current_tok(state)
    if check.kind == "LBRACE" {
        return parse_block(state)
    }
    stmt = parse_statement(state)
    if stmt.kind != "NONE" {
        return [stmt]
    }
    return []
}

def parse_match(state: ParserState, stmt_line: int, stmt_col: int) -> AstNode {
    eat_tok(state, "MATCH")
    target_expr = parse_expr(state)
    eat_tok(state, "LBRACE")

    tmp_var = "__match_val_" + str(state.comp_counter)
    state.comp_counter = state.comp_counter + 1

    assign_target = AstNode()
    assign_target.line = stmt_line
    assign_target.col = stmt_col
    assign_target.kind = "Assignment"
    assign_target.val_str = tmp_var
    assign_target.left = target_expr

    tmp_ref = AstNode()
    tmp_ref.line = stmt_line
    tmp_ref.col = stmt_col
    tmp_ref.kind = "Variable"
    tmp_ref.val_str = tmp_var

    arm_conds = []
    arm_bodies = []
    else_body = []

    check = current_tok(state)
    while check.kind != "RBRACE" and check.kind != "EOF" {
        if check.kind == "ELSE" or (check.kind == "IDENT" and check.val == "_") {
            eat_tok(state, check.kind)
            eat_tok(state, "FAT_ARROW")
            else_body = parse_match_arm_body(state)
        } else {
            nt = peek_tok(state, 1)
            if check.kind == "IDENT" and nt.kind == "DOT" and state.data_fields.has("__enum_" + check.val) {
                enum_name = eat_tok(state, "IDENT").val
                eat_tok(state, "DOT")
                variant_name = eat_tok(state, "IDENT").val

                tag_key = "__enum_tag_" + enum_name + "." + variant_name
                tag_val = 0
                if state.data_fields.has(tag_key) {
                    t_list = state.data_fields.get(tag_key)
                    tag_val = t_list[0]
                }

                ncheck = current_tok(state)
                if ncheck.kind == "LPAREN" {
                    eat_tok(state, "LPAREN")
                    bindings = []
                    bcheck = current_tok(state)
                    while bcheck.kind != "RPAREN" and bcheck.kind != "EOF" {
                        b_name = eat_tok(state, "IDENT").val
                        bindings.append(b_name)
                        bcheck = current_tok(state)
                        if bcheck.kind == "COMMA" {
                            eat_tok(state, "COMMA")
                            bcheck = current_tok(state)
                        }
                    }
                    eat_tok(state, "RPAREN")
                    eat_tok(state, "FAT_ARROW")
                    arm_body = parse_match_arm_body(state)

                    variant_type = enum_name + "_" + variant_name

                    tag_typed_ref = AstNode()
                    tag_typed_ref.line = stmt_line
                    tag_typed_ref.col = stmt_col
                    tag_typed_ref.kind = "Variable"
                    tag_typed_ref.val_str = tmp_var
                    tag_typed_ref.inferred_type = create_struct_type(variant_type)

                    tag_access = AstNode()
                    tag_access.line = stmt_line
                    tag_access.col = stmt_col
                    tag_access.kind = "DataFieldAccess"
                    tag_access.left = tag_typed_ref
                    tag_access.val_str = "__tag"

                    cmp_node = AstNode()
                    cmp_node.line = stmt_line
                    cmp_node.col = stmt_col
                    cmp_node.kind = "Compare"
                    cmp_node.val_str = "=="
                    cmp_node.left = tag_access
                    cmp_node.right = make_number_node(tag_val, stmt_line, stmt_col)

                    vf_key = "__enum_fields_" + enum_name + "." + variant_name
                    vfields = []
                    if state.data_fields.has(vf_key) {
                        vfields = state.data_fields.get(vf_key)
                    }

                    full_body = []
                    bi = 0
                    while bi < len(bindings) {
                        fname = "a" + str(bi)
                        if bi < len(vfields) { fname = vfields[bi] }

                        typed_ref = AstNode()
                        typed_ref.line = stmt_line
                        typed_ref.col = stmt_col
                        typed_ref.kind = "Variable"
                        typed_ref.val_str = tmp_var
                        typed_ref.inferred_type = create_struct_type(variant_type)

                        f_access = AstNode()
                        f_access.line = stmt_line
                        f_access.col = stmt_col
                        f_access.kind = "DataFieldAccess"
                        f_access.left = typed_ref
                        f_access.val_str = fname

                        b_assign = AstNode()
                        b_assign.line = stmt_line
                        b_assign.col = stmt_col
                        b_assign.kind = "Assignment"
                        b_assign.val_str = bindings[bi]
                        b_assign.left = f_access

                        full_body.append(b_assign)
                        bi = bi + 1
                    }
                    bj = 0
                    while bj < len(arm_body) {
                        full_body.append(arm_body[bj])
                        bj = bj + 1
                    }

                    arm_conds.append(cmp_node)
                    arm_bodies.append(full_body)
                } else {
                    eat_tok(state, "FAT_ARROW")
                    arm_body = parse_match_arm_body(state)

                    cmp_node = AstNode()
                    cmp_node.line = stmt_line
                    cmp_node.col = stmt_col
                    cmp_node.kind = "Compare"
                    cmp_node.val_str = "=="
                    cmp_node.left = tmp_ref
                    cmp_node.right = make_number_node(tag_val, stmt_line, stmt_col)

                    arm_conds.append(cmp_node)
                    arm_bodies.append(arm_body)
                }
            } else {
                pat_expr = parse_expr(state)
                eat_tok(state, "FAT_ARROW")
                arm_body = parse_match_arm_body(state)

                cmp_node = AstNode()
                cmp_node.line = stmt_line
                cmp_node.col = stmt_col
                cmp_node.kind = "Compare"
                cmp_node.val_str = "=="
                cmp_node.left = tmp_ref
                cmp_node.right = pat_expr

                arm_conds.append(cmp_node)
                arm_bodies.append(arm_body)
            }
        }
        check = current_tok(state)
    }
    eat_tok(state, "RBRACE")

    current_else = else_body
    i = len(arm_conds) - 1
    while i >= 0 {
        if_node = AstNode()
        if_node.line = stmt_line
        if_node.col = stmt_col
        if_node.kind = "IfElse"
        if_node.cond = arm_conds[i]
        if_node.body = arm_bodies[i]
        if_node.else_body = current_else

        current_else = [if_node]
        i = i - 1
    }

    block_node = AstNode()
    block_node.line = stmt_line
    block_node.col = stmt_col
    block_node.kind = "Block"
    if len(current_else) > 0 {
        block_node.body = [assign_target, current_else[0]]
    } else {
        block_node.body = [assign_target]
    }
    return block_node
}

def parse_enum_def(state: ParserState, stmt_line: int, stmt_col: int) -> AstNode {
    eat_tok(state, "ENUM")
    name = eat_tok(state, "IDENT").val
    eat_tok(state, "LBRACE")
    variants = []
    variant_fields = []
    check = current_tok(state)
    while check.kind != "RBRACE" and check.kind != "EOF" {
        v = eat_tok(state, "IDENT").val
        variants.append(v)
        vfields = []
        check = current_tok(state)
        if check.kind == "LPAREN" {
            eat_tok(state, "LPAREN")
            pcheck = current_tok(state)
            while pcheck.kind != "RPAREN" and pcheck.kind != "EOF" {
                pname = eat_tok(state, "IDENT").val
                vfields.append(pname)
                pcheck = current_tok(state)
                if pcheck.kind == "COMMA" {
                    eat_tok(state, "COMMA")
                    pcheck = current_tok(state)
                }
            }
            eat_tok(state, "RPAREN")
            check = current_tok(state)
        }
        variant_fields.append(vfields)
        if check.kind == "COMMA" {
            eat_tok(state, "COMMA")
            check = current_tok(state)
        }
    }
    eat_tok(state, "RBRACE")

    state.data_fields.set("__enum_" + name, variants)
    j = 0
    while j < len(variants) {
        v = variants[j]
        vf = variant_fields[j]
        state.data_fields.set("__enum_fields_" + name + "." + v, vf)
        state.data_fields.set("__enum_tag_" + name + "." + v, [j])
        state.const_table.set(name + "_" + v, j)

        if len(vf) > 0 {
            type_name = name + "_" + v
            struct_fields = ["__tag"]
            fk = 0
            while fk < len(vf) {
                struct_fields.append(vf[fk])
                fk = fk + 1
            }
            state.data_fields.set(type_name, struct_fields)
            seen = 0
            si = 0
            while si < len(state.ctors_used) {
                if state.ctors_used[si] == type_name { seen = 1 }
                si = si + 1
            }
            if seen == 0 { state.ctors_used.append(type_name) }
        }

        j = j + 1
    }

    node = AstNode()
    node.line = stmt_line
    node.col = stmt_col
    node.kind = "EnumDef"
    node.val_str = name
    node.params = variants
    return node
}

def desugar_enums(program: list, state: ParserState) -> list {
    result = []
    i = 0
    while i < len(program) {
        node = program[i]
        if node.kind == "EnumDef" {
            name = node.val_str
            j = 0
            while j < len(node.params) {
                v = node.params[j]
                vf_key = "__enum_fields_" + name + "." + v
                vf = []
                if state.data_fields.has(vf_key) {
                    vf = state.data_fields.get(vf_key)
                }

                const_name = name + "_" + v
                state.const_table.set(const_name, j)
                assign = AstNode()
                assign.line = node.line
                assign.col = node.col
                assign.kind = "Assignment"
                assign.val_str = const_name
                assign.val_int = 1
                assign.left = make_number_node(j, node.line, node.col)
                result.append(assign)

                if len(vf) > 0 {
                    type_name = name + "_" + v
                    struct_fields = ["__tag"]
                    struct_types = ["int"]
                    fk = 0
                    while fk < len(vf) {
                        struct_fields.append(vf[fk])
                        struct_types.append("any")
                        fk = fk + 1
                    }

                    dnode = AstNode()
                    dnode.line = node.line
                    dnode.col = node.col
                    dnode.kind = "Data"
                    dnode.val_str = type_name
                    dnode.params = struct_fields
                    dnode.param_types = struct_types
                    result.append(dnode)

                    state.data_fields.set(type_name, struct_fields)
                    seen = 0
                    si = 0
                    while si < len(state.ctors_used) {
                        if state.ctors_used[si] == type_name { seen = 1 }
                        si = si + 1
                    }
                    if seen == 0 { state.ctors_used.append(type_name) }
                }
                j = j + 1
            }
        } else {
            result.append(node)
        }
        i = i + 1
    }
    return result
}

# test_mode: "drop" (test blocks are removed), "keep" (kept as functions so they are type-checked) or
# "run" (kept and called by the generated runner of `nova test`). Plain parse() drops them.
def parse(tokens: list, filename: string) -> list {
    return parse_with_tests(tokens, filename, "drop")
}

def parse_with_tests(tokens: list, filename: string, test_mode: string) -> list {
    state = ParserState()
    state.tokens = tokens
    state.pos = 0
    state.filename = filename
    state.comp_counter = 0
    state.imported_modules = {}
    state.data_fields = {}
    state.data_field_defaults = {}
    state.in_test = 0
    state.needs_system = 0
    state.test_mode = test_mode
    state.test_count = 0
    state.ctors_used = []
    state.const_table = {}
    state.containers = {"stack": 1, "card": 1, "row": 1, "frame": 1, "ui_stack": 1, "ui_card": 1, "ui_row": 1, "ui_frame": 1}
    state.container_ends = {"stack": "end_stack", "card": "end_card", "row": "end_row", "frame": "end_frame", "ui_stack": "ui_end_stack", "ui_card": "ui_end_card", "ui_row": "ui_end_row", "ui_frame": "ui_end_frame"}
    program = []
    
    loop = 1
    while loop == 1 {
        tok = current_tok(state)
        if tok.kind == "EOF" {
            break
        }
        stmt = parse_statement(state)
        if stmt.kind != "NONE" {
            program.append(stmt)
        }
    }

    program = desugar_enums(program, state)

    # assert() outside a test stops the program through sys_exit, which lives in module `system`
    if state.needs_system == 1 {
        has_system = 0
        pi = 0
        while pi < len(program) {
            if program[pi].kind == "Import" and program[pi].val_str == "system" { has_system = 1 }
            pi = pi + 1
        }
        if has_system == 0 {
            sys_snippet = parse(tokenize("import system\n"), filename)
            with_system = [sys_snippet[0]]
            pi = 0
            while pi < len(program) {
                with_system.append(program[pi])
                pi = pi + 1
            }
            program = with_system
        }
    }

    ci = 0
    while ci < len(state.ctors_used) {
        ctor_name = state.ctors_used[ci]
        ctor_ast = parse(tokenize(constructor_source(ctor_name, state.data_fields.get(ctor_name))), filename)
        cj = 0
        while cj < len(ctor_ast) {
            program.append(ctor_ast[cj])
            cj = cj + 1
        }
        ci = ci + 1
    }

    return program
}

# --- Utility: atoi ---
def atoi(str_val: string) -> int {
    val = 0
    i = 0
    sign = 1
    base = 10
    if len(str_val) > 0 {
        if str_val[0] == "-" {
            sign = -1
            i = 1
        }
    }
    if i + 1 < len(str_val) {
        if str_val[i] == "0" and (str_val[i + 1] == "x" or str_val[i + 1] == "X") {
            base = 16
            i = i + 2
        }
        elif str_val[i] == "0" and (str_val[i + 1] == "b" or str_val[i + 1] == "B") {
            base = 2
            i = i + 2
        }
    }
    while i < len(str_val) {
        ch = str_val[i]
        digit = 0
        if ch >= "0" and ch <= "9" { digit = get_char_code(ch) - get_char_code("0") }
        elif base == 16 and ch >= "a" and ch <= "f" { digit = get_char_code(ch) - get_char_code("a") + 10 }
        elif base == 16 and ch >= "A" and ch <= "F" { digit = get_char_code(ch) - get_char_code("A") + 10 }
        else { break }
        if digit >= base { break }
        val = val * base + digit
        i = i + 1
    }
    return val * sign
}
