# =============================================================================
# Nova Native Audio & Sound Synthesis Engine (stdlib/audio.nv)
# Pure native hardware beeps, sound effects, and PCM waveform synthesis
# =============================================================================
import system

# Native Win32 kernel32 hardware sound extern
extern def Beep(dwFreq: int, dwDuration: int) -> int

def beep(frequencyHz: int, durationMs: int) {
    if frequencyHz < 37 { frequencyHz = 37 }
    if frequencyHz > 32767 { frequencyHz = 32767 }
    if durationMs <= 0 { return }
    Beep(frequencyHz, durationMs)
}

def click() {
    beep(1200, 12)
}

def success() {
    beep(880, 30)
    beep(1320, 45)
}

def error() {
    beep(220, 80)
}

def playNote(noteName: string, durationMs: int) {
    freq = 440
    if noteName == "C4" { freq = 261 }
    elif noteName == "D4" { freq = 293 }
    elif noteName == "E4" { freq = 329 }
    elif noteName == "F4" { freq = 349 }
    elif noteName == "G4" { freq = 392 }
    elif noteName == "A4" { freq = 440 }
    elif noteName == "B4" { freq = 493 }
    elif noteName == "C5" { freq = 523 }
    elif noteName == "D5" { freq = 587 }
    elif noteName == "E5" { freq = 659 }
    beep(freq, durationMs)
}

# --- Waveform Sample Generation for Visualizer & Particle Oscillators ---

# Sine approximation: phase in 0..359 degrees, returns -100..100
def sampleSine(phaseDegrees: int) -> int {
    deg = phaseDegrees % 360
    if deg < 0 { deg = deg + 360 }
    if deg < 180 {
        return (deg * (180 - deg)) / 81
    }
    d2 = deg - 180
    return 0 - ((d2 * (180 - d2)) / 81)
}

# Square wave: returns 100 or -100
def sampleSquare(phaseDegrees: int) -> int {
    deg = phaseDegrees % 360
    if deg < 0 { deg = deg + 360 }
    if deg < 180 { return 100 }
    return -100
}

# Triangle wave: returns -100..100
def sampleTriangle(phaseDegrees: int) -> int {
    deg = phaseDegrees % 360
    if deg < 0 { deg = deg + 360 }
    if deg < 90 {
        return (deg * 100) / 90
    } elif deg < 270 {
        return 100 - ((deg - 90) * 200) / 180
    }
    return -100 + ((deg - 270) * 100) / 90
}

# Pseudo-random noise sample: returns -100..100
def sampleNoise(seedValue: int) -> int {
    n = (seedValue * 1103515245 + 12345) % 201
    return n - 100
}
