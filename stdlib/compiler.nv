def contains(lst: list, item: string) -> int {
    i = 0
    while i < len(lst) {
        if lst[i] == item { return 1 }
        i = i + 1
    }
    return 0
}

# Directory containing the running nova.exe itself, or "" if it can't be determined. Unlike
# resolving stdlib/ relative to the current working directory, this lets `nova build` work from
# any directory once nova.exe is on PATH -- it no longer has to be run from inside the repo/
# install checkout.
def exeDir() -> string {
    ep = system.exe_path()
    if len(ep) == 0 { return "" }
    last = -1
    k = 0
    while k < len(ep) {
        ch = ep[k]
        if ch == "/" or ch == "\\" { last = k }
        k = k + 1
    }
    if last <= 0 { return "" }
    return str_sub(ep, 0, last)
}

def exe_dir() -> string { return exeDir() }

# Directory part of a path including the trailing slash ("" when there is none).
def sourceDir(targetPath: string) -> string {
    slash = -1
    i = 0
    while i < len(targetPath) {
        if targetPath[i] == "/" or targetPath[i] == "\\" { slash = i }
        i = i + 1
    }
    if slash < 0 { return "" }
    return str_sub(targetPath, 0, slash + 1)
}

def source_dir(targetPath: string) -> string { return sourceDir(targetPath) }

def str_upper_char(ch: string) -> string {
    if ch == "a" { return "A" }
    if ch == "b" { return "B" }
    if ch == "c" { return "C" }
    if ch == "d" { return "D" }
    if ch == "e" { return "E" }
    if ch == "f" { return "F" }
    if ch == "g" { return "G" }
    if ch == "h" { return "H" }
    if ch == "i" { return "I" }
    if ch == "j" { return "J" }
    if ch == "k" { return "K" }
    if ch == "l" { return "L" }
    if ch == "m" { return "M" }
    if ch == "n" { return "N" }
    if ch == "o" { return "O" }
    if ch == "p" { return "P" }
    if ch == "q" { return "Q" }
    if ch == "r" { return "R" }
    if ch == "s" { return "S" }
    if ch == "t" { return "T" }
    if ch == "u" { return "U" }
    if ch == "v" { return "V" }
    if ch == "w" { return "W" }
    if ch == "x" { return "X" }
    if ch == "y" { return "Y" }
    if ch == "z" { return "Z" }
    return ch
}

def snakeToCamel(sourceString: string) -> string {
    res = ""
    i = 0
    to_upper = 0
    while i < len(sourceString) {
        ch = sourceString[i]
        if ch == "_" {
            to_upper = 1
        } else {
            if to_upper == 1 {
                res = res + str_upper_char(ch)
                to_upper = 0
            } else {
                res = res + ch
            }
        }
        i = i + 1
    }
    return res
}

def snake_to_camel(s: string) -> string {
    return snakeToCamel(s)
}

def _resolve_edit_distance(a: string, b: string) -> int {
    la = len(a)
    lb = len(b)
    prev = []
    j = 0
    while j <= lb {
        prev.append(j)
        j = j + 1
    }
    i = 1
    while i <= la {
        cur = [i]
        j = 1
        while j <= lb {
            cost = 1
            if a[i - 1] == b[j - 1] { cost = 0 }
            best = prev[j - 1] + cost
            if prev[j] + 1 < best { best = prev[j] + 1 }
            if cur[j - 1] + 1 < best { best = cur[j - 1] + 1 }
            cur.append(best)
            j = j + 1
        }
        prev = cur
        i = i + 1
    }
    return prev[lb]
}

def suggestMemberName(candidates: list, name: string) -> string {
    if candidates == 0 { return "" }
    best = ""
    best_d = 4
    i = 0
    while i < len(candidates) {
        cand = candidates[i] + ""
        diff = len(cand) - len(name)
        if diff < 0 { diff = 0 - diff }
        if diff <= 2 and cand != name {
            d = _resolve_edit_distance(name, cand)
            if d < best_d {
                best_d = d
                best = cand
            }
        }
        i = i + 1
    }
    return best
}

def suggest_member_name(candidates: list, name: string) -> string {
    return suggestMemberName(candidates, name)
}

def rewrite_module_internal_expr(node: AstNode, renames: dict) {
    if node == 0 { return }
    k = node.kind
    if k == "BinOp" or k == "Compare" {
        rewrite_module_internal_expr(node.left, renames)
        rewrite_module_internal_expr(node.right, renames)
        return
    }
    if k == "UnaryOp" {
        rewrite_module_internal_expr(node.left, renames)
        return
    }
    if k == "Ternary" {
        rewrite_module_internal_expr(node.cond, renames)
        rewrite_module_internal_expr(node.left, renames)
        rewrite_module_internal_expr(node.right, renames)
        return
    }
    if k == "Call" {
        if renames.has(node.val_str) == 1 {
            node.val_str = renames.get(node.val_str)
            node.name = node.val_str
        }
        if node.args != 0 {
            ai = 0
            while ai < len(node.args) {
                rewrite_module_internal_expr(node.args[ai], renames)
                ai = ai + 1
            }
        }
        return
    }
    if k == "MethodCall" {
        rewrite_module_internal_expr(node.left, renames)
        if node.args != 0 {
            ai = 0
            while ai < len(node.args) {
                rewrite_module_internal_expr(node.args[ai], renames)
                ai = ai + 1
            }
        }
        return
    }
    if k == "ArrayIndex" or k == "DataFieldAccess" {
        rewrite_module_internal_expr(node.left, renames)
        if node.right != 0 { rewrite_module_internal_expr(node.right, renames) }
        return
    }
    if k == "ListLiteral" {
        if node.args != 0 {
            ai = 0
            while ai < len(node.args) {
                rewrite_module_internal_expr(node.args[ai], renames)
                ai = ai + 1
            }
        }
        return
    }
}

def rewrite_module_internal_stmt(node: AstNode, renames: dict) {
    if node == 0 { return }
    k = node.kind
    if k == "Assignment" or k == "UnpackAssign" or k == "Return" or k == "Print" or k == "PrintD" {
        rewrite_module_internal_expr(node.left, renames)
        return
    }
    if k == "DataFieldAssign" {
        rewrite_module_internal_expr(node.left, renames)
        rewrite_module_internal_expr(node.right, renames)
        return
    }
    if k == "ArrayIndexAssign" {
        rewrite_module_internal_expr(node.left, renames)
        rewrite_module_internal_expr(node.right, renames)
        rewrite_module_internal_expr(node.cond, renames)
        return
    }
    if k == "IfElse" or k == "While" {
        rewrite_module_internal_expr(node.cond, renames)
        if node.body != 0 {
            bi = 0
            while bi < len(node.body) {
                rewrite_module_internal_stmt(node.body[bi], renames)
                bi = bi + 1
            }
        }
        if node.else_body != 0 {
            bi = 0
            while bi < len(node.else_body) {
                rewrite_module_internal_stmt(node.else_body[bi], renames)
                bi = bi + 1
            }
        }
        return
    }
    if k == "ForIn" or k == "ForLoop" {
        rewrite_module_internal_expr(node.left, renames)
        if node.body != 0 {
            bi = 0
            while bi < len(node.body) {
                rewrite_module_internal_stmt(node.body[bi], renames)
                bi = bi + 1
            }
        }
        return
    }
    if k == "Block" or k == "RawBlock" or k == "TRY" or k == "Defer" {
        if node.body != 0 {
            bi = 0
            while bi < len(node.body) {
                rewrite_module_internal_stmt(node.body[bi], renames)
                bi = bi + 1
            }
        }
        return
    }
    if k == "Call" or k == "MethodCall" {
        rewrite_module_internal_expr(node, renames)
        return
    }
}

def shouldNamespaceModule(module_name: string, found_path: string) -> int {
    if str_contains(found_path, "stdlib") == 0 {
        return 0
    }
    if module_name == "fs" or module_name == "path" or module_name == "buffer" or module_name == "net" or module_name == "time" or module_name == "env" or module_name == "process" or module_name == "audio" or module_name == "text" or module_name == "json" {
        return 1
    }
    return 0
}

def should_namespace_module(module_name: string, found_path: string) -> int {
    return shouldNamespaceModule(module_name, found_path)
}

def namespace_module_ast(module_name: string, ast: list, found_path: string) {
    if should_namespace_module(module_name, found_path) == 0 { return }
    prefix = module_name + "_"
    plen = len(prefix)
    renames = {}
    i = 0
    while i < len(ast) {
        node = ast[i]
        if node.kind == "Function" and node.val_int != 2 {
            fn_name = node.val_str
            if len(fn_name) <= plen or str_sub(fn_name, 0, plen) != prefix {
                mangled = prefix + fn_name
                renames.set(fn_name, mangled)
                node.val_str = mangled
                node.name = mangled
            }
        }
        i = i + 1
    }
    if len(renames.keys()) > 0 {
        i = 0
        while i < len(ast) {
            node = ast[i]
            if node.kind == "Function" and node.body != 0 {
                bi = 0
                while bi < len(node.body) {
                    rewrite_module_internal_stmt(node.body[bi], renames)
                    bi = bi + 1
                }
            }
            # methods of the module's classes call the module's own functions too (TcpListener.accept -> new_tcp_stream)
            if node.kind == "ClassDef" and node.methods != 0 {
                mi = 0
                while mi < len(node.methods) {
                    meth = node.methods[mi]
                    if meth.body != 0 {
                        bi = 0
                        while bi < len(meth.body) {
                            rewrite_module_internal_stmt(meth.body[bi], renames)
                            bi = bi + 1
                        }
                    }
                    mi = mi + 1
                }
            }
            i = i + 1
        }
    }
}

def collect_module_exports(module_name: string, ast: list, module_exports: dict, module_candidates: dict) {
    mod_table = {}
    if module_exports.has(module_name) == 1 {
        mod_table = module_exports.get(module_name)
    } else {
        module_exports.set(module_name, mod_table)
    }
    cands = []
    if module_candidates.has(module_name) == 1 {
        cands = module_candidates.get(module_name)
    } else {
        module_candidates.set(module_name, cands)
    }

    prefix = module_name + "_"
    plen = len(prefix)

    i = 0
    while i < len(ast) {
        node = ast[i]
        if node.kind == "Function" {
            fn_name = node.val_str
            # Always register exact function name
            mod_table.set(fn_name, fn_name)
            cands.append(fn_name)

            # Starts with module_name + "_"
            if len(fn_name) > plen and str_sub(fn_name, 0, plen) == prefix {
                stripped = str_sub(fn_name, plen, len(fn_name))
                camel = snake_to_camel(stripped)
                if mod_table.has(camel) == 0 {
                    mod_table.set(camel, fn_name)
                    cands.append(camel)
                }
                if camel != stripped and mod_table.has(stripped) == 0 {
                    mod_table.set(stripped, fn_name)
                }
                if module_name == "path" {
                    if stripped == "base" and mod_table.has("basename") == 0 { mod_table.set("basename", fn_name) }
                    if stripped == "dir" and mod_table.has("dirname") == 0 { mod_table.set("dirname", fn_name) }
                    if stripped == "ext" and mod_table.has("extension") == 0 { mod_table.set("extension", fn_name) }
                }
                if module_name == "fs" {
                    if stripped == "read" and mod_table.has("readText") == 0 { mod_table.set("readText", fn_name) }
                    if stripped == "write" and mod_table.has("writeText") == 0 { mod_table.set("writeText", fn_name) }
                    if stripped == "makeDir" and mod_table.has("mkdir") == 0 { mod_table.set("mkdir", fn_name) }
                }
            } else {
                camel = snake_to_camel(fn_name)
                if camel != fn_name and mod_table.has(camel) == 0 {
                    mod_table.set(camel, fn_name)
                    cands.append(camel)
                }
            }
        }
        i = i + 1
    }
    if module_name == "os_windows" or module_name == "os_unix" {
        module_exports.set("os_impl", mod_table)
        module_candidates.set("os_impl", cands)
    }
}

# Old flat spellings stay valid after a module's members became camelCase (fs_write_atomic -> fs_writeAtomic,
# path_basename -> path_base, new_buffer -> buffer_alloc): map a call to the function the module really defines.
def legacy_flat_name(name: string, module_exports: dict) -> string {
    if name == "new_buffer" { return "buffer_alloc" }
    if name == "socket_set_timeout" { return "net_setTimeout" }
    if name == "time_ticks_ms" { return "time_ticks" }
    if name == "str_slice" { return "text_slice" }
    if name == "tcp_listen" { return "net_listen" }
    if name == "tcp_connect" { return "net_connect" }
    if name == "new_tcp_stream" { return "net_new_tcp_stream" }
    if name == "json_cursor_new" { return "json_newCursor" }
    mods = module_exports.keys()
    mi = 0
    while mi < len(mods) {
        m = mods[mi]
        prefix = m + "_"
        plen = len(prefix)
        if len(name) > plen and str_sub(name, 0, plen) == prefix {
            mtab = module_exports.get(m)
            if mtab.has(name) == 0 {
                rest = str_sub(name, plen, len(name))
                camel = snake_to_camel(rest)
                if mtab.has(camel) == 1 { return mtab.get(camel) }
                if mtab.has(rest) == 1 { return mtab.get(rest) }
            }
        }
        mi = mi + 1
    }
    return name
}

def resolve_module_expr(node: AstNode, module_exports: dict, module_candidates: dict, scope_modules: dict, scope_locals: dict, filename: string) -> AstNode {
    if node == 0 { return 0 }
    k = node.kind
    if k == "BinOp" or k == "Compare" {
        node.left = resolve_module_expr(node.left, module_exports, module_candidates, scope_modules, scope_locals, filename)
        node.right = resolve_module_expr(node.right, module_exports, module_candidates, scope_modules, scope_locals, filename)
        return node
    }
    if k == "UnaryOp" {
        node.left = resolve_module_expr(node.left, module_exports, module_candidates, scope_modules, scope_locals, filename)
        return node
    }
    if k == "Ternary" {
        node.cond = resolve_module_expr(node.cond, module_exports, module_candidates, scope_modules, scope_locals, filename)
        node.left = resolve_module_expr(node.left, module_exports, module_candidates, scope_modules, scope_locals, filename)
        node.right = resolve_module_expr(node.right, module_exports, module_candidates, scope_modules, scope_locals, filename)
        return node
    }
    if k == "Call" {
        if node.args != 0 {
            ai = 0
            while ai < len(node.args) {
                node.args[ai] = resolve_module_expr(node.args[ai], module_exports, module_candidates, scope_modules, scope_locals, filename)
                ai = ai + 1
            }
        }
        node.val_str = legacy_flat_name(node.val_str, module_exports)
        return node
    }
    if k == "MethodCall" {
        node.left = resolve_module_expr(node.left, module_exports, module_candidates, scope_modules, scope_locals, filename)
        if node.args != 0 {
            ai = 0
            while ai < len(node.args) {
                node.args[ai] = resolve_module_expr(node.args[ai], module_exports, module_candidates, scope_modules, scope_locals, filename)
                ai = ai + 1
            }
        }
        if node.left != 0 and node.left.kind == "Variable" {
            var_name = node.left.val_str
            if scope_locals.has(var_name) == 0 and scope_modules.has(var_name) == 1 {
                mod_name = scope_modules.get(var_name)
                member = node.val_str
                target_fn = ""
                if module_exports.has(mod_name) == 1 {
                    mtab = module_exports.get(mod_name)
                    if mtab.has(member) == 1 {
                        target_fn = mtab.get(member)
                    }
                }
                if len(target_fn) > 0 {
                    call_node = AstNode()
                    call_node.line = node.line
                    call_node.col = node.col
                    call_node.kind = "Call"
                    call_node.val_str = target_fn
                    call_node.args = node.args
                    call_node.arg_names = node.arg_names
                    call_node.arg_is_kw = node.arg_is_kw
                    if (target_fn == "path_join" or (mod_name == "path" and target_fn == "join")) and len(node.args) != 1 {
                        list_node = AstNode()
                        list_node.line = node.line
                        list_node.col = node.col
                        list_node.kind = "ListLiteral"
                        list_node.args = node.args
                        call_node.args = [list_node]
                    }
                    return call_node
                } else {
                    cands = 0
                    if module_candidates.has(mod_name) == 1 {
                        cands = module_candidates.get(mod_name)
                    }
                    sug = suggest_member_name(cands, member)
                    if len(sug) > 0 {
                        errors.err("Name", filename, node.line, "module '" + mod_name + "' has no function '" + member + "'", "did you mean '" + mod_name + "." + sug + "'?", node.col)
                    } else {
                        errors.err("Name", filename, node.line, "module '" + mod_name + "' has no function '" + member + "'", "check the spelling; see the module's public functions in the docs", node.col)
                    }
                }
            }
        }
        return node
    }
    if k == "DataFieldAccess" {
        node.left = resolve_module_expr(node.left, module_exports, module_candidates, scope_modules, scope_locals, filename)
        if node.left != 0 and node.left.kind == "Variable" {
            var_name = node.left.val_str
            member = node.val_str
            if publicConst(var_name, member) == 1 {
                cval = moduleConst(var_name, member)
                num_node = AstNode()
                num_node.line = node.line
                num_node.col = node.col
                num_node.kind = "Number"
                num_node.val_int = cval
                num_node.is_float = 0
                return num_node
            }
            if scope_locals.has(var_name) == 0 and scope_modules.has(var_name) == 1 {
                mod_name = scope_modules.get(var_name)
                target_fn = ""
                if module_exports.has(mod_name) == 1 {
                    mtab = module_exports.get(mod_name)
                    if mtab.has(member) == 1 {
                        target_fn = mtab.get(member)
                    }
                }
                if len(target_fn) > 0 {
                    call_node = AstNode()
                    call_node.line = node.line
                    call_node.col = node.col
                    call_node.kind = "Call"
                    call_node.val_str = target_fn
                    call_node.args = []
                    return call_node
                }
            }
        }
        return node
    }
    if k == "ArrayIndex" {
        node.left = resolve_module_expr(node.left, module_exports, module_candidates, scope_modules, scope_locals, filename)
        node.right = resolve_module_expr(node.right, module_exports, module_candidates, scope_modules, scope_locals, filename)
        return node
    }
    if k == "ListLiteral" or k == "DictLiteral" {
        if node.args != 0 {
            ai = 0
            while ai < len(node.args) {
                node.args[ai] = resolve_module_expr(node.args[ai], module_exports, module_candidates, scope_modules, scope_locals, filename)
                ai = ai + 1
            }
        }
        return node
    }
    if k == "Block" {
        if node.body != 0 {
            bi = 0
            while bi < len(node.body) {
                resolve_module_stmt(node.body[bi], module_exports, module_candidates, scope_modules, scope_locals, filename)
                bi = bi + 1
            }
        }
        return node
    }
    if k == "Len" or k == "StrConvert" or k == "SizeOf" or k == "Alloc" or k == "Free" or k == "OpenFile" or k == "Openf" or k == "ReadFile" or k == "WriteFile" or k == "CloseFile" or k == "Spawn" or k == "Await" {
        if node.left != 0 {
            node.left = resolve_module_expr(node.left, module_exports, module_candidates, scope_modules, scope_locals, filename)
        }
        if node.args != 0 {
            ai = 0
            while ai < len(node.args) {
                node.args[ai] = resolve_module_expr(node.args[ai], module_exports, module_candidates, scope_modules, scope_locals, filename)
                ai = ai + 1
            }
        }
        return node
    }
    return node
}

def scan_locals(stmts: list, locals_map: dict) {
    if stmts == 0 { return }
    i = 0
    while i < len(stmts) {
        s = stmts[i]
        if s != 0 {
            if s.kind == "Assignment" {
                locals_map.set(s.val_str, 1)
            } elif s.kind == "IfElse" {
                scan_locals(s.body, locals_map)
                scan_locals(s.else_body, locals_map)
            } elif s.kind == "While" or s.kind == "ForIn" or s.kind == "ForLoop" or s.kind == "Block" {
                scan_locals(s.body, locals_map)
            }
        }
        i = i + 1
    }
}

def resolve_module_stmt(node: AstNode, module_exports: dict, module_candidates: dict, scope_modules: dict, scope_locals: dict, filename: string) {
    if node == 0 { return }
    k = node.kind
    if k == "Assignment" {
        node.left = resolve_module_expr(node.left, module_exports, module_candidates, scope_modules, scope_locals, filename)
        if scope_modules.has(node.val_str) == 1 {
            scope_locals.set(node.val_str, 1)
        }
        return
    }
    if k == "UnpackAssign" {
        node.left = resolve_module_expr(node.left, module_exports, module_candidates, scope_modules, scope_locals, filename)
        return
    }
    if k == "DataFieldAssign" {
        node.left = resolve_module_expr(node.left, module_exports, module_candidates, scope_modules, scope_locals, filename)
        node.right = resolve_module_expr(node.right, module_exports, module_candidates, scope_modules, scope_locals, filename)
        return
    }
    if k == "ArrayIndexAssign" {
        node.left = resolve_module_expr(node.left, module_exports, module_candidates, scope_modules, scope_locals, filename)
        node.right = resolve_module_expr(node.right, module_exports, module_candidates, scope_modules, scope_locals, filename)
        node.cond = resolve_module_expr(node.cond, module_exports, module_candidates, scope_modules, scope_locals, filename)
        return
    }
    if k == "Return" {
        node.left = resolve_module_expr(node.left, module_exports, module_candidates, scope_modules, scope_locals, filename)
        return
    }
    if k == "IfElse" {
        node.cond = resolve_module_expr(node.cond, module_exports, module_candidates, scope_modules, scope_locals, filename)
        if node.body != 0 {
            si = 0
            while si < len(node.body) {
                resolve_module_stmt(node.body[si], module_exports, module_candidates, scope_modules, scope_locals, filename)
                si = si + 1
            }
        }
        if node.else_body != 0 {
            si = 0
            while si < len(node.else_body) {
                resolve_module_stmt(node.else_body[si], module_exports, module_candidates, scope_modules, scope_locals, filename)
                si = si + 1
            }
        }
        return
    }
    if k == "While" {
        node.cond = resolve_module_expr(node.cond, module_exports, module_candidates, scope_modules, scope_locals, filename)
        if node.body != 0 {
            si = 0
            while si < len(node.body) {
                resolve_module_stmt(node.body[si], module_exports, module_candidates, scope_modules, scope_locals, filename)
                si = si + 1
            }
        }
        return
    }
    if k == "ForIn" or k == "ForLoop" {
        node.left = resolve_module_expr(node.left, module_exports, module_candidates, scope_modules, scope_locals, filename)
        if node.body != 0 {
            si = 0
            while si < len(node.body) {
                resolve_module_stmt(node.body[si], module_exports, module_candidates, scope_modules, scope_locals, filename)
                si = si + 1
            }
        }
        return
    }
    if k == "Function" {
        fn_locals = {}
        if node.params != 0 {
            pi = 0
            while pi < len(node.params) {
                fn_locals.set(node.params[pi], 1)
                pi = pi + 1
            }
        }
        if node.body != 0 {
            scan_locals(node.body, fn_locals)
            bi = 0
            while bi < len(node.body) {
                resolve_module_stmt(node.body[bi], module_exports, module_candidates, scope_modules, fn_locals, filename)
                bi = bi + 1
            }
        }
        return
    }
    if k == "Call" or k == "MethodCall" or k == "DataFieldAccess" {
        res = resolve_module_expr(node, module_exports, module_candidates, scope_modules, scope_locals, filename)
        if res != node and res != 0 {
            node.kind = res.kind
            node.val_str = res.val_str
            node.args = res.args
            node.arg_names = res.arg_names
            node.arg_is_kw = res.arg_is_kw
            node.left = res.left
            node.val_int = res.val_int
            node.is_float = res.is_float
        }
        return
    }
    if k == "Print" or k == "PrintD" {
        node.left = resolve_module_expr(node.left, module_exports, module_candidates, scope_modules, scope_locals, filename)
        return
    }
    if k == "Block" or k == "RawBlock" or k == "TRY" or k == "Defer" {
        if node.body != 0 {
            si = 0
            while si < len(node.body) {
                resolve_module_stmt(node.body[si], module_exports, module_candidates, scope_modules, scope_locals, filename)
                si = si + 1
            }
        }
        if node.else_body != 0 {
            si = 0
            while si < len(node.else_body) {
                resolve_module_stmt(node.else_body[si], module_exports, module_candidates, scope_modules, scope_locals, filename)
                si = si + 1
            }
        }
        return
    }
}

def resolve_module_nodes(ast: list, module_exports: dict, module_candidates: dict, imported_modules: dict, filename: string) -> list {
    scope_modules = imported_modules
    scope_locals = {}
    i = 0
    while i < len(ast) {
        node = ast[i]
        resolve_module_stmt(node, module_exports, module_candidates, scope_modules, scope_locals, filename)
        i = i + 1
    }
    return ast
}

def resolve_imports(ast: list, visited: list, target_arch: string, target_os: string, filename: string, module_exports: dict, module_candidates: dict, imported_modules: dict) -> list {
    expanded = []
    i = 0
    while i < len(ast) {
        node = ast[i]
        if node.kind == "Import" {
            module_name = node.val_str
            alias_name = node.val_str
            if node.name != 0 and len(node.name) > 0 {
                alias_name = node.name
            }
            orig_mod = node.val_str
            if module_name == "os_impl" {
                if target_os == "windows" {
                    module_name = "os_windows"
                } else {
                    module_name = "os_unix"
                }
            }
            imported_modules.set(alias_name, module_name)
            imported_modules.set(orig_mod, module_name)
            if contains(visited, module_name) == 0 {
                visited.append(module_name)
                found_path = ""
                # 1. Current working directory (./<module>.nv)
                fd = sys_open(module_name + ".nv", "r")
                if fd != 0 {
                    found_path = module_name + ".nv"
                }
                # 1b. Relative to importing source file
                if fd == 0 {
                    src_dir = source_dir(filename)
                    if len(src_dir) > 0 {
                        fd = sys_open(src_dir + module_name + ".nv", "r")
                        if fd != 0 {
                            found_path = src_dir + module_name + ".nv"
                        }
                    }
                }
                # 2. NOVA_PATH environment variable (search semicolon/colon separated paths)
                if fd == 0 {
                    nova_path = system.system_env_get("NOVA_PATH")
                    if len(nova_path) > 0 {
                        np_len = len(nova_path)
                        np_start = 0
                        np_i = 0
                        while np_i <= np_len and fd == 0 {
                            if np_i == np_len or nova_path[np_i] == ";" or (target_os != "windows" and nova_path[np_i] == ":") {
                                if np_i > np_start {
                                    dir_entry = str_sub(nova_path, np_start, np_i)
                                    fd = sys_open(dir_entry + "/" + module_name + ".nv", "r")
                                    if fd != 0 {
                                        found_path = dir_entry + "/" + module_name + ".nv"
                                    }
                                    if fd == 0 {
                                        fd = sys_open(dir_entry + "/stdlib/" + module_name + ".nv", "r")
                                        if fd != 0 {
                                            found_path = dir_entry + "/stdlib/" + module_name + ".nv"
                                        }
                                    }
                                    if fd == 0 {
                                        fd = sys_open(dir_entry + "/stdlib/backend/" + target_arch + "/" + module_name + ".nv", "r")
                                        if fd != 0 {
                                            found_path = dir_entry + "/stdlib/backend/" + target_arch + "/" + module_name + ".nv"
                                        }
                                    }
                                }
                                np_start = np_i + 1
                            }
                            np_i = np_i + 1
                        }
                    }
                }
                # 3. <exe_dir>/stdlib/<module>.nv and <exe_dir>/stdlib/backend/<target_arch>/<module>.nv
                if fd == 0 {
                    dir = exe_dir()
                    if len(dir) > 0 {
                        fd = sys_open(dir + "/stdlib/" + module_name + ".nv", "r")
                        if fd != 0 {
                            found_path = dir + "/stdlib/" + module_name + ".nv"
                        }
                        if fd == 0 {
                            fd = sys_open(dir + "/stdlib/backend/" + target_arch + "/" + module_name + ".nv", "r")
                            if fd != 0 {
                                found_path = dir + "/stdlib/backend/" + target_arch + "/" + module_name + ".nv"
                            }
                        }
                    }
                }
                # 4. Fallback to CWD ./stdlib/<module>.nv
                if fd == 0 {
                    fd = sys_open("stdlib/" + module_name + ".nv", "r")
                    if fd != 0 {
                        found_path = "stdlib/" + module_name + ".nv"
                    }
                }
                if fd == 0 {
                    fd = sys_open("stdlib/backend/" + target_arch + "/" + module_name + ".nv", "r")
                    if fd != 0 {
                        found_path = "stdlib/backend/" + target_arch + "/" + module_name + ".nv"
                    }
                }
                if fd == 0 {
                    errors.err("Import", filename, node.line, "could not resolve module '" + module_name + "'", "make sure '" + module_name + ".nv' exists in the current directory, stdlib/, or next to the nova executable", node.col)
                } else {
                    source = sys_read(fd)
                    sys_close(fd)
                    # Keep stdout clean when the front-end is embedded (language server): it
                    # owns stdout for JSON-RPC. Diagnostics travel through NOVA_DIAG_FILE.
                    if system.system_env_get("NOVA_DIAG_FILE") == "" {
                        print("Tokenizing... " + module_name)
                    }
                    tokens = tokenize(source)
                    imported_ast = parse(tokens, found_path)
                    namespace_module_ast(module_name, imported_ast, found_path)
                    collect_module_exports(module_name, imported_ast, module_exports, module_candidates)
                    resolved_ast = resolve_imports(imported_ast, visited, target_arch, target_os, found_path, module_exports, module_candidates, imported_modules)
                    j = 0
                    while j < len(resolved_ast) {
                        expanded.append(resolved_ast[j])
                        j = j + 1
                    }
                }
            }
        } else {
            expanded.append(node)
        }
        i = i + 1
    }
    return expanded
}

def cache_path(path: string) -> string {
    slash = 0
    i = 0
    while i < len(path) {
        if path[i] == "/" or path[i] == "\\" { slash = i }
        i = i + 1
    }
    if slash > 0 { return str_sub(path, 0, slash + 1) + ".nova_cache.txt" }
    return ".nova_cache.txt"
}

def load_cache(cache_file: string) -> list {
    if file_exists(cache_file) == 0 { return [] }
    fd = sys_open(cache_file, "r")
    content = sys_read(fd)
    sys_close(fd)
    lines = []
    start = 0
    i = 0
    while i < len(content) {
        if content[i] == "\n" {
            if i > start { lines.append(str_sub(content, start, i)) }
            start = i + 1
        }
        i = i + 1
    }
    if i > start { lines.append(str_sub(content, start, i)) }
    return lines
}

def save_cache(cache_file: string, lines: list) {
    fd = sys_open(cache_file, "w")
    i = 0
    while i < len(lines) {
        sys_write(fd, lines[i])
        sys_write(fd, "\n")
        i = i + 1
    }
    sys_close(fd)
}

def cache_key(cache_lines: list, path: string) -> string {
    prefix = path + "="
    sz = len(cache_lines)
    i = 0
    while i < sz {
        line = cache_lines[i]
        if str_sub(line, 0, len(prefix)) == prefix {
            return str_sub(line, len(prefix), len(line))
        }
        i = i + 1
    }
    return ""
}

# Rolling hash of a string (31 multiplier, modulo a prime that keeps every step inside 32 bits).
def text_fingerprint(s: string) -> int {
    h = 7
    i = 0
    n = len(s)
    while i < n {
        h = (h * 31 + char_code(s[i], 0)) % 2147483647
        i = i + 1
    }
    return h
}

# True when the source imports a module that lives next to it (its edits are not part of the stamp).
def imports_local_module(content: string, dir_prefix: string) -> int {
    n = len(content)
    i = 0
    while i < n {
        at_line_start = 0
        if i == 0 { at_line_start = 1 }
        elif content[i - 1] == "\n" { at_line_start = 1 }
        if at_line_start == 1 and i + 7 < n and str_sub(content, i, i + 7) == "import " {
            j = i + 7
            while j < n and content[j] == " " { j = j + 1 }
            k = j
            while k < n and content[k] != "\n" and content[k] != " " and content[k] != "\r" { k = k + 1 }
            name = str_sub(content, j, k)
            if len(name) > 0 and name[0] != "\"" {
                if file_exists(dir_prefix + name + ".nv") == 1 { return 1 }
            }
        }
        i = i + 1
    }
    return 0
}

# Cache stamp: source length, content hash and the running compiler's own size, so editing a file
# without changing its length, or rebuilding with a different compiler, never reuses a stale build.
# Returns "" (never cached) when the source imports a local module.
def build_stamp(path: string) -> string {
    fd = sys_open(path, "r")
    content = sys_read(fd)
    sys_close(fd)
    if imports_local_module(content, source_dir(path)) == 1 { return "" }
    args = system.get_args()
    compiler_id = file_size(args[0])
    return str(len(content)) + ":" + str(text_fingerprint(content)) + ":" + str(compiler_id)
}

# --- Constant inlining & AST folding pass ---
def inline_node_expr(node: AstNode, const_map: dict) -> AstNode {
    if node == 0 { return 0 }
    k = node.kind
    if k == "Variable" {
        if const_map.has(node.val_str) {
            val = const_map.get(node.val_str)
            num = AstNode()
            num.kind = "Number"
            num.val_int = val
            num.is_float = 0
            num.line = node.line
            num.col = node.col
            return num
        }
        return node
    }
    if k == "BinOp" {
        node.left = inline_node_expr(node.left, const_map)
        node.right = inline_node_expr(node.right, const_map)
        if node.left != 0 and node.right != 0 and node.left.kind == "Number" and node.right.kind == "Number" and node.left.is_float == 0 and node.right.is_float == 0 {
            op = node.val_str
            if op == "+" {
                node.left.val_int = node.left.val_int + node.right.val_int
                return node.left
            }
            if op == "-" {
                node.left.val_int = node.left.val_int - node.right.val_int
                return node.left
            }
            if op == "*" {
                node.left.val_int = node.left.val_int * node.right.val_int
                return node.left
            }
            if op == "/" and node.right.val_int != 0 {
                node.left.val_int = node.left.val_int / node.right.val_int
                return node.left
            }
            if op == "%" and node.right.val_int != 0 {
                node.left.val_int = node.left.val_int % node.right.val_int
                return node.left
            }
            if op == "<<" {
                node.left.val_int = node.left.val_int << node.right.val_int
                return node.left
            }
            if op == ">>" {
                node.left.val_int = node.left.val_int >> node.right.val_int
                return node.left
            }
            if op == "&" {
                node.left.val_int = node.left.val_int & node.right.val_int
                return node.left
            }
            if op == "|" {
                node.left.val_int = node.left.val_int | node.right.val_int
                return node.left
            }
            if op == "^" {
                node.left.val_int = node.left.val_int ^ node.right.val_int
                return node.left
            }
        }
        return node
    }
    if k == "UnaryOp" {
        node.left = inline_node_expr(node.left, const_map)
        if node.left != 0 and node.left.kind == "Number" and node.left.is_float == 0 and node.val_str == "-" {
            node.left.val_int = 0 - node.left.val_int
            return node.left
        }
        return node
    }
    if k == "Compare" {
        node.left = inline_node_expr(node.left, const_map)
        node.right = inline_node_expr(node.right, const_map)
        return node
    }
    if k == "Call" {
        if node.args != 0 {
            ai = 0
            while ai < len(node.args) {
                node.args[ai] = inline_node_expr(node.args[ai], const_map)
                ai = ai + 1
            }
        }
        return node
    }
    if k == "MethodCall" {
        node.left = inline_node_expr(node.left, const_map)
        if node.args != 0 {
            ai = 0
            while ai < len(node.args) {
                node.args[ai] = inline_node_expr(node.args[ai], const_map)
                ai = ai + 1
            }
        }
        return node
    }
    if k == "DataFieldAccess" {
        node.left = inline_node_expr(node.left, const_map)
        return node
    }
    if k == "ArrayIndex" {
        node.left = inline_node_expr(node.left, const_map)
        node.right = inline_node_expr(node.right, const_map)
        return node
    }
    if k == "Ternary" {
        node.cond = inline_node_expr(node.cond, const_map)
        node.left = inline_node_expr(node.left, const_map)
        node.right = inline_node_expr(node.right, const_map)
        return node
    }
    if k == "ListLiteral" {
        if node.args != 0 {
            ai = 0
            while ai < len(node.args) {
                node.args[ai] = inline_node_expr(node.args[ai], const_map)
                ai = ai + 1
            }
        }
        return node
    }
    return node
}

def inline_node_stmt(node: AstNode, const_map: dict) {
    if node == 0 { return }
    k = node.kind
    if k == "Assignment" {
        node.left = inline_node_expr(node.left, const_map)
        if node.val_int == 1 {
            if node.left != 0 and node.left.kind == "Number" and node.left.is_float == 0 {
                const_map.set(node.val_str, node.left.val_int)
            }
        }
        return
    }
    if k == "DataFieldAssign" {
        node.left = inline_node_expr(node.left, const_map)
        node.right = inline_node_expr(node.right, const_map)
        return
    }
    if k == "ArrayIndexAssign" {
        node.left = inline_node_expr(node.left, const_map)
        node.right = inline_node_expr(node.right, const_map)
        node.cond = inline_node_expr(node.cond, const_map)
        return
    }
    if k == "Return" {
        node.left = inline_node_expr(node.left, const_map)
        return
    }
    if k == "IfElse" {
        node.cond = inline_node_expr(node.cond, const_map)
        if node.body != 0 {
            si = 0
            while si < len(node.body) {
                inline_node_stmt(node.body[si], const_map)
                si = si + 1
            }
        }
        if node.else_body != 0 {
            si = 0
            while si < len(node.else_body) {
                inline_node_stmt(node.else_body[si], const_map)
                si = si + 1
            }
        }
        return
    }
    if k == "While" {
        node.cond = inline_node_expr(node.cond, const_map)
        if node.body != 0 {
            si = 0
            while si < len(node.body) {
                inline_node_stmt(node.body[si], const_map)
                si = si + 1
            }
        }
        return
    }
    if k == "ForLoop" {
        node.left = inline_node_expr(node.left, const_map)
        node.right = inline_node_expr(node.right, const_map)
        if node.body != 0 {
            si = 0
            while si < len(node.body) {
                inline_node_stmt(node.body[si], const_map)
                si = si + 1
            }
        }
        return
    }
    if k == "Function" {
        if node.body != 0 {
            si = 0
            while si < len(node.body) {
                inline_node_stmt(node.body[si], const_map)
                si = si + 1
            }
        }
        return
    }
    if k == "ClassDef" {
        if node.methods != 0 {
            mi = 0
            while mi < len(node.methods) {
                m = node.methods[mi]
                if m.body != 0 {
                    si = 0
                    while si < len(m.body) {
                        inline_node_stmt(m.body[si], const_map)
                        si = si + 1
                    }
                }
                mi = mi + 1
            }
        }
        return
    }
    if k == "Print" or k == "PrintD" {
        node.left = inline_node_expr(node.left, const_map)
        return
    }
    if k == "Call" or k == "MethodCall" {
        inline_node_expr(node, const_map)
        return
    }
}

def inline_constants_ast(ast: list) -> list {
    const_map = {}
    i = 0
    while i < len(ast) {
        inline_node_stmt(ast[i], const_map)
        i = i + 1
    }
    return ast
}

def compile_file(path: string, debug_mode: int, target_arch: string, target_os: string) -> list {
    # This self-hosted compiler has exactly one codegen backend statically compiled into it --
    # whichever of stdlib/backend/{x86_64,arm64}/codegen.nv `import codegen` resolved to at THIS
    # binary's own build time, never at this build invocation (see codegen_native_arch's
    # comment). Passing a `-arch` this binary can't actually emit used to silently fall through
    # to its one real backend and produce the wrong architecture's assembly while claiming
    # success. To cross-compile for a different architecture, build a nova.exe for that
    # architecture instead (e.g. via the Python-bootstrap compiler, which does pick its backend
    # dynamically per invocation).
    native_arch = codegen_native_arch()
    if target_arch != native_arch {
        print("ERROR: this compiler was built for " + native_arch + " and cannot emit " + target_arch + " code")
        print("  -> build a " + target_arch + "-targeting nova.exe instead (e.g. with the Python-bootstrap compiler's -arch flag), or drop -arch " + target_arch + " to use this compiler's native " + native_arch + " backend")
        sys_exit(1)
    }

    cache_file = cache_path(path)
    cached_lines = load_cache(cache_file)
    current_stamp = build_stamp(path)
    cached_size_str = cache_key(cached_lines, path)
    cached_size = 0
    if cached_size_str != "" {
        if len(current_stamp) > 0 and cached_size_str == current_stamp {
            print("[cached] " + path + " is up to date" + "\n")
            ext = ""
            if target_os == "windows" {
                ext = ".exe"
            } else {
                ext = ""
            }
            out_path = str_sub(path, 0, len(path) - 3) + ext
            if file_exists(out_path) == 1 {
                return []
            }
        }
    }
    
    reset_errors()

    fd = sys_open(path, "r")
    source = sys_read(fd)
    sys_close(fd)

    print("[1/5] Tokenizing " + path)
    tokens = tokenize(source)
    print("[1/5] done: " + str(len(tokens)) + " tokens")

    print("[2/5] Parsing " + path)
    ast = parse(tokens, path)
    print("[2/5] done: " + str(len(ast)) + " top-level nodes")

    print("[3/5] Resolving imports")
    visited = []
    module_exports = {}
    module_candidates = {}
    imported_modules = {}
    ast = resolve_imports(ast, visited, target_arch, target_os, path, module_exports, module_candidates, imported_modules)
    ast = resolve_module_nodes(ast, module_exports, module_candidates, imported_modules, path)
    ast = inline_constants_ast(ast)
    print("[3/5] done: " + str(len(ast)) + " nodes after imports")

    if had_errors() == 1 {
        print("Build failed: syntax or import errors reported above")
        sys_exit(1)
    }

    infer_return_types(ast)
    print("[4/5] Type checking")
    tc = TypeChecker()
    tc_init(tc)
    tc.filename = path
    tc_check(tc, ast)
    print("[4/5] done")

    if had_errors() == 1 {
        print("Build failed: type errors reported above")
        sys_exit(1)
    }

    print("[5/5] Codegen")
    is_x64 = 0
    if target_arch == "x86_64" { is_x64 = 1 }
    asm = generate_assembly(ast, debug_mode, is_x64, target_os)
    print("[5/5] done: " + str(len(asm)) + " asm lines")

    # Update build cache
    new_cached_lines = cached_lines
    tmp_str = path + "="
    tmp_sz = current_stamp
    new_entry = tmp_str + tmp_sz
    found = 0
    i = 0
    while i < len(new_cached_lines) {
        line = new_cached_lines[i]
        prefix = path + "="
        if str_sub(line, 0, len(prefix)) == prefix {
            new_cached_lines[i] = new_entry
            found = 1
        }
        i = i + 1
    }
    if found == 0 { new_cached_lines.append(new_entry) }
    save_cache(cache_file, new_cached_lines)

    return asm
}

# Front-end-only entry points, shared by `check`, editor tooling, and the language
# server. They never codegen, link, touch the build cache, or exit the process, so
# they are safe to call repeatedly inside a long-running binary. Diagnostics are
# produced through errors.nv (and to NOVA_DIAG_FILE when that is set).
def check_syntax_source(source: string, filename: string) -> int {
    reset_errors()
    tokens = tokenize(source)
    ast = parse(tokens, filename)
    if had_errors() == 1 { return 1 }
    return 0
}

def check_source(source: string, filename: string, target_arch: string, target_os: string) -> int {
    reset_errors()
    tokens = tokenize(source)
    ast = parse(tokens, filename)
    visited = []
    module_exports = {}
    module_candidates = {}
    imported_modules = {}
    ast = resolve_imports(ast, visited, target_arch, target_os, filename, module_exports, module_candidates, imported_modules)
    ast = resolve_module_nodes(ast, module_exports, module_candidates, imported_modules, filename)
    ast = inline_constants_ast(ast)
    if had_errors() == 1 { return 1 }
    infer_return_types(ast)
    tc = TypeChecker()
    tc_init(tc)
    tc.filename = filename
    tc_check(tc, ast)
    if had_errors() == 1 { return 1 }
    return 0
}

def check_file(path: string, target_arch: string, target_os: string) -> int {
    fd = sys_open(path, "r")
    if fd == 0 {
        errors.err("IO", path, 0, "cannot open file", "check that the path exists and is readable", 0)
        return 1
    }
    source = sys_read(fd)
    sys_close(fd)
    return check_source(source, path, target_arch, target_os)
}

def to_win_path(p: string) -> string {
    out = ""
    i = 0
    while i < len(p) {
        ch = p[i]
        if ch == "/" { out = out + "\\" } else { out = out + ch }
        i = i + 1
    }
    return out
}

def _quote(s: string) -> string {
    return "\"" + s + "\""
}

def _rstrip(s: string) -> string {
    e = len(s)
    while e > 0 {
        ch = str_sub(s, e - 1, e)
        if ch == " " or ch == "\t" or ch == "\r" or ch == "\n" { e = e - 1 } else { break }
    }
    return str_sub(s, 0, e)
}

def _str_has(hay: string, needle: string) -> int {
    hlen = len(hay)
    nlen = len(needle)
    if nlen == 0 { return 1 }
    if nlen > hlen { return 0 }
    i = 0
    while i + nlen <= hlen {
        if str_sub(hay, i, i + nlen) == needle { return 1 }
        i = i + 1
    }
    return 0
}

def _gcc_is_64bit(gcc_cmd: string) -> int {
    probe = ".nova_gcc_machine.txt"
    system.system_exec(gcc_cmd + " -dumpmachine > " + probe + " 2>&1")
    if file_exists(probe) == 0 { return 0 }
    lines = read_lines(probe)
    if len(lines) == 0 { return 0 }
    return _str_has(lines[0], "64")
}

def _probe_bundled_via_env() -> string {
    host = sys_platform()
    if host == "windows" {
        system.system_exec("cmd /c (echo %LOCALAPPDATA%)>.nova_env_root.txt 2>&1")
        if file_exists(".nova_env_root.txt") == 0 { return "" }
        lines = read_lines(".nova_env_root.txt")
        if len(lines) == 0 { return "" }
        root = _rstrip(lines[0])
        if len(root) == 0 { return "" }
        if root == "%LOCALAPPDATA%" { return "" }
        cand = root + "\\nova\\gcc\\bin\\gcc.exe"
        if file_exists(cand) == 1 {
            if _gcc_is_64bit(_quote(cand)) == 1 { return cand }
        }
    } else {
        system.system_exec("echo $HOME>.nova_env_root.txt 2>/dev/null")
        if file_exists(".nova_env_root.txt") == 0 { return "" }
        lines = read_lines(".nova_env_root.txt")
        if len(lines) == 0 { return "" }
        root = _rstrip(lines[0])
        if len(root) == 0 { return "" }
        cand = root + "/.nova/gcc/bin/gcc"
        if file_exists(cand) == 1 {
            if _gcc_is_64bit(cand) == 1 { return cand }
        }
    }
    return ""
}

def _find_on_path() -> string {
    host = sys_platform()
    list_file = ".nova_gcc_list.txt"
    if host == "windows" {
        system.system_exec("where gcc > " + list_file + " 2>&1")
    } else {
        system.system_exec("which -a gcc > " + list_file + " 2>/dev/null || which gcc > " + list_file + " 2>/dev/null")
    }
    if file_exists(list_file) == 0 { return "" }
    cands = read_lines(list_file)
    i = 0
    while i < len(cands) {
        cand = _rstrip(cands[i])
        if len(cand) > 0 {
            q = cand
            if host == "windows" { q = _quote(to_win_path(cand)) }
            if _gcc_is_64bit(q) == 1 { return cand }
        }
        i = i + 1
    }
    return ""
}

def _find_gcc(target_os: string, target_arch: string, compiler_dir: string) -> string {
    host = sys_platform()
    # On macOS native, prefer clang
    if host == "macos" and target_os == "macos" {
        if file_exists("clang") == 1 or file_exists("/usr/bin/clang") == 1 {
            return "clang"
        }
    }
    gcc_bin = "gcc.exe"
    if host != "windows" { gcc_bin = "gcc" }
    # Bundled GCC next to compiler_dir (repo checkout with gcc/ subdir)
    bundled = compiler_dir + "/gcc/bin/" + gcc_bin
    if file_exists(bundled) == 1 {
        q = bundled
        if host == "windows" { q = _quote(to_win_path(bundled)) }
        if _gcc_is_64bit(q) == 1 { return q }
    }
    # Bundled GCC co-located with this nova.exe (installed layout)
    args = system.get_args()
    if len(args) > 0 {
        exe_path = args[0]
        last = -1
        k = 0
        while k < len(exe_path) {
            ch = exe_path[k]
            if ch == "/" or ch == "\\" { last = k }
            k = k + 1
        }
        if last > 0 {
            exe_dir = str_sub(exe_path, 0, last)
            bundled2 = exe_dir + "/gcc/bin/" + gcc_bin
            if file_exists(bundled2) == 1 {
                q2 = bundled2
                if host == "windows" { q2 = _quote(to_win_path(bundled2)) }
                if _gcc_is_64bit(q2) == 1 { return q2 }
            }
        }
    }
    # Bundled GCC via install root from shell env (%LOCALAPPDATA% / $HOME)
    env_hit = _probe_bundled_via_env()
    if len(env_hit) > 0 {
        if host == "windows" { return _quote(to_win_path(env_hit)) }
        return env_hit
    }
    # Cross-compilation: look for target-specific cross-toolchain
    if host != target_os {
        cross_key = target_os + "_" + target_arch
        if cross_key == "linux_x86_64" { return "x86_64-linux-gnu-gcc" }
        if cross_key == "linux_arm64" { return "aarch64-linux-gnu-gcc" }
        if cross_key == "windows_x86_64" { return "x86_64-w64-mingw32-gcc" }
        if cross_key == "windows_arm64" { return "aarch64-w64-mingw32-gcc" }
        if cross_key == "macos_x86_64" { return "x86_64-apple-darwin-gcc" }
        if cross_key == "macos_arm64" { return "aarch64-apple-darwin-gcc" }
    }
    # Enumerate gccs on PATH, first 64-bit wins (rejects 32-bit MinGW)
    onpath = _find_on_path()
    if len(onpath) > 0 {
        if host == "windows" { return _quote(to_win_path(onpath)) }
        return onpath
    }
    return ""
}

def _verify_output(output_path: string) {
    if file_exists(output_path) == 0 {
        print("ERROR: build failed; output not produced: " + output_path)
        print("  A 32-bit gcc cannot assemble 64-bit Nova output; install 64-bit GCC")
        print("  Windows: re-run install.ps1 to bundle MinGW, macOS: xcode-select --install, Linux: sudo apt install build-essential")
        sys_exit(1)
    }
    if file_size(output_path) == 0 {
        print("ERROR: build failed; output is empty: " + output_path)
        sys_exit(1)
    }
}

def _runtime_stamp(path: string) -> string {
    if file_exists(path) == 0 { return "" }
    fd = sys_open(path, "r")
    content = sys_read(fd)
    sys_close(fd)
    return str(len(content)) + ":" + str(text_fingerprint(content))
}

def _compile_runtime(gcc_name: string, target_os: string, target_arch: string, compiler_dir: string) {
    runtime_c_path = compiler_dir + "/runtime.c"
    runtime_o_path = compiler_dir + "/runtime.o"
    stamp_path = compiler_dir + "/runtime.stamp"
    if file_exists(runtime_c_path) == 0 { return }

    current_stamp = _runtime_stamp(runtime_c_path)
    if file_exists(runtime_o_path) == 1 and file_exists(stamp_path) == 1 {
        fd_s = sys_open(stamp_path, "r")
        saved_stamp = sys_read(fd_s)
        sys_close(fd_s)
        if saved_stamp == current_stamp {
            return
        }
    }

    if len(gcc_name) == 0 {
        print("ERROR: no 64-bit C compiler found; cannot build runtime.o")
        print("  Windows: re-run install.ps1 to bundle MinGW, macOS: xcode-select --install, Linux: sudo apt install build-essential")
        sys_exit(1)
    }
    # Remove stale runtime.o (cmd's del treats / as a switch, so use backslashes)
    if file_exists(runtime_o_path) == 1 {
        if target_os == "windows" { sys_system("cmd /c del /f /q " + _quote(to_win_path(runtime_o_path))) }
        else { sys_system("rm -f " + runtime_o_path) }
    }
    # to_win_path only makes sense when THIS compile is actually running on Windows (it
    # rewrites "/" to "\"); applying it unconditionally broke every non-Windows host,
    # including the self-hosted ARM64 backend running under QEMU on Linux, confirmed
    # directly: it searched for a file literally named ".\runtime.c" (backslash is not a
    # path separator on Linux, so that's a single bogus filename) and failed every time.
    if target_os == "windows" {
        rc_arg = _quote(to_win_path(runtime_c_path))
        ro_arg = _quote(to_win_path(runtime_o_path))
    } else {
        rc_arg = _quote(runtime_c_path)
        ro_arg = _quote(runtime_o_path)
    }
    cmd = gcc_name + " -Os -ffunction-sections -fdata-sections -c " + rc_arg + " -o " + ro_arg
    if target_os == "macos" {
        cmd = cmd + " -D MACOS"
        if target_arch == "arm64" { cmd = cmd + " -arch arm64" }
    } elif target_os == "linux" {
        cmd = cmd + " -D LINUX_WRAP"
    } elif target_os == "windows" {
        cmd = cmd + " -mno-red-zone"
    }
    print("Compiling runtime.c: " + cmd)
    system.system_exec(cmd)
    _verify_output(runtime_o_path)
    fd_w = sys_open(stamp_path, "w")
    sys_write(fd_w, current_stamp)
    sys_close(fd_w)
}

def compile_to_file(input_path: string, output_path: string, debug_mode: int, target_arch: string, target_os: string) {
    asm = compile_file(input_path, debug_mode, target_arch, target_os)
    if len(asm) == 0 { return }
    write_lines(asm, output_path)
    print("Compiled: " + input_path + " -> " + output_path)
}

def write_lines(lines: list, path: string) {
    fd = sys_open(path, "wb")
    i = 0
    n = len(lines)
    while i < n {
        sys_write(fd, lines[i] + "\n")
        i = i + 1
    }
    sys_close(fd)
}

def read_lines(path: string) -> list {
    fd = sys_open(path, "r")
    if fd == 0 {
        print("ERROR: Could not open file: " + path)
        return []
    }
    content = sys_read(fd)
    sys_close(fd)
    result = []
    start = 0
    i = 0
    content_len = len(content)
    while i < content_len {
        if content[i] == "\n" or content[i] == "\r" {
            if i > start {
                result.append(str_sub(content, start, i))
            }
            if content[i] == "\r" and i + 1 < content_len and content[i + 1] == "\n" {
                i = i + 1
            }
            start = i + 1
        }
        i = i + 1
    }
    if i > start {
        result.append(str_sub(content, start, i))
    }
    return result
}

def get_compiler_dir() -> string {
    # runtime.c/runtime.o (and a bundled gcc/) live next to the nova executable in an installed
    # layout. Prefer that so `nova build` works from any cwd; fall back to "." (repo checkout
    # layout, or the file genuinely missing -- _find_gcc/_compile_runtime already report that).
    dir = exe_dir()
    if len(dir) > 0 {
        if file_exists(dir + "/runtime.c") == 1 { return dir }
    }
    nova_path = system.system_env_get("NOVA_PATH")
    if len(nova_path) > 0 {
        if file_exists(nova_path + "/runtime.c") == 1 { return nova_path }
    }
    return "."
}

def compile_to_exe(input_path: string, output_path: string, debug_mode: int, target_arch: string, target_os: string) {
    asm = compile_file(input_path, debug_mode, target_arch, target_os)
    if len(asm) == 0 { return }
    write_lines(asm, input_path + ".s")
    if target_os == "bare" {
        print("Generated bare-metal assembly: " + input_path + ".s")
        return
    }
    
    compiler_dir = get_compiler_dir()
    gcc_name = _find_gcc(target_os, target_arch, compiler_dir)
    _compile_runtime(gcc_name, target_os, target_arch, compiler_dir)
    runtime_o_path = compiler_dir + "/runtime.o"
    
    is_windows = 0
    if target_os == "windows" { is_windows = 1 }
    is_macos = 0
    if target_os == "macos" { is_macos = 1 }
    is_linux = 0
    if target_os == "linux" { is_linux = 1 }
    
    if is_windows == 1 and target_arch == "x86_64" {
        print("Using GCC to assemble and link...")
        system.system_exec(gcc_name + " -O3 " + _quote(to_win_path(input_path + ".s")) + " " + _quote(to_win_path(runtime_o_path)) + " -o " + _quote(to_win_path(output_path)) + " -mconsole -Wl,--gc-sections -Wl,--stack,16777216 -lkernel32 -lgdi32 -luser32")
        _verify_output(output_path)
    } elif is_windows == 1 {
        print("Assembling...")
        assembled = assemble(asm)
        print("Linking...")
        exe_bytes = link(assembled)
        fd = sys_open(output_path, "wb")
        sys_write_raw(fd, exe_bytes)
        sys_close(fd)
        _verify_output(output_path)
    } else {
        print("Using GCC to assemble and link...")
        gcc_cmd = gcc_name + " -O3 " + _quote(input_path + ".s") + " -o " + _quote(output_path) + " " + _quote(runtime_o_path)
        if is_macos == 1 {
            if target_arch == "arm64" { gcc_cmd = gcc_cmd + " -arch arm64" }
            gcc_cmd = gcc_cmd + " -Wl,-no_compact_unwind"
        } elif is_linux == 1 {
            gcc_cmd = gcc_cmd + " -no-pie"
        }
        system.system_exec(gcc_cmd)
        _verify_output(output_path)
    }
    print("Compiled: " + input_path + " -> " + output_path)
}

def compile_to_bare(input_path: string, output_path: string, debug_mode: int, load_addr: int, entry_name: string, target_arch: string, target_os: string) {
    asm = compile_file(input_path, debug_mode, target_arch, target_os)
    if len(asm) == 0 { return }
    write_lines(asm, input_path + ".s")
    
    print("Assembling...")
    assembled = assemble(asm)
    print("Linking bare-metal...")
    bare_bytes = link_bare(assembled, load_addr, entry_name)
    fd2 = sys_open(output_path, "wb")
    sys_write_raw(fd2, bare_bytes)
    sys_close(fd2)
    print("Compiled: " + input_path + " -> " + output_path)
}

def assemble_bare_file(asm_path: string, output_path: string, load_addr: int) {
    asm_lines = read_lines(asm_path)
    if len(asm_lines) == 0 { return }
    
    assembled = assemble(asm_lines)
    print("Linking bare-metal...")
    bare_bytes = link_bare(assembled, load_addr, "")
    fd2 = sys_open(output_path, "wb")
    sys_write_raw(fd2, bare_bytes)
    sys_close(fd2)
    print("Generated: " + output_path)
}

def assemble_link_file(asm_path: string, output_path: string) {
    asm_lines = read_lines(asm_path)
    if len(asm_lines) == 0 { return }
    
    assembled = assemble(asm_lines)
    print("Linking...")
    exe_bytes = link(assembled)
    fd2 = sys_open(output_path, "wb")
    sys_write_raw(fd2, exe_bytes)
    sys_close(fd2)
    print("Generated: " + output_path)
}

def compileToExe(input_path: string, output_path: string, debug_mode: int, target_arch: string, target_os: string) {
    compile_to_exe(input_path, output_path, debug_mode, target_arch, target_os)
}

def compileToBare(input_path: string, output_path: string, debug_mode: int, load_addr: int, entry_name: string, target_arch: string, target_os: string) {
    compile_to_bare(input_path, output_path, debug_mode, load_addr, entry_name, target_arch, target_os)
}

def assembleBareFile(asm_path: string, output_path: string, load_addr: int) {
    assemble_bare_file(asm_path, output_path, load_addr)
}

def assembleLinkFile(asm_path: string, output_path: string) {
    assemble_link_file(asm_path, output_path)
}

def getCompilerDir() -> string {
    return get_compiler_dir()
}

def writeLines(lines: list, path: string) {
    write_lines(lines, path)
}

def readLines(path: string) -> list {
    return read_lines(path)
}

def compileFile(path: string, debug_mode: int, target_arch: string, target_os: string) -> list {
    return compile_file(path, debug_mode, target_arch, target_os)
}

def checkSyntaxSource(source: string, filename: string) -> int {
    return check_syntax_source(source, filename)
}

def checkSource(source: string, filename: string, target_arch: string, target_os: string) -> int {
    return check_source(source, filename, target_arch, target_os)
}

def checkFile(path: string, target_arch: string, target_os: string) -> int {
    return check_file(path, target_arch, target_os)
}

def namespaceModuleAst(module_name: string, ast: list, found_path: string) {
    namespace_module_ast(module_name, ast, found_path)
}

def collectModuleExports(module_name: string, ast: list, module_exports: dict, module_candidates: dict) {
    collect_module_exports(module_name, ast, module_exports, module_candidates)
}

def resolveImports(ast: list, visited: list, target_arch: string, target_os: string, filename: string, module_exports: dict, module_candidates: dict, imported_modules: dict) -> list {
    return resolve_imports(ast, visited, target_arch, target_os, filename, module_exports, module_candidates, imported_modules)
}
