# ============================================================
# Code Generator: Statement Compilation (ARM64/A64)
# ============================================================

def defer_is_stmt_kind(k: string) -> int {
    if k == "Assignment" { return 1 }
    if k == "DataFieldAssign" { return 1 }
    if k == "PointerAssign" { return 1 }
    if k == "ArrayIndexAssign" { return 1 }
    if k == "PrintD" { return 1 }
    if k == "Print" { return 1 }
    if k == "Return" { return 1 }
    if k == "IfElse" { return 1 }
    if k == "While" { return 1 }
    if k == "ForLoop" { return 1 }
    if k == "ForIn" { return 1 }
    if k == "Break" { return 1 }
    if k == "Continue" { return 1 }
    if k == "RawBlock" { return 1 }
    if k == "TRY" { return 1 }
    if k == "THROW" { return 1 }
    if k == "Call" { return 1 }
    if k == "MethodCall" { return 1 }
    if k == "Block" { return 1 }
    if k == "Defer" { return 1 }
    return 0
}

def defer_emit_one(state: CodegenState, node: AstNode, debug_mode: int) {
    if node == 0 { return }
    if node.body != 0 and len(node.body) > 0 {
        i = 0
        while i < len(node.body) {
            compile_stmt(state, node.body[i], debug_mode)
            i = i + 1
        }
        return
    }
    if node.left != 0 {
        if node.left.kind != 0 and defer_is_stmt_kind(node.left.kind) == 1 {
            compile_stmt(state, node.left, debug_mode)
        } else {
            compile_expr(state, node.left)
            clean_n(state, 1)
        }
    }
}

def defer_push_scope(state: CodegenState) {
    state.defer_marks.append(len(state.defer_nodes))
}

def defer_end_scope(state: CodegenState, debug_mode: int) {
    if len(state.defer_marks) == 0 { return }
    mark = state.defer_marks[len(state.defer_marks) - 1]
    state.defer_marks.pop()
    while len(state.defer_nodes) > mark {
        n = state.defer_nodes[len(state.defer_nodes) - 1]
        state.defer_nodes.pop()
        defer_emit_one(state, n, debug_mode)
    }
}

def defer_emit_down_to(state: CodegenState, h: int, debug_mode: int) {
    idx = len(state.defer_nodes) - 1
    while idx >= h {
        defer_emit_one(state, state.defer_nodes[idx], debug_mode)
        idx = idx - 1
    }
}

def defer_loop_mark(state: CodegenState) -> int {
    if len(state.defer_loop_marks) == 0 { return 0 }
    return state.defer_loop_marks[len(state.defer_loop_marks) - 1]
}

def compile_stmt(state: CodegenState, node: AstNode, debug_mode: int) {
    if node.kind == "Assignment" {
        if node.left != 0 and node.left.kind == "Alloc" {
            sz = node.left.val_int
            if sz == 0 { sz = 1 }
            state.ptr_vars.set(node.val_str, sz)
        } elif node.left != 0 and node.left.kind == "Variable" {
            if state.ptr_vars.has(node.left.val_str) == 1 {
                state.ptr_vars.set(node.val_str, state.ptr_vars.get(node.left.val_str))
            } else {
                state.ptr_vars.remove(node.val_str)
            }
        } else {
            state.ptr_vars.remove(node.val_str)
        }
        is_str_val = 0
        if is_string_expr(state, node.left) == 1 {
            is_str_val = 1
        }
        if node.left.kind == "ArrayIndex" {
            is_str_val = 1
        }
        if is_str_val == 1 {
            if state.string_var_map.has(node.val_str) == 0 {
                state.string_vars.append(node.val_str)
                state.string_var_map.set(node.val_str, 1)
            }
        }
        compile_expr(state, node.left)
        emit(state, "    ldr %a, [sp], #16")
        offset = find_var_offset(state, node.val_str)
        emit_fp_store(state, "x0", offset)
    }
    if node.kind == "DataFieldAssign" {
        compile_expr(state, node.right)
        compile_expr(state, node.left)
        emit(state, "    ldr %d, [sp], #16")
        emit(state, "    ldr %a, [sp], #16")
        struct_name = ""
        if node.left.inferred_type != 0 and node.left.inferred_type.kind == "struct" {
            struct_name = node.left.inferred_type.name
        }
        prop_off = get_prop_offset(state, struct_name, node.val_str)
        emit(state, "    str %a, [%d, #" + str(prop_off) + "]")
    }
    if node.kind == "PointerAssign" {
        compile_expr(state, node.right)
        compile_expr(state, node.left)
        emit(state, "    ldr %d, [sp], #16")
        emit(state, "    ldr %a, [sp], #16")
        if node.val_str == "value_byte" {
            emit(state, "    strb x0, [%d]")
        } else {
            if node.val_str == "value_word" {
                emit(state, "    strh x0, [%d]")
            } else {
                if node.val_str == "value_dword" or node.val_str == "value" {
                    emit(state, "    str %a, [%d]")
                }
            }
        }
    }
    if node.kind == "ArrayIndexAssign" {
        compile_expr(state, node.cond)
        compile_expr(state, node.right)
        compile_expr(state, node.left)
        emit(state, "    ldr %d, [sp], #16")
        emit(state, "    ldr %c, [sp], #16")
        emit(state, "    ldr %a, [sp], #16")
        is_dict = 0
        if node.left.inferred_type != 0 and node.left.inferred_type.kind == "dict" {
            is_dict = 1
        }
        if is_dict == 1 {
            emit(state, "    str %a, [sp, #-16]!")
            emit(state, "    str %c, [sp, #-16]!")
            emit(state, "    str %d, [sp, #-16]!")
            emit_call(state, "_dict_set", 3)
        } elif node.left != 0 and node.left.kind == "Variable" and state.ptr_vars.has(node.left.val_str) == 1 {
            raw_sz = state.ptr_vars.get(node.left.val_str)
            if raw_sz == 1 {
                emit(state, "    strb w0, [%d, %c]")
            } else {
                emit(state, "    str %a, [%d, %c, lsl #3]")
            }
            return
        } else {
            emit(state, "    adrp %x, _oob_line@PAGE")
            emit(state, "    add %x, %x, _oob_line@PAGEOFF")
            emit(state, "    mov %i, #" + str(node.line))
            emit(state, "    str %i, [%x]")
            oob_lbl = next_label(state, "L_oob")
            after_lbl = next_label(state, "L_after_oob")
            emit(state, "    cmp %c, #0")
            emit(state, "    b.lt " + oob_lbl)
            emit(state, "    ldr w1, [%d]")
            emit(state, "    cmp %c, x1")
            emit(state, "    b.ge " + oob_lbl)
            ptr_sz = ptr_size(state)
            emit(state, "    ldr %x, [%d, #8]")
            if ptr_sz == 8 {
                emit(state, "    str %a, [%x, %c, lsl #3]")
            } else {
                emit(state, "    str x0, [%x, %c, lsl #2]")
            }
            emit(state, "    b " + after_lbl)
            emit(state, oob_lbl + ":")
            emit(state, "    b _out_of_bounds")
            emit(state, after_lbl + ":")
        }
    }
    if node.kind == "PrintD" {
        if debug_mode == 1 {
            push_data_label(state, "debug_prefix")
            emit_call(state, "L_write_stdout", 1)
            emit(state, "    mov %a, " + str(node.line))
            emit(state, "    str %a, [sp, #-16]!")
            emit_call(state, "L_write_int", 1)
            push_data_label(state, "debug_suffix")
            emit_call(state, "L_write_stdout", 1)
            compile_expr(state, node.left)
            if is_string_expr(state, node.left) == 1 {
                push_data_label(state, "fmt_str")
                emit_call(state, "_printf", 2)
            } else {
                if is_float_expr(state, node.left) == 1 {
                    push_data_label(state, "fmt_float_pure")
                } else {
                    push_data_label(state, "fmt_int_pure")
                }
                emit_call(state, "_printf", 2)
            }
            emit(state, "    mov %a, 10")
            emit(state, "    str %a, [sp, #-16]!")
            emit_call(state, "_fputc", 1)
            emit(state, "    str xzr, [sp, #-16]!")
            emit_call(state, "_fflush", 1)
        }
    }
    if node.kind == "Print" {
        compile_expr(state, node.left)
        if is_string_expr(state, node.left) == 1 {
            push_data_label(state, "fmt_str")
        } else {
            if is_float_expr(state, node.left) == 1 {
                push_data_label(state, "fmt_float")
            } else {
                push_data_label(state, "fmt_int")
            }
        }
        emit_call(state, "_printf", 2)
        emit(state, "    str xzr, [sp, #-16]!")
        emit_call(state, "_fflush", 1)
    }
    if node.kind == "Return" {
        compile_expr(state, node.left)
        emit(state, "    ldr %a, [sp], #16")
        emit(state, "    str %a, [sp, #-16]!")
        defer_emit_down_to(state, 0, debug_mode)
        emit(state, "    ldr %a, [sp], #16")
        r = len(state.used_regs) - 1
        while r >= 0 {
            emit(state, "    ldr " + state.used_regs[r] + ", [sp], #16")
            r = r - 1
        }
        if state.local_offset > 0 {
            emit(state, "    add sp, sp, #" + str(state.local_offset))
        }
        emit(state, "    ldp fp, lr, [sp], #16")
        emit(state, "    ret")
    }
    if node.kind == "IfElse" {
        else_label = "L_else_" + str(state.label_count)
        state.label_count = state.label_count + 1
        end_label = "L_end_" + str(state.label_count)
        state.label_count = state.label_count + 1
        
        compile_expr(state, node.cond)
        emit(state, "    ldr %a, [sp], #16")
        emit(state, "    cmp %a, #0")
        emit(state, "    b.eq " + else_label)
        
        defer_push_scope(state)
        i = 0
        while i < len(node.body) {
            compile_stmt(state, node.body[i], debug_mode)
            i = i + 1
        }
        defer_end_scope(state, debug_mode)
        emit(state, "    b " + end_label)
        
        emit(state, else_label + ":")
        defer_push_scope(state)
        i = 0
        while i < len(node.else_body) {
            compile_stmt(state, node.else_body[i], debug_mode)
            i = i + 1
        }
        defer_end_scope(state, debug_mode)
        
        emit(state, end_label + ":")
    }
    if node.kind == "While" {
        start_label = next_label(state, "L_loop")
        end_label = next_label(state, "L_loop_end")
        state.loop_start_labels.append(start_label)
        state.loop_end_labels.append(end_label)

        emit(state, start_label + ":")
        compile_expr(state, node.cond)
        emit(state, "    ldr %a, [sp], #16")
        emit(state, "    cmp %a, #0")
        emit(state, "    b.eq " + end_label)

        defer_push_scope(state)
        state.defer_loop_marks.append(len(state.defer_nodes))
        i = 0
        while i < len(node.body) {
            compile_stmt(state, node.body[i], debug_mode)
            i = i + 1
        }
        defer_end_scope(state, debug_mode)
        state.defer_loop_marks.pop()

        emit(state, "    b " + start_label)
        emit(state, end_label + ":")
        state.loop_start_labels.pop()
        state.loop_end_labels.pop()
    }
    if node.kind == "ForLoop" {
        state.ptr_vars.remove(node.val_str)
        compile_expr(state, node.left)
        emit(state, "    ldr %a, [sp], #16")
        offset = find_var_offset(state, node.val_str)
        emit_fp_store(state, "x0", offset)

        loop_label = next_label(state, "L_for")
        end_label = next_label(state, "L_for_end")
        cont_label = next_label(state, "L_for_cont")
        state.loop_start_labels.append(cont_label)
        state.loop_end_labels.append(end_label)

        emit(state, loop_label + ":")
        compile_expr(state, node.right)
        emit(state, "    ldr %x, [sp], #16")
        emit_fp_load(state, "x0", offset)
        emit(state, "    cmp %a, %x")
        if node.val_int == 1 {
            emit(state, "    b.lt " + end_label)
        } else {
            emit(state, "    b.gt " + end_label)
        }

        defer_push_scope(state)
        state.defer_loop_marks.append(len(state.defer_nodes))
        i = 0
        while i < len(node.body) {
            compile_stmt(state, node.body[i], debug_mode)
            i = i + 1
        }
        defer_end_scope(state, debug_mode)
        state.defer_loop_marks.pop()

        emit(state, cont_label + ":")
        compile_expr(state, node.cond)
        emit(state, "    ldr %x, [sp], #16")
        emit_fp_load(state, "x0", offset)
        if node.val_int == 1 {
            emit(state, "    sub %a, %x")
        } else {
            emit(state, "    add %a, %x")
        }
        emit_fp_store(state, "x0", offset)

        emit(state, "    b " + loop_label)
        emit(state, end_label + ":")
        state.loop_start_labels.pop()
        state.loop_end_labels.pop()
    }
    if node.kind == "ForIn" {
        state.ptr_vars.remove(node.val_str)
        compile_expr(state, node.left)
        
        ptr_sz = ptr_size(state)
        emit(state, "    sub sp, sp, #8")
        emit(state, "    str wzr, [sp]")
        
        loop_label = next_label(state, "L_forin")
        end_label = next_label(state, "L_forin_end")
        state.loop_start_labels.append(loop_label)
        state.loop_end_labels.append(end_label)
        
        emit(state, loop_label + ":")
        emit(state, "    ldr %d, [sp, #8]")
        emit(state, "    ldr w0, [%d]")
        emit(state, "    ldr x1, [sp]")
        emit(state, "    cmp x1, x0")
        emit(state, "    b.ge " + end_label)
        
        emit(state, "    ldr x0, [sp]")
        emit(state, "    ldr %x, [%d, #8]")
        if ptr_sz == 8 {
            emit(state, "    ldr %a, [%x, x0, lsl #3]")
        } else {
            emit(state, "    ldr %a, [%x, x0, lsl #2]")
        }
        
        var_off = find_var_offset(state, node.val_str)
        emit_fp_store(state, "x0", var_off)
        
        defer_push_scope(state)
        state.defer_loop_marks.append(len(state.defer_nodes))
        i = 0
        while i < len(node.body) {
            compile_stmt(state, node.body[i], debug_mode)
            i = i + 1
        }
        defer_end_scope(state, debug_mode)
        state.defer_loop_marks.pop()
        
        emit(state, "    ldr x0, [sp]")
        emit(state, "    add x0, x0, #1")
        emit(state, "    str x0, [sp]")
        emit(state, "    b " + loop_label)
        emit(state, end_label + ":")
        clean_n(state, 1)
        state.loop_start_labels.pop()
        state.loop_end_labels.pop()
    }
    if node.kind == "Break" {
        if len(state.loop_end_labels) > 0 {
            lbl = state.loop_end_labels[len(state.loop_end_labels) - 1]
            defer_emit_down_to(state, defer_loop_mark(state), debug_mode)
            emit(state, "    b " + lbl)
        }
    }
    if node.kind == "Continue" {
        if len(state.loop_start_labels) > 0 {
            lbl = state.loop_start_labels[len(state.loop_start_labels) - 1]
            defer_emit_down_to(state, defer_loop_mark(state), debug_mode)
            emit(state, "    b " + lbl)
        }
    }
    if node.kind == "Defer" {
        state.defer_nodes.append(node)
    }
    if node.kind == "Block" {
        i = 0
        while i < len(node.body) {
            compile_stmt(state, node.body[i], debug_mode)
            i = i + 1
        }
    }
    if node.kind == "RawBlock" {
        i = 0
        while i < len(node.args) {
            emit(state, "    .global " + node.args[i])
            i = i + 1
        }
        lines = []
        i = 0
        while i < len(node.body) {
            l = node.body[i].line
            found = 0
            j = 0
            while j < len(lines) {
                if lines[j] == l { found = 1 }
                j = j + 1
            }
            if found == 0 { lines.append(l) }
            i = i + 1
        }
        j = 0
        while j < len(lines) {
            l = lines[j]
            line_nodes = []
            i = 0
            while i < len(node.body) {
                if node.body[i].line == l { line_nodes.append(node.body[i]) }
                i = i + 1
            }
            first = line_nodes[0]
            if len(line_nodes) == 1 and first.kind == "String" {
                emit(state, first.val_str)
            } else {
                if first.kind == "Variable" and is_asm_mnemonic(state, first.val_str) == 1 {
                    asm_line = "    "
                    k = 0
                    while k < len(line_nodes) {
                        asm_line = asm_line + node_to_asm(state, line_nodes[k])
                        if k < len(line_nodes) - 1 { asm_line = asm_line + " " }
                        k = k + 1
                    }
                    emit(state, asm_line)
                } else {
                    k = 0
                    while k < len(line_nodes) {
                        compile_stmt(state, line_nodes[k], debug_mode)
                        k = k + 1
                    }
                }
            }
            j = j + 1
        }
    }
    
    if node.kind == "TRY" {
        catch_label = next_label(state, "L_catch")
        after_label = next_label(state, "L_after_try")
        
        emit(state, "    adrp %c, _try_catch_sp@PAGE")
        emit(state, "    add %c, %c, _try_catch_sp@PAGEOFF")
        emit(state, "    mov %d, %s")
        emit(state, "    str %d, [%c]")
        emit(state, "    adrp %c, _catch_ip@PAGE")
        emit(state, "    add %c, %c, _catch_ip@PAGEOFF")
        emit(state, "    adrp %d, " + catch_label + "@PAGE")
        emit(state, "    add %d, %d, " + catch_label + "@PAGEOFF")
        emit(state, "    str %d, [%c]")
        
        defer_push_scope(state)
        i = 0
        while i < len(node.body) {
            compile_stmt(state, node.body[i], debug_mode)
            i = i + 1
        }
        defer_end_scope(state, debug_mode)
        
        emit(state, "    adrp %c, _try_catch_sp@PAGE")
        emit(state, "    add %c, %c, _try_catch_sp@PAGEOFF")
        emit(state, "    str xzr, [%c]")
        emit(state, "    b " + after_label)
        emit(state, catch_label + ":")
        emit(state, "    adrp %a, _exception_val@PAGE")
        emit(state, "    add %a, %a, _exception_val@PAGEOFF")
        emit(state, "    ldr %a, [%a]")
        
        defer_push_scope(state)
        if node.val_str != "" {
            var_offset = find_var_offset(state, node.val_str)
            emit_fp_store(state, "x0", var_offset)
        }
        
        i = 0
        while i < len(node.else_body) {
            compile_stmt(state, node.else_body[i], debug_mode)
            i = i + 1
        }
        defer_end_scope(state, debug_mode)
        
        emit(state, after_label + ":")
    }
    if node.kind == "THROW" {
        compile_expr(state, node.left)
        emit(state, "    ldr %a, [%s], #16")
        emit(state, "    adrp %c, _exception_val@PAGE")
        emit(state, "    add %c, %c, _exception_val@PAGEOFF")
        emit(state, "    str %a, [%c]")
        defer_emit_down_to(state, 0, debug_mode)
        emit(state, "    adrp %d, _try_catch_sp@PAGE")
        emit(state, "    add %d, %d, _try_catch_sp@PAGEOFF")
        emit(state, "    ldr %d, [%d]")
        emit(state, "    mov %s, %d")
        emit(state, "    adrp %c, _catch_ip@PAGE")
        emit(state, "    add %c, %c, _catch_ip@PAGEOFF")
        emit(state, "    ldr %c, [%c]")
        emit(state, "    br %c")
    }
    if node.kind == "Call" or node.kind == "MethodCall" {
        compile_expr(state, node)
        clean_n(state, 1)
    }
}
