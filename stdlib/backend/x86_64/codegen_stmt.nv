# ============================================================
# Code Generator: Statement Compilation
# ============================================================

def bce_list_safe(lst: list, loopvar: string, listname: string) -> int {
    if lst == 0 { return 1 }
    i = 0
    while i < len(lst) {
        if bce_node_safe(lst[i], loopvar, listname) == 0 { return 0 }
        i = i + 1
    }
    return 1
}

def bce_node_safe(node: AstNode, loopvar: string, listname: string) -> int {
    if node == 0 { return 1 }
    k = node.kind
    if k == 0 { return 0 }
    if k == "Number" { return 1 }
    if k == "String" { return 1 }
    if k == "Boolean" { return 1 }
    if k == "Variable" { return 1 }
    if k == "NONE" { return 1 }
    if k == "Break" { return 1 }
    if k == "Continue" { return 1 }
    if k == "Data" { return 1 }
    if k == "ClassDef" { return 1 }
    if k == "Function" { return 1 }
    if k == "Import" { return 1 }
    if k == "Export" { return 1 }
    if k == "Comptime" { return 1 }
    if k == "RawBlock" { return 0 }
    if k == "MethodCall" { return 0 }
    if k == "Free" { return 0 }
    if k == "Assignment" {
        if node.val_str == loopvar { return 0 }
        if node.val_str == listname { return 0 }
        return bce_node_safe(node.left, loopvar, listname)
    }
    if k == "ForLoop" {
        if node.val_str == loopvar { return 0 }
        if node.val_str == listname { return 0 }
        if bce_node_safe(node.left, loopvar, listname) == 0 { return 0 }
        if bce_node_safe(node.right, loopvar, listname) == 0 { return 0 }
        if bce_node_safe(node.cond, loopvar, listname) == 0 { return 0 }
        return bce_list_safe(node.body, loopvar, listname)
    }
    if k == "ForIn" {
        if node.val_str == loopvar { return 0 }
        if node.val_str == listname { return 0 }
        if bce_node_safe(node.left, loopvar, listname) == 0 { return 0 }
        return bce_list_safe(node.body, loopvar, listname)
    }
    if k == "While" {
        if bce_node_safe(node.cond, loopvar, listname) == 0 { return 0 }
        return bce_list_safe(node.body, loopvar, listname)
    }
    if k == "IfElse" {
        if bce_node_safe(node.cond, loopvar, listname) == 0 { return 0 }
        if bce_list_safe(node.body, loopvar, listname) == 0 { return 0 }
        return bce_list_safe(node.else_body, loopvar, listname)
    }
    if k == "TRY" {
        if bce_list_safe(node.body, loopvar, listname) == 0 { return 0 }
        return bce_list_safe(node.else_body, loopvar, listname)
    }
    if k == "Return" { return bce_node_safe(node.left, loopvar, listname) }
    if k == "Throw" { return bce_node_safe(node.left, loopvar, listname) }
    if k == "Print" { return bce_node_safe(node.left, loopvar, listname) }
    if k == "PrintD" { return bce_node_safe(node.left, loopvar, listname) }
    if k == "Block" { return bce_list_safe(node.body, loopvar, listname) }
    if k == "Call" {
        if node.val_str == "len" {
            return bce_list_safe(node.args, loopvar, listname)
        }
        return 0
    }
    if k == "BinOp" {
        if bce_node_safe(node.left, loopvar, listname) == 0 { return 0 }
        return bce_node_safe(node.right, loopvar, listname)
    }
    if k == "Compare" {
        if bce_node_safe(node.left, loopvar, listname) == 0 { return 0 }
        return bce_node_safe(node.right, loopvar, listname)
    }
    if k == "UnaryOp" { return bce_node_safe(node.left, loopvar, listname) }
    if k == "ArrayIndex" {
        if bce_node_safe(node.left, loopvar, listname) == 0 { return 0 }
        return bce_node_safe(node.right, loopvar, listname)
    }
    if k == "ArrayIndexAssign" {
        if bce_node_safe(node.cond, loopvar, listname) == 0 { return 0 }
        if bce_node_safe(node.right, loopvar, listname) == 0 { return 0 }
        return bce_node_safe(node.left, loopvar, listname)
    }
    if k == "DataFieldAssign" {
        if bce_node_safe(node.left, loopvar, listname) == 0 { return 0 }
        return bce_node_safe(node.right, loopvar, listname)
    }
    if k == "PointerAssign" {
        if bce_node_safe(node.left, loopvar, listname) == 0 { return 0 }
        return bce_node_safe(node.right, loopvar, listname)
    }
    if k == "DataFieldAccess" { return bce_node_safe(node.left, loopvar, listname) }
    if k == "PointerProperty" { return bce_node_safe(node.left, loopvar, listname) }
    if k == "ListLiteral" { return bce_list_safe(node.args, loopvar, listname) }
    if k == "DictLiteral" { return bce_list_safe(node.args, loopvar, listname) }
    if k == "Slice" {
        if bce_node_safe(node.left, loopvar, listname) == 0 { return 0 }
        if bce_node_safe(node.right, loopvar, listname) == 0 { return 0 }
        return bce_node_safe(node.cond, loopvar, listname)
    }
    if k == "StrConvert" { return bce_node_safe(node.left, loopvar, listname) }
    if k == "Len" { return bce_node_safe(node.left, loopvar, listname) }
    if k == "SizeOf" { return bce_node_safe(node.left, loopvar, listname) }
    if k == "Alloc" { return bce_node_safe(node.left, loopvar, listname) }
    if k == "Openf" {
        if bce_node_safe(node.left, loopvar, listname) == 0 { return 0 }
        return bce_node_safe(node.right, loopvar, listname)
    }
    return 0
}

def bce_len_list_of(state: CodegenState, node: AstNode) -> string {
    if node == 0 { return "" }
    if node.kind != "BinOp" { return "" }
    if node.val_str != "-" { return "" }
    l = node.left
    r = node.right
    if l == 0 or r == 0 { return "" }
    if l.kind == "Len" {
        la = l.left
        if la == 0 or la.kind != "Variable" { return "" }
        if r.kind != "Number" { return "" }
        if r.is_float == 1 { return "" }
        if r.val_int != 1 { return "" }
        return la.val_str
    }
    if l.kind != "Call" { return "" }
    if l.val_str != "len" { return "" }
    if l.args == 0 or len(l.args) != 1 { return "" }
    a = l.args[0]
    if a == 0 or a.kind != "Variable" { return "" }
    if r.kind != "Number" { return "" }
    if r.is_float == 1 { return "" }
    if r.val_int != 1 { return "" }
    return a.val_str
}

def compile_stmt(state: CodegenState, node: AstNode, debug_mode: int) {
    if node.kind == "Assignment" {
        is_str_val = 0
        if is_string_expr(state, node.left) == 1 {
            is_str_val = 1
        }
        if node.left.kind == "ArrayIndex" {
            if is_string_expr(state, node.left) == 1 {
                is_str_val = 1
            }
        }
        if is_str_val == 1 {
            if state.string_var_map.has(node.val_str) == 0 {
                state.string_vars.append(node.val_str)
                state.string_var_map.set(node.val_str, 1)
            }
        }
        compile_expr(state, node.left)
        emit(state, "    pop %a")
        reg_val = find_var_reg(state, node.val_str)
        if reg_val != "" {
            emit(state, "    mov " + reg_val + ", %a")
        } else {
            offset = find_var_offset(state, node.val_str)
            if offset < 0 {
                emit(state, "    mov [%b + " + str(0 - offset) + "], %a")
            } else {
                emit(state, "    mov [%b - " + str(offset) + "], %a")
            }
        }
    }
    if node.kind == "DataFieldAssign" {
        compile_expr(state, node.right)
        compile_expr(state, node.left)
        emit(state, "    pop %d")
        emit(state, "    pop %a")
        struct_name = "any"
        if node.left.inferred_type != 0 and node.left.inferred_type.kind == "struct" {
            struct_name = node.left.inferred_type.name
        }
        prop_off = get_prop_offset(state, struct_name, node.val_str)
        emit(state, "    mov [%d + " + str(prop_off) + "], %a")
    }
    if node.kind == "PointerAssign" {
        compile_expr(state, node.right)
        compile_expr(state, node.left)
        emit(state, "    pop %d")
        emit(state, "    pop %a")
        if node.val_str == "value_byte" {
            emit(state, "    mov byte ptr [%d], al")
        } else {
            if node.val_str == "value_word" {
                emit(state, "    mov word ptr [%d], ax")
            } else {
                if node.val_str == "value_dword" or node.val_str == "value" {
                    emit(state, "    mov [%d], %a")
                }
            }
        }
    }
    if node.kind == "ArrayIndexAssign" {
        compile_expr(state, node.cond)
        compile_expr(state, node.right)
        compile_expr(state, node.left)
        emit(state, "    pop %d")
        emit(state, "    pop %c")
        emit(state, "    pop %a")
        is_dict = 0
        if node.left.inferred_type != 0 and node.left.inferred_type.kind == "dict" {
            is_dict = 1
        }
        if is_dict == 1 {
            emit(state, "    push %a")
            emit(state, "    push %c")
            emit(state, "    push %d")
            emit_call(state, "_dict_set", 3)
        } else {
            skip_upper = 0
            if node.right != 0 and node.right.kind == "Variable" {
                if node.left != 0 and node.left.kind == "Variable" {
                    if is_string_expr(state, node.left) == 0 {
                        idx = len(state.bce_loop_vars) - 1
                        while idx >= 0 {
                            if state.bce_loop_vars[idx] == node.right.val_str {
                                blist = state.bce_loop_lists[idx]
                                if blist != "" and blist == node.left.val_str {
                                    skip_upper = 1
                                }
                                break
                            }
                            idx = idx - 1
                        }
                    }
                }
            }
            emit(state, "    lea %x, [rip + _oob_line]")
            emit(state, "    mov qword ptr [%x], " + str(node.line))
            emit(state, "    cmp rcx, 0")
            emit(state, "    jl _out_of_bounds")
            if skip_upper == 0 {
                emit(state, "    cmp ecx, dword ptr [%d]")
                emit(state, "    jge _out_of_bounds")
            }
            ptr_sz = ptr_size(state)
            emit(state, "    mov %x, [%d + 8]")
            if ptr_sz == 8 {
                emit(state, "    mov [%x + %c*8], %a")
            } else {
                emit(state, "    mov [%x + %c*4], %a")
            }
        }
    }
    if node.kind == "PrintD" {
        if debug_mode == 1 {
            push_data_label(state, "debug_prefix")
            emit_call(state, "L_write_stdout", 1)
            emit(state, "    push " + str(node.line))
            emit_call(state, "L_write_int", 1)
            push_data_label(state, "debug_suffix")
            emit_call(state, "L_write_stdout", 1)
            compile_expr(state, node.left)
            if is_string_expr(state, node.left) == 1 {
                push_data_label(state, "fmt_str")
                emit_call(state, "_printf", 2)
            } else {
                if is_float_expr(state, node.left) == 1 {
                    push_data_label(state, "fmt_float_pure")
                } else {
                    push_data_label(state, "fmt_int_pure")
                }
                emit_call(state, "_printf", 2)
            }
            emit(state, "    push 10")
            emit_call(state, "_fputc", 1)
            emit(state, "    push 0")
            emit_call(state, "_fflush", 1)
        }
    }
    if node.kind == "Print" {
        compile_expr(state, node.left)
        if is_string_expr(state, node.left) == 1 {
            push_data_label(state, "fmt_str")
        } else {
            if is_float_expr(state, node.left) == 1 {
                push_data_label(state, "fmt_float")
            } else {
                push_data_label(state, "fmt_int")
            }
        }
        emit_call(state, "_printf", 2)
        emit(state, "    push 0")
        emit_call(state, "_fflush", 1)
    }
    if node.kind == "Return" {
        if node.left != 0 { compile_expr(state, node.left) }
        emit(state, "    pop %a")
        r = len(state.used_regs) - 1
        while r >= 0 {
            emit(state, "    pop " + state.used_regs[r])
            r = r - 1
        }
        emit(state, "    mov " + state.sp + ", " + state.bp)
        emit(state, "    pop " + state.bp)
        emit(state, "    ret")
    }
    if node.kind == "IfElse" {
        else_label = "L_else_" + str(state.label_count)
        state.label_count = state.label_count + 1
        end_label = "L_end_" + str(state.label_count)
        state.label_count = state.label_count + 1
        
        compile_expr(state, node.cond)
        emit(state, "    pop %a")
        emit(state, "    cmp %a, 0")
        emit(state, "    je " + else_label)
        
        i = 0
        while i < len(node.body) {
            compile_stmt(state, node.body[i], debug_mode)
            i = i + 1
        }
        emit(state, "    jmp " + end_label)
        
        emit(state, else_label + ":")
        i = 0
        while i < len(node.else_body) {
            compile_stmt(state, node.else_body[i], debug_mode)
            i = i + 1
        }
        
        emit(state, end_label + ":")
    }
    if node.kind == "While" {
        start_label = next_label(state, "L_loop")
        end_label = next_label(state, "L_loop_end")
        state.loop_start_labels.append(start_label)
        state.loop_end_labels.append(end_label)

        emit(state, start_label + ":")
        compile_expr(state, node.cond)
        emit(state, "    pop %a")
        emit(state, "    cmp %a, 0")
        emit(state, "    je " + end_label)

        i = 0
        while i < len(node.body) {
            compile_stmt(state, node.body[i], debug_mode)
            i = i + 1
        }

        emit(state, "    jmp " + start_label)
        emit(state, end_label + ":")
        state.loop_start_labels.pop()
        state.loop_end_labels.pop()
    }
    if node.kind == "ForLoop" {
        compile_expr(state, node.left)
        emit(state, "    pop %a")
        reg_val = find_var_reg(state, node.val_str)
        if reg_val != "" {
            emit(state, "    mov " + reg_val + ", %a")
        } else {
            offset = find_var_offset(state, node.val_str)
            if offset < 0 {
                emit(state, "    mov [%b + " + str(0 - offset) + "], %a")
            } else {
                emit(state, "    mov [%b - " + str(offset) + "], %a")
            }
        }

        loop_label = next_label(state, "L_for")
        end_label = next_label(state, "L_for_end")
        cont_label = next_label(state, "L_for_cont")
        state.loop_start_labels.append(cont_label)
        state.loop_end_labels.append(end_label)

        emit(state, loop_label + ":")
        compile_expr(state, node.right)
        emit(state, "    pop %x")
        if reg_val != "" {
            emit(state, "    mov %a, " + reg_val)
        } else {
            off2 = find_var_offset(state, node.val_str)
            if off2 < 0 {
                emit(state, "    mov %a, [%b + " + str(0 - off2) + "]")
            } else {
                emit(state, "    mov %a, [%b - " + str(off2) + "]")
            }
        }
        emit(state, "    cmp %a, %x")
        if node.val_int == 1 {
            emit(state, "    jl " + end_label)
        } else {
            emit(state, "    jg " + end_label)
        }

        bce_list = ""
        if node.val_int == 0 {
            cand = bce_len_list_of(state, node.right)
            if cand != "" {
                if bce_list_safe(node.body, node.val_str, cand) == 1 {
                    bce_list = cand
                }
            }
        }
        state.bce_loop_vars.append(node.val_str)
        state.bce_loop_lists.append(bce_list)

        i = 0
        while i < len(node.body) {
            compile_stmt(state, node.body[i], debug_mode)
            i = i + 1
        }
        state.bce_loop_vars.pop()
        state.bce_loop_lists.pop()

        emit(state, cont_label + ":")
        compile_expr(state, node.cond)
        emit(state, "    pop %x")
        if reg_val != "" {
            emit(state, "    mov %a, " + reg_val)
        } else {
            off2 = find_var_offset(state, node.val_str)
            if off2 < 0 {
                emit(state, "    mov %a, [%b + " + str(0 - off2) + "]")
            } else {
                emit(state, "    mov %a, [%b - " + str(off2) + "]")
            }
        }
        if node.val_int == 1 {
            emit(state, "    sub %a, %x")
        } else {
            emit(state, "    add %a, %x")
        }
        if reg_val != "" {
            emit(state, "    mov " + reg_val + ", %a")
        } else {
            off2 = find_var_offset(state, node.val_str)
            if off2 < 0 {
                emit(state, "    mov [%b + " + str(0 - off2) + "], %a")
            } else {
                emit(state, "    mov [%b - " + str(off2) + "], %a")
            }
        }

        emit(state, "    jmp " + loop_label)
        emit(state, end_label + ":")
        state.loop_start_labels.pop()
        state.loop_end_labels.pop()
    }
    if node.kind == "ForIn" {
        compile_expr(state, node.left)
        
        ptr_sz = ptr_size(state)
        emit(state, "    sub %s, " + str(ptr_sz))
        emit(state, "    mov qword ptr [%s], 0")
        
        loop_label = next_label(state, "L_forin")
        end_label = next_label(state, "L_forin_end")
        state.loop_start_labels.append(loop_label)
        state.loop_end_labels.append(end_label)
        
        emit(state, loop_label + ":")
        emit(state, "    mov %d, [%s + " + str(ptr_sz) + "]")
        emit(state, "    mov eax, dword ptr [%d]")
        emit(state, "    cmp qword ptr [%s], rax")
        emit(state, "    jge " + end_label)
        
        emit(state, "    mov rax, qword ptr [%s]")
        emit(state, "    mov %x, [%d + 8]")
        if ptr_sz == 8 {
            emit(state, "    mov %a, [%x + %a*8]")
        } else {
            emit(state, "    mov %a, [%x + %a*4]")
        }
        
        loop_reg = find_var_reg(state, node.val_str)
        if loop_reg != "" {
            emit(state, "    mov " + loop_reg + ", %a")
        } else {
            loop_var_off = find_var_offset(state, node.val_str)
            var_off = loop_var_off
            if loop_var_off < 0 {
                emit(state, "    mov [%b + " + str(0 - loop_var_off) + "], %a")
            } else {
                emit(state, "    mov [%b - " + str(loop_var_off) + "], %a")
            }
        }
        
        state.bce_loop_vars.append(node.val_str)
        state.bce_loop_lists.append("")

        i = 0
        while i < len(node.body) {
            compile_stmt(state, node.body[i], debug_mode)
            i = i + 1
        }
        state.bce_loop_vars.pop()
        state.bce_loop_lists.pop()
        
        emit(state, "    mov rax, qword ptr [%s]")
        emit(state, "    inc rax")
        emit(state, "    mov qword ptr [%s], rax")
        emit(state, "    jmp " + loop_label)
        emit(state, end_label + ":")
        clean_n(state, 2)
        state.loop_start_labels.pop()
        state.loop_end_labels.pop()
    }
    if node.kind == "Break" {
        if len(state.loop_end_labels) > 0 {
            lbl = state.loop_end_labels[len(state.loop_end_labels) - 1]
            emit(state, "    jmp " + lbl)
        }
    }
    if node.kind == "Continue" {
        if len(state.loop_start_labels) > 0 {
            lbl = state.loop_start_labels[len(state.loop_start_labels) - 1]
            emit(state, "    jmp " + lbl)
        }
    }
    if node.kind == "Block" {
        i = 0
        while i < len(node.body) {
            compile_stmt(state, node.body[i], debug_mode)
            i = i + 1
        }
    }
    if node.kind == "RawBlock" {
        i = 0
        while i < len(node.args) {
            emit(state, "    .global " + node.args[i])
            i = i + 1
        }
        lines = []
        i = 0
        while i < len(node.body) {
            l = node.body[i].line
            found = 0
            j = 0
            while j < len(lines) {
                if lines[j] == l { found = 1 }
                j = j + 1
            }
            if found == 0 { lines.append(l) }
            i = i + 1
        }
        j = 0
        while j < len(lines) {
            l = lines[j]
            line_nodes = []
            i = 0
            while i < len(node.body) {
                if node.body[i].line == l { line_nodes.append(node.body[i]) }
                i = i + 1
            }
            first = line_nodes[0]
            if len(line_nodes) == 1 and first.kind == "String" {
                raw_str = first.val_str
                if len(raw_str) >= 2 and raw_str[0] == "\"" {
                    raw_str = str_sub(raw_str, 1, len(raw_str) - 1)
                }
                emit(state, raw_str)
            } else {
                if first.kind == "Variable" and is_asm_mnemonic(state, first.val_str) == 1 {
                    asm_line = "    "
                    k = 0
                    while k < len(line_nodes) {
                        asm_line = asm_line + node_to_asm(state, line_nodes[k])
                        if k < len(line_nodes) - 1 { asm_line = asm_line + " " }
                        k = k + 1
                    }
                    emit(state, asm_line)
                } else {
                    k = 0
                    while k < len(line_nodes) {
                        compile_stmt(state, line_nodes[k], debug_mode)
                        k = k + 1
                    }
                }
            }
            j = j + 1
        }
    }
    
    if node.kind == "TRY" {
        catch_label = next_label(state, "L_catch")
        after_label = next_label(state, "L_after_try")
        
        emit(state, "    lea %a, [rip + _try_catch_sp]")
        emit(state, "    mov [%a], %s")
        emit(state, "    lea %a, [rip + _catch_ip]")
        emit(state, "    lea %c, [rip + " + catch_label + "]")
        emit(state, "    mov [%a], %c")
        
        i = 0
        while i < len(node.body) {
            compile_stmt(state, node.body[i], debug_mode)
            i = i + 1
        }
        
        emit(state, "    lea %a, [rip + _try_catch_sp]")
        emit(state, "    xor %c, %c")
        emit(state, "    mov [%a], %c")
        emit(state, "    jmp " + after_label)
        emit(state, catch_label + ":")
        emit(state, "    lea %a, [rip + _exception_val]")
        emit(state, "    mov %a, [%a]")
        
        if node.val_str != "" {
            err_reg = find_var_reg(state, node.val_str)
            if err_reg != "" {
                emit(state, "    mov " + err_reg + ", %a")
            } else {
                var_offset = find_var_offset(state, node.val_str)
                emit(state, "    mov [%b - " + str(abs(var_offset)) + "], %a")
            }
        }
        
        i = 0
        while i < len(node.else_body) {
            compile_stmt(state, node.else_body[i], debug_mode)
            i = i + 1
        }
        
        emit(state, after_label + ":")
    }
    if node.kind == "THROW" {
        compile_expr(state, node.left)
        emit(state, "    pop %j")
        emit(state, "    lea %a, [rip + _exception_val]")
        emit(state, "    mov [%a], %j")
        emit(state, "    lea %c, [rip + _try_catch_sp]")
        emit(state, "    mov %s, [%c]")
        emit(state, "    lea %c, [rip + _catch_ip]")
        emit(state, "    mov %c, [%c]")
        emit(state, "    jmp %c")
    }
    if node.kind == "Call" or node.kind == "MethodCall" {
        compile_expr(state, node)
        clean_n(state, 1)
    }
}
