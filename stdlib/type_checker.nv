import system
import lexer
import parser
import types
import errors

data TypeChecker {
    env_stack: list
    structs: list
    functions: list
    func_name_map: dict
    struct_name_map: dict
    current_ret: Type
    filename: string
    named_func_map: dict
    global_names: dict
    global_consts: dict
    fn_missing: dict
    fn_assigned: dict
    shadow_calls: list
    pending: list
    name_pool: list
    strict_calls: int
}

data NamedFunc {
    name: string
    typ: Type
    param_names: list
    func_defaults: list
}

data EnvVar {
    name: string
    typ: Type
}

data EnvFrame {
    vars: list
    name_map: dict
}

def tc_init(tc: TypeChecker) {
    tc.env_stack = []
    tc.structs = []
    tc.functions = []
    tc.func_name_map = {}
    tc.struct_name_map = {}
    tc.named_func_map = {}
    tc.current_ret = 0
    tc.filename = ""
    tc.global_names = {}
    tc.global_consts = {}
    tc.fn_missing = {}
    tc.fn_assigned = {}
    tc.shadow_calls = []
    tc.pending = []
    tc.name_pool = []
    tc.strict_calls = 0

    # sys_alloc(size: int) -> any
    sys_alloc_t = create_func_type([create_scalar_type("int")], create_any_type())
    tc_add_func(tc, "sys_alloc", sys_alloc_t)

    # sys_free(ptr: any) -> void
    sys_free_t = create_func_type([create_any_type()], create_scalar_type("void"))
    tc_add_func(tc, "sys_free", sys_free_t)

    # sys_exit(code: int) -> void
    sys_exit_t = create_func_type([create_scalar_type("int")], create_scalar_type("void"))
    tc_add_func(tc, "sys_exit", sys_exit_t)

    # sys_open(path: string, mode: string) -> int
    sys_open_t = create_func_type([create_scalar_type("string"), create_scalar_type("string")], create_scalar_type("int"))
    tc_add_func(tc, "sys_open", sys_open_t)

    # sys_read(fd: int) -> string
    sys_read_t = create_func_type([create_scalar_type("int")], create_scalar_type("string"))
    tc_add_func(tc, "sys_read", sys_read_t)

    # sys_read_stdin(count: int) -> string
    sys_read_stdin_t = create_func_type([create_scalar_type("int")], create_scalar_type("string"))
    tc_add_func(tc, "sys_read_stdin", sys_read_stdin_t)

    # sys_read_line() -> string
    sys_read_line_t = create_func_type([], create_scalar_type("string"))
    tc_add_func(tc, "sys_read_line", sys_read_line_t)

    # sys_write(fd: int, content: any) -> void
    sys_write_t = create_func_type([create_scalar_type("int"), create_any_type()], create_scalar_type("void"))
    tc_add_func(tc, "sys_write", sys_write_t)

    # sys_write_raw(fd: int, content: list) -> void
    sys_write_raw_t = create_func_type([create_scalar_type("int"), create_list_type(create_scalar_type("int"))], create_scalar_type("void"))
    tc_add_func(tc, "sys_write_raw", sys_write_raw_t)

    # sys_close(fd: int) -> void
    sys_close_t = create_func_type([create_scalar_type("int")], create_scalar_type("void"))
    tc_add_func(tc, "sys_close", sys_close_t)

    # sys_platform() -> string
    sys_platform_t = create_func_type([], create_scalar_type("string"))
    tc_add_func(tc, "sys_platform", sys_platform_t)

    # sys_flush() -> void
    sys_flush_t = create_func_type([], create_scalar_type("void"))
    tc_add_func(tc, "sys_flush", sys_flush_t)

    # sys_get_args() -> list
    sys_get_args_t = create_func_type([], create_list_type(create_scalar_type("string")))
    tc_add_func(tc, "sys_get_args", sys_get_args_t)

    # sys_get_tick_count() -> int
    sys_get_tick_count_t = create_func_type([], create_scalar_type("int"))
    tc_add_func(tc, "sys_get_tick_count", sys_get_tick_count_t)

    # sys_exe_path() -> string
    sys_exe_path_t = create_func_type([], create_scalar_type("string"))
    tc_add_func(tc, "sys_exe_path", sys_exe_path_t)

    # alloc(size: int) -> any
    alloc_t = create_func_type([create_scalar_type("int")], create_any_type())
    tc_add_func(tc, "alloc", alloc_t)

    # len(target: any) -> int
    len_t = create_func_type([create_any_type()], create_scalar_type("int"))
    tc_add_func(tc, "len", len_t)

    # print(val: any) -> void
    print_t = create_func_type([create_any_type()], create_scalar_type("void"))
    tc_add_func(tc, "print", print_t)

    # char_code(s: string, i: int) -> int
    char_code_t = create_func_type([create_scalar_type("string"), create_scalar_type("int")], create_scalar_type("int"))
    tc_add_func(tc, "char_code", char_code_t)

    # str_sub(s: string, start: int, end: int) -> string
    str_sub_t = create_func_type([create_scalar_type("string"), create_scalar_type("int"), create_scalar_type("int")], create_scalar_type("string"))
    tc_add_func(tc, "str_sub", str_sub_t)

    # nova_json_decode_string(raw: string, start: int, end: int) -> string
    json_decode_t = create_func_type([create_scalar_type("string"), create_scalar_type("int"), create_scalar_type("int")], create_scalar_type("string"))
    tc_add_func(tc, "nova_json_decode_string", json_decode_t)

    # abs(n: int) -> int
    abs_t = create_func_type([create_scalar_type("int")], create_scalar_type("int"))
    tc_add_func(tc, "abs", abs_t)
    # min(a: int, b: int) -> int
    min_t = create_func_type([create_scalar_type("int"), create_scalar_type("int")], create_scalar_type("int"))
    tc_add_func(tc, "min", min_t)
    # max(a: int, b: int) -> int
    max_t = create_func_type([create_scalar_type("int"), create_scalar_type("int")], create_scalar_type("int"))
    tc_add_func(tc, "max", max_t)

    # file_exists(path: string) -> int
    file_exists_t = create_func_type([create_scalar_type("string")], create_scalar_type("int"))
    tc_add_func(tc, "file_exists", file_exists_t)
    # file_size(path: string) -> int
    file_size_t = create_func_type([create_scalar_type("string")], create_scalar_type("int"))
    tc_add_func(tc, "file_size", file_size_t)
    # file_type(path: string) -> string
    file_type_t = create_func_type([create_scalar_type("string")], create_scalar_type("string"))
    tc_add_func(tc, "file_type", file_type_t)

    # now() -> string
    now_t = create_func_type([], create_scalar_type("string"))
    tc_add_func(tc, "now", now_t)

    # random() -> int  (0 or 2 args)
    random_t = create_func_type([], create_scalar_type("int"))
    tc_add_func(tc, "random", random_t)
    # chacha20_init(seed1: int, seed2: int) -> void
    chacha_t = create_func_type([create_scalar_type("int"), create_scalar_type("int")], create_any_type())
    tc_add_func(tc, "chacha20_init", chacha_t)

    # type(val: any) -> string
    type_t = create_func_type([create_any_type()], create_scalar_type("string"))
    tc_add_func(tc, "type", type_t)

    # call(name: string, args: list) -> any
    call_t = create_func_type([create_scalar_type("string"), create_list_type(create_any_type())], create_any_type())
    tc_add_func(tc, "call", call_t)

    # Hardware MMIO & CPU Intrinsics
    int_t = create_scalar_type("int")
    any_t = create_any_type()
    fn_addr_int = create_func_type([any_t], int_t)
    fn_addr_int_int = create_func_type([any_t, int_t], int_t)
    fn_int_int = create_func_type([int_t], int_t)
    fn_int_int_int = create_func_type([int_t, int_t], int_t)
    fn_void_int = create_func_type([], int_t)

    tc_add_func(tc, "peek_u8", fn_addr_int)
    tc_add_func(tc, "peek_u16", fn_addr_int)
    tc_add_func(tc, "peek_u32", fn_addr_int)
    tc_add_func(tc, "peek_u64", fn_addr_int)

    tc_add_func(tc, "poke_u8", fn_addr_int_int)
    tc_add_func(tc, "poke_u16", fn_addr_int_int)
    tc_add_func(tc, "poke_u32", fn_addr_int_int)
    tc_add_func(tc, "poke_u64", fn_addr_int_int)

    tc_add_func(tc, "mem_read_u8", fn_addr_int)
    tc_add_func(tc, "mem_read_u16", fn_addr_int)
    tc_add_func(tc, "mem_read_u32", fn_addr_int)
    tc_add_func(tc, "mem_read_u64", fn_addr_int)

    tc_add_func(tc, "mem_write_u8", fn_addr_int_int)
    tc_add_func(tc, "mem_write_u16", fn_addr_int_int)
    tc_add_func(tc, "mem_write_u32", fn_addr_int_int)
    tc_add_func(tc, "mem_write_u64", fn_addr_int_int)

    tc_add_func(tc, "cpu_cli", fn_void_int)
    tc_add_func(tc, "cpu_sti", fn_void_int)
    tc_add_func(tc, "cpu_hlt", fn_void_int)

    tc_add_func(tc, "cpu_inb", fn_int_int)
    tc_add_func(tc, "cpu_inw", fn_int_int)
    tc_add_func(tc, "cpu_ind", fn_int_int)

    tc_add_func(tc, "cpu_outb", fn_int_int_int)
    tc_add_func(tc, "cpu_outw", fn_int_int_int)
    tc_add_func(tc, "cpu_outd", fn_int_int_int)

    tc_add_func(tc, "cpu_read_cr3", fn_void_int)
    tc_add_func(tc, "cpu_write_cr3", fn_int_int)
    tc_add_func(tc, "cpu_read_cr2", fn_void_int)
    tc_add_func(tc, "cpu_read_cr0", fn_void_int)
    tc_add_func(tc, "cpu_write_cr0", fn_int_int)
    tc_add_func(tc, "cpu_pause", fn_void_int)
    tc_add_func(tc, "cpu_rdtsc", fn_void_int)
    tc_add_func(tc, "cpu_atomic_xchg", fn_addr_int_int)
    fn_int_int_int_int = create_func_type([int_t, int_t, int_t], int_t)
    tc_add_func(tc, "cpu_atomic_cas", fn_int_int_int_int)
    tc_add_func(tc, "cpu_invlpg", fn_int_int)

    fn_addr_addr_int = create_func_type([any_t, any_t], int_t)
    tc_add_func(tc, "mem_alloc", fn_int_int)
    tc_add_func(tc, "mem_free", fn_addr_int)
    tc_add_func(tc, "mem_set_allocator", fn_addr_addr_int)
    tc_add_func(tc, "mem_heap_used", fn_void_int)
    tc_add_func(tc, "mem_heap_total", fn_void_int)
}

def tc_add_func(tc: TypeChecker, name: string, typ: Type) {
    nf = NamedFunc()
    nf.name = name
    nf.typ = typ
    nf.param_names = []
    nf.func_defaults = []
    tc.functions.append(nf)
    tc.func_name_map.set(name, typ)
    tc.named_func_map.set(name, nf)
}

def tc_add_func_full(tc: TypeChecker, name: string, typ: Type, p_names: list, p_defs: list) {
    nf = NamedFunc()
    nf.name = name
    nf.typ = typ
    nf.param_names = p_names
    nf.func_defaults = p_defs
    tc.functions.append(nf)
    tc.func_name_map.set(name, typ)
    tc.named_func_map.set(name, nf)
}

def tc_find_func(tc: TypeChecker, name: string) -> Type {
    if tc.func_name_map.has(name) { return tc.func_name_map.get(name) }
    return 0
}

def tc_add_struct(tc: TypeChecker, typ: Type) {
    tc.structs.append(typ)
    tc.struct_name_map.set(typ.name, typ)
}

def tc_find_struct(tc: TypeChecker, name: string) -> Type {
    if tc.struct_name_map.has(name) { return tc.struct_name_map.get(name) }
    return 0
}

def tc_push_env(tc: TypeChecker) {
    frame = EnvFrame()
    frame.vars = []
    frame.name_map = {}
    tc.env_stack.append(frame)
}

def tc_pop_env(tc: TypeChecker) {
    if len(tc.env_stack) > 0 {
        _ = tc.env_stack.pop()
    }
}

# A real assignment / parameter: the name counts as defined in the current function
def tc_set_var(tc: TypeChecker, name: string, typ: Type) {
    tc.fn_assigned.set(name, 1)
    return tc_set_var_quiet(tc, name, typ)
}

# Same, without marking the name defined (used to cache the type of a read that found nothing)
def tc_set_var_quiet(tc: TypeChecker, name: string, typ: Type) {
    tc_note_name(tc, name)
    if len(tc.env_stack) == 0 { return 0 }
    frame = tc.env_stack[len(tc.env_stack) - 1]

    if frame.name_map.has(name) == 1 {
        v = frame.name_map.get(name)
        v.typ = typ
        return 0
    }

    v = EnvVar()
    v.name = name
    v.typ = typ
    frame.vars.append(v)
    frame.name_map.set(name, v)
    return 0
}

# ---------------------------------------------------------------------------------------------
# Undefined-name diagnostics
#
# Nova declares a variable by assigning it (`x = 1`), so reading a name nobody ever assigns used to be silently
# accepted as an untyped value - a typo (or a forgotten `let`) compiled and read garbage. A read that finds no
# variable is now recorded; when the enclosing function ends (or the program, for top-level code) the name is an
# error unless the function assigned it anywhere, took it as a parameter, or it is a global / function. Deciding at
# the end of the function keeps the rule independent of statement order and block scoping.
# ---------------------------------------------------------------------------------------------

def tc_note_name(tc: TypeChecker, name: string) {
    if tc.global_names.has("pool:" + name) == 1 { return 0 }
    tc.global_names.set("pool:" + name, 1)
    tc.name_pool.append(name)
    return 0
}

def _edit_distance(a: string, b: string) -> int {
    la = len(a)
    lb = len(b)
    prev = []
    j = 0
    while j <= lb {
        prev.append(j)
        j = j + 1
    }
    i = 1
    while i <= la {
        cur = [i]
        j = 1
        while j <= lb {
            cost = 1
            if a[i - 1] == b[j - 1] { cost = 0 }
            best = prev[j - 1] + cost
            if prev[j] + 1 < best { best = prev[j] + 1 }
            if cur[j - 1] + 1 < best { best = cur[j - 1] + 1 }
            cur.append(best)
            j = j + 1
        }
        prev = cur
        i = i + 1
    }
    return prev[lb]
}

# (elements of a list are untyped; a string-typed parameter makes len() measure characters, not a list header)
def _slen(s: string) -> int {
    return len(s)
}

def tc_suggest_name(tc: TypeChecker, name: string) -> string {
    best = ""
    best_d = 3
    i = 0
    while i < len(tc.name_pool) {
        cand = tc.name_pool[i]
        diff = _slen(cand) - len(name)
        if diff < 0 { diff = 0 - diff }
        if diff <= 2 and cand != name {
            d = _edit_distance(name, cand)
            if d < best_d {
                best_d = d
                best = cand
            }
        }
        i = i + 1
    }
    if best != "" { return "did you mean '" + best + "'?" }
    return "assign it before use (x = ...), or check the spelling"
}

# C library functions that Nova programs may call directly; the linker resolves them (a typo still fails there).
def tc_is_libc_name(name: string) -> int {
    known = ["exit", "abort", "malloc", "calloc", "realloc", "free", "puts", "printf", "putchar", "getchar",
             "memcpy", "memset", "memmove", "memcmp", "strlen", "strcmp", "strncmp", "strcpy", "strncpy", "strcat",
             "atoi", "atol", "rand", "srand", "sleep", "usleep", "system", "getenv", "fopen", "fclose", "fread",
             "fwrite", "fputs", "fgets", "fflush", "time", "clock", "qsort", "sqrt", "pow", "sin", "cos", "floor", "ceil"]
    i = 0
    while i < len(known) {
        if known[i] == name { return 1 }
        i = i + 1
    }
    return 0
}

def tc_suggest_func(tc: TypeChecker, name: string) -> string {
    best = ""
    best_d = 3
    names = tc.func_name_map.keys()
    i = 0
    while i < len(names) {
        cand = names[i]
        diff = _slen(cand) - len(name)
        if diff < 0 { diff = 0 - diff }
        if diff <= 2 and cand != name {
            d = _edit_distance(name, cand)
            if d < best_d {
                best_d = d
                best = cand
            }
        }
        i = i + 1
    }
    if best != "" { return "did you mean '" + best + "()'?" }
    return "define it with  def " + name + "(...)  or import the module that provides it"
}

def suggest_param_name(candidates: list, name: string) -> string {
    best = ""
    best_d = 4
    i = 0
    while i < len(candidates) {
        cand = candidates[i]
        diff = _slen(cand) - len(name)
        if diff < 0 { diff = 0 - diff }
        if diff <= 2 and cand != name {
            d = _edit_distance(name, cand)
            if d < best_d {
                best_d = d
                best = cand
            }
        }
        i = i + 1
    }
    if best != "" { return "did you mean '" + best + "'?" }
    return "check the parameter names in the function declaration"
}

# Report every recorded read that nothing in the current function/program ever defines
def tc_flush_pending(tc: TypeChecker) {
    # A call to a known function whose name is assigned as a variable LATER in the same function: the code
    # generator treats every name assigned anywhere in a function as a local, so `let x = x(1)` calls through the
    # (still empty) local instead of the function and jumps to address 0 at run time.
    si = 0
    while si < len(tc.shadow_calls) {
        sc = tc.shadow_calls[si]
        if tc.fn_assigned.has(sc[0]) == 1 {
            errors.err("Name", tc.filename, sc[1], "cannot call '" + sc[0] + "': a variable named '" + sc[0] + "' is assigned in this function, so the call goes through the variable, not the function " + sc[0] + "()", "rename the variable (for example a shorter name such as tx instead of " + sc[0] + ")", sc[2])
        }
        si = si + 1
    }
    tc.shadow_calls = []
    i = 0
    while i < len(tc.pending) {
        rec = tc.pending[i]
        nm = rec[0]
        if tc.fn_assigned.has(nm) == 0 {
            if tc.global_consts.has(nm) == 1 {
                # A module-level constant used by code that the one-pass constant inliner (compiler.nv) saw before
                # the constant's definition (the module declaring it is merged later). Without this the read
                # compiled as an uninitialised variable. Inline it here.
                cn = rec[3]
                cn.kind = "Number"
                cn.val_int = tc.global_consts.get(nm)
                cn.is_float = 0
            } elif tc.global_names.has(nm) == 0 and tc_find_func(tc, nm) == 0 {
                errors.err("Name", tc.filename, rec[1], "undefined name '" + nm + "'", tc_suggest_name(tc, nm), rec[2])
            }
        }
        i = i + 1
    }
    tc.pending = []
    return 0
}

def tc_get_var(tc: TypeChecker, name: string) -> Type {
    i = len(tc.env_stack) - 1
    while i >= 0 {
        frame = tc.env_stack[i]
        if frame.name_map.has(name) == 1 {
            v = frame.name_map.get(name)
            return v.typ
        }
        i = i - 1
    }
    return 0
}

def tc_unify(tc: TypeChecker, t1: Type, t2: Type, node: AstNode) {
    if t1 == 0 or t2 == 0 { return 0 }
    if t1.kind == "any" or t2.kind == "any" { return 0 }
    if t1.kind == "dyn" or t2.kind == "dyn" { return 0 }
    if t1.kind == "scalar" and t2.kind == "scalar" {
        if (t1.name == "int" or t1.name == "byte") and (t2.name == "int" or t2.name == "byte") { return 0 }
    }
    if t1.kind == "null" or t2.kind == "null" {
        if t1.kind == "null" and t2.kind == "scalar" and str_eq(t2.name, "int") == 1 {
            errors.err("Type", tc.filename, node.line, "expected int but got null", "null cannot be used as an integer value", node.col)
            return 0
        }
        if t2.kind == "null" and t1.kind == "scalar" and str_eq(t1.name, "int") == 1 {
            errors.err("Type", tc.filename, node.line, "expected int but got null", "null cannot be used as an integer value", node.col)
            return 0
        }
        return 0
    }
    eq = types_equal(t1, t2)
    if eq == 0 {
        errors.err("Type", tc.filename, node.line, "expected " + type_to_string(t1) + " but got " + type_to_string(t2), "change the value type or explicitly convert with int() or str()", node.col)
        return 0
    }
    return 0
}

def tc_bind_args(tc: TypeChecker, call_node: AstNode, nf: NamedFunc) -> list {
    p_names = nf.param_names
    p_defs = nf.func_defaults
    n_params = len(p_names)

    arg_names = []
    arg_is_kw = []
    if call_node.arg_names != 0 { arg_names = call_node.arg_names }
    if call_node.arg_is_kw != 0 { arg_is_kw = call_node.arg_is_kw }

    has_kw = 0
    i = 0
    while i < len(arg_is_kw) {
        if arg_is_kw[i] == 1 { has_kw = 1 }
        i = i + 1
    }

    if has_kw == 0 and len(call_node.args) == n_params {
        return call_node.args
    }

    i = 0
    while i < len(arg_names) {
        if i < len(arg_is_kw) and arg_is_kw[i] == 1 {
            kw = arg_names[i]
            found = 0
            p = 0
            while p < n_params {
                if str_eq(p_names[p], kw) == 1 { found = 1 }
                p = p + 1
            }
            if found == 0 {
                hint = suggest_param_name(p_names, kw)
                errors.err("Name", tc.filename, call_node.line, "function '" + call_node.val_str + "' got unexpected keyword argument '" + kw + "'", hint, call_node.col)
            }
        }
        i = i + 1
    }

    bound = []
    p = 0
    while p < n_params {
        p_name = p_names[p]
        val = 0

        if p < len(call_node.args) and (p >= len(arg_is_kw) or arg_is_kw[p] == 0) {
            val = call_node.args[p]
        }

        i = 0
        kw_found = 0
        while i < len(arg_names) {
            if i < len(arg_is_kw) and arg_is_kw[i] == 1 {
                if str_eq(arg_names[i], p_name) == 1 {
                    if val != 0 {
                        errors.err("Args", tc.filename, call_node.line, "function '" + call_node.val_str + "' got multiple values for argument '" + p_name + "'", "specify argument positionally or as keyword, not both", call_node.col)
                    }
                    if kw_found == 1 {
                        errors.err("Args", tc.filename, call_node.line, "duplicate keyword argument '" + p_name + "'", "remove the duplicate keyword argument", call_node.col)
                    }
                    val = call_node.args[i]
                    kw_found = 1
                }
            }
            i = i + 1
        }

        if val == 0 {
            if p < len(p_defs) and p_defs[p] != 0 {
                val = p_defs[p]
            } else {
                errors.err("Args", tc.filename, call_node.line, "function '" + call_node.val_str + "' missing required argument '" + p_name + "'", "supply a value for this parameter", call_node.col)
                val = AstNode()
                val.kind = "Number"
                val.val_int = 0
                val.line = call_node.line
            }
        }
        bound.append(val)
        p = p + 1
    }
    return bound
}

def tc_bind_method_args(tc: TypeChecker, call_node: AstNode, nf: NamedFunc) -> list {
    p_names = nf.param_names
    p_defs = nf.func_defaults
    n_params = len(p_names) - 1

    arg_names = []
    arg_is_kw = []
    if call_node.arg_names != 0 { arg_names = call_node.arg_names }
    if call_node.arg_is_kw != 0 { arg_is_kw = call_node.arg_is_kw }

    has_kw = 0
    i = 0
    while i < len(arg_is_kw) {
        if arg_is_kw[i] == 1 { has_kw = 1 }
        i = i + 1
    }

    if has_kw == 0 and len(call_node.args) == n_params {
        return call_node.args
    }

    i = 0
    while i < len(arg_names) {
        if i < len(arg_is_kw) and arg_is_kw[i] == 1 {
            kw = arg_names[i]
            found = 0
            p = 1
            while p < len(p_names) {
                if str_eq(p_names[p], kw) == 1 { found = 1 }
                p = p + 1
            }
            if found == 0 {
                hint = suggest_param_name(p_names, kw)
                errors.err("Name", tc.filename, call_node.line, "method '" + call_node.val_str + "' got unexpected keyword argument '" + kw + "'", hint, call_node.col)
            }
        }
        i = i + 1
    }

    bound = []
    p = 1
    while p < len(p_names) {
        p_name = p_names[p]
        val = 0
        arg_idx = p - 1
        if arg_idx < len(call_node.args) and (arg_idx >= len(arg_is_kw) or arg_is_kw[arg_idx] == 0) {
            val = call_node.args[arg_idx]
        }
        i = 0
        kw_found = 0
        while i < len(arg_names) {
            if i < len(arg_is_kw) and arg_is_kw[i] == 1 {
                if str_eq(arg_names[i], p_name) == 1 {
                    if val != 0 {
                        errors.err("Args", tc.filename, call_node.line, "method '" + call_node.val_str + "' got multiple values for argument '" + p_name + "'", "specify argument positionally or as keyword, not both", call_node.col)
                    }
                    if kw_found == 1 {
                        errors.err("Args", tc.filename, call_node.line, "duplicate keyword argument '" + p_name + "'", "remove the duplicate keyword argument", call_node.col)
                    }
                    val = call_node.args[i]
                    kw_found = 1
                }
            }
            i = i + 1
        }
        if val == 0 {
            if p < len(p_defs) and p_defs[p] != 0 {
                val = p_defs[p]
            } else {
                errors.err("Args", tc.filename, call_node.line, "method '" + call_node.val_str + "' missing required argument '" + p_name + "'", "supply a value for this parameter", call_node.col)
                val = AstNode()
                val.kind = "Number"
                val.val_int = 0
                val.line = call_node.line
            }
        }
        bound.append(val)
        p = p + 1
    }
    return bound
}

def tc_visit(tc: TypeChecker, node: AstNode) -> Type {
    if node == 0 { return 0 }
    if node.kind == "NONE" { return 0 }
    t = tc_visit_real(tc, node)
    node.inferred_type = t
    return t
}

def tc_visit_real(tc: TypeChecker, node: AstNode) -> Type {
    if node == 0 { return create_any_type() }
    kind_handlers = {"Number": 1, "String": 2, "Boolean": 3, "Variable": 4, "BinOp": 5, "Compare": 6, "Assignment": 7, "Function": 8, "Return": 9, "Print": 10, "PrintD": 11, "TRY": 12, "THROW": 13, "Call": 14, "IfElse": 15, "While": 16, "MethodCall": 17, "DataFieldAccess": 18, "DataFieldAssign": 19, "ArrayIndex": 20, "ArrayIndexAssign": 21, "DictLiteral": 22, "ListLiteral": 23, "RawBlock": 24, "ForLoop": 25, "ForIn": 26, "Len": 27, "SizeOf": 28, "Comptime": 29, "Block": 30, "Defer": 31, "MultiReturn": 32, "UnpackAssign": 33, "ClassDef": 34, "Null": 35, "Ternary": 36}
    h = kind_handlers.get(node.kind)
    if h == 36 {
        tc_visit(tc, node.cond)
        t_true = tc_visit(tc, node.left)
        t_false = tc_visit(tc, node.right)
        tc_unify(tc, t_true, t_false, node)
        return t_true
    }
    if h == 35 { return create_null_type() }
    if h == 1 {
        if node.is_float == 1 { return create_scalar_type("float") }
        return create_scalar_type("int")
    }
    if h == 2 { return create_scalar_type("string") }
    if h == 3 { return create_scalar_type("bool") }
    if h == 27 {
        tc_visit(tc, node.left)
        return create_scalar_type("int")
    }

    if h == 4 {
        t = tc_get_var(tc, node.val_str)
        if t == 0 {
            func_t = tc_find_func(tc, node.val_str)
            if func_t != 0 {
                return func_t
            }
            tc.pending.append([node.val_str, node.line, node.col, node])
            tc.fn_missing.set(node.val_str, 1)
            t = create_any_type()
            tc_set_var_quiet(tc, node.val_str, t)
        } elif tc.fn_missing.has(node.val_str) == 1 {
            # A later read of a name that was unresolved earlier in this function: remember this node too
            tc.pending.append([node.val_str, node.line, node.col, node])
        } elif tc.global_consts.has(node.val_str) == 1 {
            # Found as a global (module-level constant) - but a constant the inliner missed is only a global
            # variable slot nobody initialised, so decide at the end of the function (see tc_flush_pending)
            tc.pending.append([node.val_str, node.line, node.col, node])
        }
        return t
    }

    if h == 5 {
        t1 = tc_visit(tc, node.left)
        t2 = tc_visit(tc, node.right)
        tc_unify(tc, t1, t2, node)

        if str_eq(node.val_str, "+") == 1 {
            if t1 != 0 and t1.kind == "scalar" and str_eq(t1.name, "string") == 1 {
                return t1
            }
            if t2 != 0 and t2.kind == "scalar" and str_eq(t2.name, "string") == 1 {
                return t2
            }
        }
        return t1
    }

    if h == 6 {
        t1 = tc_visit(tc, node.left)
        t2 = tc_visit(tc, node.right)
        tc_unify(tc, t1, t2, node)
        return create_scalar_type("int")
    }

    if h == 7 {
        t = tc_visit(tc, node.left)
        existing = tc_get_var(tc, node.val_str)
        if existing == 0 {
            tc_set_var(tc, node.val_str, t)
        } else {
            tc_unify(tc, existing, t, node)
        }
        return 0
    }

    if h == 8 {
        tc_push_env(tc)
        prev_ret = tc.current_ret
        outer_pending = tc.pending
        outer_assigned = tc.fn_assigned
        outer_missing = tc.fn_missing
        outer_shadow = tc.shadow_calls
        tc.fn_missing = {}
        tc.shadow_calls = []
        tc.pending = []
        tc.fn_assigned = {}
        tc.fn_assigned.set("self", 1)
        pi = 0
        while pi < len(node.params) {
            tc.fn_assigned.set(node.params[pi], 1)
            pi = pi + 1
        }

        func_type = tc_find_func(tc, node.val_str)
        if func_type != 0 {
            tc.current_ret = type_ret(func_type)
            fparams = type_params(func_type)
            i = 0
            n = len(node.params)
            if len(fparams) < n { n = len(fparams) }
            while i < n {
                tc_set_var(tc, node.params[i], fparams[i])
                i = i + 1
            }
        }

        bi = 0
        while bi < len(node.body) {
            tc_visit(tc, node.body[bi])
            bi = bi + 1
        }

        tc_flush_pending(tc)
        tc.pending = outer_pending
        tc.fn_assigned = outer_assigned
        tc.fn_missing = outer_missing
        tc.shadow_calls = outer_shadow

        tc.current_ret = prev_ret
        tc_pop_env(tc)

        if func_type != 0 { return func_type }
        return create_any_type()
    }

    if h == 9 {
        t = create_any_type()
        if node != 0 and node.left != 0 {
            t = tc_visit(tc, node.left)
        }
        return t
    }

    if h == 10 {
        tc_visit(tc, node.left)
        return create_any_type()
    }

    if h == 11 {
        tc_visit(tc, node.left)
        return create_any_type()
    }

    if h == 12 {
        # parse_try_block (stdlib/parser.nv) sets .body (try body) and .else_body (catch
        # body), not .args/.cond -- those are always unset (null) for a TRY node, so
        # len(node.args)/len(node.cond) segfaulted instead of returning 0. Never caught
        # before because the self-hosted parser itself rejected every real try/catch
        # program with a syntax error until that was fixed alongside this.
        i = 0
        while i < len(node.body) {
            tc_visit(tc, node.body[i])
            i = i + 1
        }
        tc.fn_assigned.set(node.val_str, 1)
        tc_set_var(tc, node.val_str, create_any_type())
        i = 0
        while i < len(node.else_body) {
            tc_visit(tc, node.else_body[i])
            i = i + 1
        }
        return create_any_type()
    }

    if h == 13 {
        if node.left != 0 {
            tc_visit(tc, node.left)
        }
        return create_any_type()
    }

    if h == 31 {
        if node.left != 0 {
            tc_visit(tc, node.left)
        }
        if node.body != 0 {
            i = 0
            while i < len(node.body) {
                tc_visit(tc, node.body[i])
                i = i + 1
            }
        }
        return create_any_type()
    }

    if h == 14 {
        if node.val_str == "random" {
            i = 0
            while i < len(node.args) {
                tc_visit(tc, node.args[i])
                i = i + 1
            }
            return create_scalar_type("int")
        }
        if node.val_str == "chacha20_init" {
            i = 0
            while i < len(node.args) {
                tc_visit(tc, node.args[i])
                i = i + 1
            }
            return create_any_type()
        }
        if node.val_str == "mem_view" {
            if len(node.args) != 2 {
                errors.err("Args", tc.filename, node.line, "mem.view expects 2 arguments: (Type, address)", "pass Type and address", node.col)
                return create_any_type()
            }
            target_type_name = ""
            if node.args[0].kind == "Variable" {
                target_type_name = node.args[0].val_str
            } elif node.args[0].kind == "DataFieldAccess" {
                target_type_name = node.args[0].val_str
            }
            st = tc_find_struct(tc, target_type_name)
            if st == 0 {
                errors.err("Type", tc.filename, node.line, "mem.view target '" + target_type_name + "' is not a defined struct/data type", "define 'data " + target_type_name + "' first", node.col)
            }
            addr_t = tc_visit(tc, node.args[1])
            if st != 0 {
                node.inferred_type = st
                return st
            }
            return create_any_type()
        }
        if tc_find_struct(tc, node.val_str) != 0 {
            i = 0
            while i < len(node.args) {
                tc_visit(tc, node.args[i])
                i = i + 1
            }
            return tc_find_struct(tc, node.val_str)
        }
        shadow_t = tc_get_var(tc, node.val_str)
        func_type = tc_find_func(tc, node.val_str)
        if func_type != 0 and shadow_t != 0 and shadow_t.kind == "scalar" {
            # codegen calls the *variable* when one is in scope, so this used to compile and then crash at run time
            errors.err("Name", tc.filename, node.line, "cannot call '" + node.val_str + "': here it is a variable of type " + shadow_t.name + ", not the function " + node.val_str + "()", "a parameter or local named '" + node.val_str + "' hides the function; rename the variable so the call reaches the function", node.col)
            i = 0
            while i < len(node.args) {
                tc_visit(tc, node.args[i])
                i = i + 1
            }
            return create_any_type()
        }
        if func_type != 0 and shadow_t == 0 {
            tc.shadow_calls.append([node.val_str, node.line, node.col])
        }
        if func_type != 0 {
            nf = 0
            if tc.named_func_map.has(node.val_str) == 1 {
                nf = tc.named_func_map.get(node.val_str)
            }
            if nf != 0 and len(nf.param_names) > 0 {
                node.args = tc_bind_args(tc, node, nf)
            }
            fparams = type_params(func_type)
            if len(node.args) != len(fparams) {
                errors.err("Args", tc.filename, node.line, "function " + node.val_str + " expects " + str(len(fparams)) + " args but got " + str(len(node.args)), "add or remove arguments to match the declaration", node.col)
            }
            i = 0
            n = len(node.args)
            if len(fparams) < n { n = len(fparams) }
            while i < n {
                arg_t = tc_visit(tc, node.args[i])
                tc_unify(tc, fparams[i], arg_t, node.args[i])
                i = i + 1
            }
            return type_ret(func_type)
        }
        var_t = tc_get_var(tc, node.val_str)
        if var_t != 0 and var_t.kind == "func" {
            fparams = type_params(var_t)
            if len(fparams) > 0 and len(node.args) != len(fparams) {
                errors.err("Args", tc.filename, node.line, "function pointer " + node.val_str + " expects " + str(len(fparams)) + " args but got " + str(len(node.args)), "add or remove arguments to match", node.col)
            }
            i = 0
            n = len(node.args)
            if len(fparams) < n { n = len(fparams) }
            while i < n {
                arg_t = tc_visit(tc, node.args[i])
                tc_unify(tc, fparams[i], arg_t, node.args[i])
                i = i + 1
            }
            return type_ret(var_t)
        }
        # (an int variable that is not a declared function is an indirect call through a raw address: h = mem.read_u64(..); h(x))
        if var_t == 0 and tc.strict_calls == 1 and tc.global_names.has(node.val_str) == 0 and tc_is_libc_name(node.val_str) == 0 {
            errors.err("Name", tc.filename, node.line, "call to undefined function '" + node.val_str + "'", tc_suggest_func(tc, node.val_str), node.col)
        }
        i = 0
        while i < len(node.args) {
            tc_visit(tc, node.args[i])
            i = i + 1
        }
        return create_any_type()
    }

    if h == 15 {
        tc_visit(tc, node.cond)

        tc_push_env(tc)
        i = 0
        while i < len(node.body) {
            tc_visit(tc, node.body[i])
            i = i + 1
        }
        tc_pop_env(tc)

        tc_push_env(tc)
        i = 0
        while i < len(node.else_body) {
            tc_visit(tc, node.else_body[i])
            i = i + 1
        }
        tc_pop_env(tc)

        return create_any_type()
    }

    if h == 16 {
        tc_visit(tc, node.cond)
        i = 0
        while i < len(node.body) {
            tc_visit(tc, node.body[i])
            i = i + 1
        }
        return create_any_type()
    }

    if h == 30 {
        tc_push_env(tc)
        i = 0
        while i < len(node.body) {
            tc_visit(tc, node.body[i])
            i = i + 1
        }
        tc_pop_env(tc)
        return create_any_type()
    }

    if h == 17 {
        # `module.func(...)`: when the qualifier is not a variable but the member is a known function (or the
        # qualifier is a built-in intrinsic namespace) it names a module, not a value - do not report it as undefined.
        is_ns = 0
        if node.left.kind == "Variable" and tc_get_var(tc, node.left.val_str) == 0 and tc.global_names.has(node.left.val_str) == 0 {
            qn = node.left.val_str
            if qn == "cpu" or qn == "mem" or tc_find_func(tc, node.val_str) != 0 { is_ns = 1 }
        }
        inst_t = create_any_type()
        if is_ns == 0 { inst_t = tc_visit(tc, node.left) }
        if inst_t != 0 and inst_t.kind == "struct" {
            mfunc = tc_find_func(tc, inst_t.name + "." + node.val_str)
            if mfunc != 0 {
                full_mname = inst_t.name + "." + node.val_str
                nf = 0
                if tc.named_func_map.has(full_mname) == 1 {
                    nf = tc.named_func_map.get(full_mname)
                }
                if nf != 0 and len(nf.param_names) > 1 {
                    node.args = tc_bind_method_args(tc, node, nf)
                }
                mparams = type_params(mfunc)
                i = 0
                while i < len(node.args) {
                    arg_t = tc_visit(tc, node.args[i])
                    if i + 1 < len(mparams) {
                        tc_unify(tc, mparams[i + 1], arg_t, node.args[i])
                    }
                    i = i + 1
                }
                mret = type_ret(mfunc)
                if mret != 0 { return mret }
                return create_any_type()
            }
        }
        # Module-scope function call (e.g. system.get_args()): resolve the
        # declared return type so list[string]-typed results flow downstream.
        if node.left.kind == "Variable" {
            mfunc = tc_find_func(tc, node.val_str)
            if mfunc != 0 {
                nf = 0
                if tc.named_func_map.has(node.val_str) == 1 {
                    nf = tc.named_func_map.get(node.val_str)
                }
                if nf != 0 and len(nf.param_names) > 0 {
                    node.args = tc_bind_args(tc, node, nf)
                }
                mparams = type_params(mfunc)
                i = 0
                n = len(node.args)
                if len(mparams) < n { n = len(mparams) }
                while i < n {
                    arg_t = tc_visit(tc, node.args[i])
                    tc_unify(tc, mparams[i], arg_t, node.args[i])
                    i = i + 1
                }
                while i < len(node.args) {
                    tc_visit(tc, node.args[i])
                    i = i + 1
                }
                mret = type_ret(mfunc)
                if mret != 0 { return mret }
            }
        }
        i = 0
        while i < len(node.args) {
            tc_visit(tc, node.args[i])
            i = i + 1
        }
        return create_any_type()
    }

    if h == 18 {
        inst_t = tc_visit(tc, node.left)
        if inst_t != 0 and inst_t.kind == "struct" {
            field_t = tc_find_field(inst_t, node.val_str)
            if field_t != 0 { return field_t }
        }
        return create_any_type()
    }

    if h == 19 {
        inst_t = tc_visit(tc, node.left)
        right_t = tc_visit(tc, node.right)
        if inst_t != 0 and inst_t.kind == "struct" {
            field_t = tc_find_field(inst_t, node.val_str)
            if field_t != 0 {
                tc_unify(tc, field_t, right_t, node)
                return field_t
            }
        }
        return create_any_type()
    }

    if h == 20 {
        base_t = tc_visit(tc, node.left)
        idx_t = tc_visit(tc, node.right)
        if base_t != 0 {
            if base_t.kind == "list" {
                if base_t.element_type != 0 { return base_t.element_type }
            }
            if base_t.kind == "dict" {
                if node.right.kind == "String" and base_t.field_names != 0 {
                    k = 0
                    while k < len(base_t.field_names) {
                        if str_eq(base_t.field_names[k], node.right.val_str) == 1 {
                            res_t = base_t.fields[k]
                            node.inferred_type = res_t
                            return res_t
                        }
                        k = k + 1
                    }
                }
                if base_t.element_type != 0 {
                    node.inferred_type = base_t.element_type
                    return base_t.element_type
                }
            }
        }
        return create_any_type()
    }

    if h == 21 {
        base_t = tc_visit(tc, node.left)
        right_t = tc_visit(tc, node.right)
        cond_t = tc_visit(tc, node.cond)
        if base_t != 0 and base_t.kind == "list" {
            tc_unify(tc, base_t.element_type, cond_t, node)
        }
        return create_any_type()
    }
    if h == 22 {
        dt = create_dict_type()
        i = 0
        has_str_val = 0
        has_other_val = 0
        while i < len(node.args) {
            kt = tc_visit(tc, node.args[i])
            if i + 1 < len(node.args) {
                vt = tc_visit(tc, node.args[i + 1])
                if node.args[i].kind == "String" {
                    dt.field_names.append(node.args[i].val_str)
                    dt.fields.append(vt)
                }
                if vt != 0 and vt.kind == "scalar" and str_eq(vt.name, "string") == 1 {
                    has_str_val = 1
                } else {
                    has_other_val = 1
                }
            }
            i = i + 2
        }
        if has_str_val == 1 and has_other_val == 0 {
            dt.element_type = create_scalar_type("string")
        }
        node.inferred_type = dt
        return dt
    }

    if h == 23 {
        elem_t = create_any_type()
        is_het = 0
        i = 0
        while i < len(node.args) {
            t = tc_visit(tc, node.args[i])
            if is_het == 0 {
                if elem_t.kind == "any" {
                    elem_t = t
                } else {
                    if types_equal(elem_t, t) == 0 {
                        elem_t = create_any_type()
                        is_het = 1
                    }
                }
            }
            i = i + 1
        }
        return create_list_type(elem_t)
    }

    if h == 24 {
        i = 0
        while i < len(node.body) {
            tc_visit(tc, node.body[i])
            i = i + 1
        }
        return create_any_type()
    }

    if h == 25 {
        tc_push_env(tc)
        tc_set_var(tc, node.val_str, create_scalar_type("int"))
        i = 0
        while i < len(node.body) {
            tc_visit(tc, node.body[i])
            i = i + 1
        }
        tc_pop_env(tc)
        return create_any_type()
    }

    if h == 26 {
        tc_push_env(tc)
        coll_t = tc_visit(tc, node.left)
        loop_t = create_any_type()
        if coll_t != 0 and coll_t.kind == "list" {
            loop_t = coll_t.element_type
        }
        tc_set_var(tc, node.val_str, loop_t)
        i = 0
        while i < len(node.body) {
            tc_visit(tc, node.body[i])
            i = i + 1
        }
        tc_pop_env(tc)
        return create_any_type()
    }

    if h == 28 {
        if node.left != 0 { tc_visit(tc, node.left) }
        return create_scalar_type("int")
    }

    if h == 29 {
        if node.left != 0 { return tc_visit(tc, node.left) }
        return create_any_type()
    }

    if h == 32 {
        # parse_statement's RETURN handling (stdlib/parser.nv) puts `return a, b, c`'s values in
        # node.args (reusing the generic list field, same as TRY reuses else_body). Each value is
        # just a normal expression; there's no single result type for the statement itself.
        i = 0
        while i < len(node.args) {
            tc_visit(tc, node.args[i])
            i = i + 1
        }
        return create_any_type()
    }

    if h == 33 {
        # `a, b = f()` -- node.args holds the target expressions, node.left the RHS call. Targets
        # get `any` rather than the call's own return type: the self-hosted type system has no
        # per-component type for a multi-return call (func_returns' comma-joined "(int,string)"
        # string isn't a Type), and `any` matches what codegen already assumes for them.
        tc_visit(tc, node.left)
        i = 0
        while i < len(node.args) {
            target = node.args[i]
            if target.kind == "Variable" and str_eq(target.val_str, "_") == 0 {
                existing = tc_get_var(tc, target.val_str)
                if existing == 0 {
                    tc_set_var(tc, target.val_str, create_any_type())
                }
            }
            i = i + 1
        }
        return create_any_type()
    }

    if h == 34 {
        inst_t = tc_find_struct(tc, node.val_str)
        outer_shadow_cls = tc.shadow_calls
        tc.shadow_calls = []
        m_idx = 0
        while m_idx < len(node.methods) {
            m = node.methods[m_idx]
            tc_push_env(tc)
            if inst_t != 0 {
                tc_set_var(tc, "self", inst_t)
            }
            j = 0
            while j < len(m.params) {
                pname = m.params[j]
                if pname != "self" {
                    ptype = resolve_type_annotation(m.param_types[j])
                    tc_set_var(tc, pname, ptype)
                }
                j = j + 1
            }
            k = 0
            while k < len(m.body) {
                tc_visit(tc, m.body[k])
                k = k + 1
            }
            tc_pop_env(tc)
            m_idx = m_idx + 1
        }
        tc.shadow_calls = outer_shadow_cls
        return create_scalar_type("void")
    }

    # Builtin file I/O (`open`/`read`/`write`/`close`) has real result types. Without these the
    # generic fallback below types `data = read(fd)` as `any`, so codegen never marks `data` as a
    # string and later string operations on it silently miscompile.
    if node.kind == "OpenFile" {
        tc_visit(tc, node.left)
        tc_visit(tc, node.right)
        return create_scalar_type("int")
    }
    if node.kind == "ReadFile" {
        tc_visit(tc, node.left)
        return create_scalar_type("string")
    }
    if node.kind == "WriteFile" {
        tc_visit(tc, node.left)
        tc_visit(tc, node.right)
        return create_any_type()
    }
    if node.kind == "CloseFile" {
        tc_visit(tc, node.left)
        return create_any_type()
    }

    # Kinds without a dedicated handler still contain expressions (e.g. str(node.line)). Visit the
    # children so they get inferred types; otherwise the backend can't tell which struct a field
    # access like node.line belongs to and falls back to the first struct that has such a field.
    k = node.kind
    if k == "StrConvert" or k == "UnaryOp" or k == "Slice" or k == "Alloc" or k == "Free" or k == "PointerProperty" or k == "PointerAssign" or k == "ReadFile" or k == "WriteFile" or k == "Openf" or k == "CloseFile" or k == "Spawn" or k == "Await" {
        tc_visit(tc, node.left)
        tc_visit(tc, node.right)
        tc_visit(tc, node.cond)
        if node.args != 0 {
            i = 0
            while i < len(node.args) {
                tc_visit(tc, node.args[i])
                i = i + 1
            }
        }
    }

    # Default fallback
    return create_any_type()
}
def tc_link_struct(tc: TypeChecker, t: Type, seen: list) -> Type {
    # Recursively replace field-less StructType stubs with the registered struct
    # seen is a list of Type pointers we've already visited to handle cycles
    i = 0
    while i < len(seen) {
        if seen[i] == t { return t }
        i = i + 1
    }
    seen.append(t)

    if t == 0 { return 0 }
    if t.kind == "struct" {
        # Look up the registered struct
        reg = tc_find_struct_by_name(tc, t.name)
        if reg != 0 and reg != t {
            return tc_link_struct(tc, reg, seen)
        }
        # Link fields
        if t.fields != 0 {
            j = 0
            while j < len(t.fields) {
                t.fields[j] = tc_link_struct(tc, t.fields[j], seen)
                j = j + 1
            }
        }
        return t
    }
    if t.kind == "list" {
        t.element_type = tc_link_struct(tc, t.element_type, seen)
        return t
    }
    if t.kind == "func" {
        j = 0
        while j < len(t.params) {
            t.params[j] = tc_link_struct(tc, t.params[j], seen)
            j = j + 1
        }
        t.ret = tc_link_struct(tc, t.ret, seen)
        return t
    }
    return t
}

def tc_find_struct_by_name(tc: TypeChecker, name: string) -> Type {
    i = 0
    while i < len(tc.structs) {
        if tc.structs[i].name == name { return tc.structs[i] }
        i = i + 1
    }
    return 0
}

def tc_link_all_structs(tc: TypeChecker) {
    return
}

def tc_find_field(t: Type, name: string) -> Type {
    if t == 0 or t.kind != "struct" { return 0 }
    i = 0
    while i < len(t.fields) {
        if t.field_names != 0 and i < len(t.field_names) {
            if t.field_names[i] == name {
                return t.fields[i]
            }
        }
        i = i + 1
    }
    return 0
}

def tc_check(tc: TypeChecker, ast: list) {
    tc_push_env(tc)

    # Pass 1: Collect structs
    i = 0
    while i < len(ast) {
        stmt = ast[i]
        if stmt.kind == "Data" or stmt.kind == "ClassDef" {
            t = create_struct_type(stmt.val_str)
            tc_add_struct(tc, t)
        }
        i = i + 1
    }

    # Pass 1.1: Collect functions
    i = 0
    while i < len(ast) {
        stmt = ast[i]
        if stmt.kind == "Function" {
            params = []
            j = 0
            while j < len(stmt.param_types) {
                params.append(resolve_type_annotation(stmt.param_types[j]))
                j = j + 1
            }
            ret_type = resolve_type_annotation(stmt.return_type)
            func_type = create_func_type(params, ret_type)
            p_defs = []
            if stmt.param_defaults != 0 { p_defs = stmt.param_defaults }
            tc_add_func_full(tc, stmt.val_str, func_type, stmt.params, p_defs)
        }
        if stmt.kind == "ClassDef" {
            j = 0
            while j < len(stmt.methods) {
                m = stmt.methods[j]
                params = []
                k = 0
                while k < len(m.param_types) {
                    params.append(resolve_type_annotation(m.param_types[k]))
                    k = k + 1
                }
                ret_type = resolve_type_annotation(m.return_type)
                func_type = create_func_type(params, ret_type)
                full = stmt.val_str + "." + m.val_str
                p_defs = []
                if m.param_defaults != 0 { p_defs = m.param_defaults }
                tc_add_func_full(tc, full, func_type, m.params, p_defs)
                mangled = stmt.val_str + "_" + m.val_str
                tc_add_func_full(tc, mangled, func_type, m.params, p_defs)
                j = j + 1
            }
        }
        i = i + 1
    }

    # Pass 1.5: Resolve struct fields (Data/ClassDef store fields in params/param_types)
    i = 0
    while i < len(ast) {
        stmt = ast[i]
        if stmt.kind == "Data" or stmt.kind == "ClassDef" {
            t = tc_find_struct(tc, stmt.val_str)
            if t != 0 {
                j = 0
                while j < len(stmt.params) {
                    field_name = stmt.params[j]
                    field_type_str = stmt.param_types[j]
                    t.fields.append(resolve_type_annotation(field_type_str))
                    t.field_names.append(field_name)
                    j = j + 1
                }
            }
        }
        i = i + 1
    }

    # Pass 1.6: Link struct types (replace stubs with registered structs)
    tc_link_all_structs(tc)

    # Pass 1.7: global names (top-level assignments and consts, in any order)
    i = 0
    while i < len(ast) {
        stmt = ast[i]
        if stmt.kind == "Assignment" {
            tc.global_names.set(stmt.val_str, 1)
            tc_note_name(tc, stmt.val_str)
            if stmt.val_int == 1 and stmt.left != 0 {
                if stmt.left.kind == "Number" and stmt.left.is_float == 0 {
                    tc.global_consts.set(stmt.val_str, stmt.left.val_int)
                }
            }
        }
        i = i + 1
    }

    # Pass 2: Infer everything. Diagnostics name the file a function was written in (not the file being built),
    # and calls to undefined functions are only reported in user code: the standard library reaches C runtime
    # entry points that the code generator resolves itself.
    main_file = tc.filename
    i = 0
    while i < len(ast) {
        stmt = ast[i]
        stmt_file = ""
        if stmt.kind == "Function" { stmt_file = stmt.file }
        if stmt.kind == "ClassDef" and stmt.methods != 0 and len(stmt.methods) > 0 { stmt_file = stmt.methods[0].file }
        if stmt_file != "" {
            tc.filename = stmt_file
        } else {
            tc.filename = main_file
        }
        tc.strict_calls = 1
        if str_contains(tc.filename, "stdlib") == 1 { tc.strict_calls = 0 }
        tc_visit(tc, stmt)
        i = i + 1
    }
    tc.filename = main_file
    tc_flush_pending(tc)
    tc_pop_env(tc)
}
