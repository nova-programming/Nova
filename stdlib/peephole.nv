def apply(state) {
    lines = state.asm_lines
    result = []
    i = 0
    while i < len(lines) {
        line = lines[i]
        
        if i + 1 < len(lines) {
            nxt = lines[i + 1]
            
            if len(line) >= 10 and len(nxt) >= 9 {
                if (line == "    push eax" and nxt == "    pop eax") or (line == "    push rax" and nxt == "    pop rax") {
                    i = i + 2
                    continue
                }
                if (line == "    push eax" and nxt == "    pop ebx") or (line == "    push rax" and nxt == "    pop rbx") {
                    result.append("    mov rbx, rax")
                    i = i + 2
                    continue
                }
                if (line == "    push rbx" and nxt == "    pop rax") or (line == "    push rbx" and nxt == "    pop eax") {
                    result.append("    mov rax, rbx")
                    i = i + 2
                    continue
                }
                # Simple duplicate mov rax, rax check
                if line == "    mov rax, rax" or line == "    mov rbx, rbx" {
                    i = i + 1
                    continue
                }
                # Redundant xor rax, rax to 0
                if line == "    xor rax, rax" {
                    result.append("    mov rax, 0")
                    i = i + 1
                    continue
                }
                # Redundant mov between same registers (mov rax, rbx; mov rbx, rax)
                if i + 2 < len(lines) {
                    nxt2 = lines[i + 2]
                    if line == "    mov rax, rbx" and nxt == "    mov rbx, rax" {
                        i = i + 3
                        continue
                    }
                    if line == "    mov rbx, rax" and nxt == "    mov rax, rbx" {
                        i = i + 3
                        continue
                    }
                }
                # Algebraic simplifications: add reg, 0
                if line == "    add rax, 0" or line == "    add rbx, 0" or line == "    add rcx, 0" or line == "    add rdx, 0" {
                    i = i + 1
                    continue
                }
                # imul reg, 1 -> nop
                if line == "    imul rax, 1" or line == "    imul rbx, 1" {
                    i = i + 1
                    continue
                }
                # imul reg, 2 -> shl reg, 1
                if line == "    imul rax, 2" {
                    result.append("    shl rax, 1")
                    i = i + 1
                    continue
                }
                if line == "    imul rbx, 2" {
                    result.append("    shl rbx, 1")
                    i = i + 1
                    continue
                }
                # Redundant jump to next label
                if len(line) > 8 and len(nxt) > 1 {
                    prefix = str_sub(line, 0, 8)
                    if prefix == "    jmp " {
                        target = str_sub(line, 8, len(line))
                        nxt_body = str_sub(nxt, 0, len(nxt) - 1)
                        want = target + ":"
                        if nxt_body == want {
                            i = i + 1
                            continue
                        }
                    }
                }
            }
        }
        
        result.append(line)
        i = i + 1
    }
    state.asm_lines = result
}
