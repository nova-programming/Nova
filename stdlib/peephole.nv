# ============================================================
# Nova x86_64 peephole optimizer (stdlib/peephole.nv)
# ============================================================
# Operates on emitted assembly lines (Intel syntax, 4-space indented
# instructions). Every rule is semantics- and flags-preserving:
#   push R ; pop R          -> (removed)
#   push A ; pop B          -> mov B, A        (A, B general-purpose 64-bit)
#   mov A, A                -> (removed)
#   mov A, B ; mov B, A     -> mov A, B
#   jmp L ; L:              -> L:
#   <ret|jmp> ; <instr>...  -> instructions up to the next label are unreachable
# ============================================================

def gp_regs() -> dict {
    return {"rax": 1, "rbx": 1, "rcx": 1, "rdx": 1, "rsi": 1, "rdi": 1, "r8": 1, "r9": 1, "r10": 1, "r11": 1, "r12": 1, "r13": 1, "r14": 1, "r15": 1}
}

def find_comma(s: string) -> int {
    i = 0
    while i < len(s) {
        if s[i] == "," { return i }
        i = i + 1
    }
    return -1
}

def is_instruction(line: string) -> int {
    if len(line) > 5 {
        if str_sub(line, 0, 4) == "    " {
            if line[4] != "." { return 1 }
        }
    }
    return 0
}

def optimize_pass(lines: list, regs: dict) -> list {
    result = []
    n = len(lines)
    i = 0
    dead = 0
    while i < n {
        line = lines[i]

        if dead == 1 {
            if is_instruction(line) == 1 {
                i = i + 1
                continue
            }
            dead = 0
        }

        if i + 1 < n {
            nxt = lines[i + 1]

            if len(line) > 9 and len(nxt) > 8 {
                if str_sub(line, 0, 9) == "    push " and str_sub(nxt, 0, 8) == "    pop " {
                    a = str_sub(line, 9, len(line))
                    b = str_sub(nxt, 8, len(nxt))
                    if regs.has(a) and regs.has(b) {
                        if a != b {
                            result.append("    mov " + b + ", " + a)
                        }
                        i = i + 2
                        continue
                    }
                }
            }

            if len(line) > 8 and len(nxt) > 8 {
                if str_sub(line, 0, 8) == "    mov " and str_sub(nxt, 0, 8) == "    mov " {
                    ca = find_comma(line)
                    cb = find_comma(nxt)
                    if ca > 0 and cb > 0 {
                        d1 = str_sub(line, 8, ca)
                        s1 = str_sub(line, ca + 2, len(line))
                        d2 = str_sub(nxt, 8, cb)
                        s2 = str_sub(nxt, cb + 2, len(nxt))
                        if regs.has(d1) and regs.has(s1) and d1 == s2 and s1 == d2 {
                            result.append(line)
                            i = i + 2
                            continue
                        }
                    }
                }
            }

            if len(line) > 8 and len(nxt) > 1 {
                if str_sub(line, 0, 8) == "    jmp " {
                    target = str_sub(line, 8, len(line))
                    want = str_sub(nxt, 0, len(nxt) - 1)
                    if want + ":" == nxt and want == target {
                        i = i + 1
                        continue
                    }
                }
            }
        }

        if len(line) > 8 and str_sub(line, 0, 8) == "    mov " {
            c = find_comma(line)
            if c > 0 {
                d = str_sub(line, 8, c)
                s = str_sub(line, c + 2, len(line))
                if d == s and regs.has(d) {
                    i = i + 1
                    continue
                }
            }
        }

        result.append(line)
        if line == "    ret" {
            dead = 1
        } elif len(line) > 8 {
            if str_sub(line, 0, 8) == "    jmp " { dead = 1 }
        }
        i = i + 1
    }
    return result
}

def optimize(lines: list) -> list {
    regs = gp_regs()
    out = optimize_pass(lines, regs)
    out = optimize_pass(out, regs)
    return out
}
