# ============================================================
# Nova x86_64 peephole optimizer (stdlib/peephole.nv)
# ============================================================
# Operates on emitted assembly lines (Intel syntax, 4-space indented
# instructions). Every rule is semantics- and flags-preserving:
#   push R ; pop R          -> (removed)
#   push A ; pop B          -> mov B, A        (A, B general-purpose 64-bit)
#   mov A, A                -> (removed)
#   mov A, B ; mov B, A     -> mov A, B
#   jmp L ; L:              -> L:
#   <ret|jmp> ; <instr>...  -> instructions up to the next label are unreachable
#   cmp ; setCC al ; movzx rax, al ; cmp rax, 0 ; je/jne L   -> cmp ; jCC' L
#       (only when L is an if/while exit label, where rax is dead)
# ============================================================

def gp_regs() -> dict {
    return {"rax": 1, "rbx": 1, "rcx": 1, "rdx": 1, "rsi": 1, "rdi": 1, "r8": 1, "r9": 1, "r10": 1, "r11": 1, "r12": 1, "r13": 1, "r14": 1, "r15": 1}
}

def find_comma(s: string) -> int {
    i = 0
    while i < len(s) {
        if s[i] == "," { return i }
        i = i + 1
    }
    return -1
}

def is_instruction(line: string) -> int {
    if len(line) > 5 {
        if str_sub(line, 0, 4) == "    " {
            if line[4] != "." { return 1 }
        }
    }
    return 0
}

# Condition code suffix of `setCC al`, or "" when the line is not one.
def set_condition(line: string) -> string {
    n = len(line)
    if n > 10 and str_sub(line, 0, 7) == "    set" and str_sub(line, n - 3, n) == " al" {
        return str_sub(line, 7, n - 3)
    }
    return ""
}

def invert_condition(cc: string) -> string {
    if cc == "e" { return "ne" }
    if cc == "ne" { return "e" }
    if cc == "l" { return "ge" }
    if cc == "ge" { return "l" }
    if cc == "le" { return "g" }
    if cc == "g" { return "le" }
    if cc == "b" { return "ae" }
    if cc == "ae" { return "b" }
    if cc == "be" { return "a" }
    if cc == "a" { return "be" }
    return ""
}

# if/while exit labels: rax is not read after jumping there (and/or labels do read it)
def is_stmt_exit_label(label: string) -> int {
    if len(label) > 7 and str_sub(label, 0, 7) == "L_else_" { return 1 }
    if len(label) > 11 and str_sub(label, 0, 11) == "L_loop_end_" { return 1 }
    return 0
}

def optimize_pass(lines: list, regs: dict) -> list {
    result = []
    n = len(lines)
    i = 0
    dead = 0
    while i < n {
        line = lines[i]

        if dead == 1 {
            if is_instruction(line) == 1 {
                i = i + 1
                continue
            }
            dead = 0
        }

        if i + 4 < n {
            if len(line) > 7 and str_sub(line, 0, 7) == "    cmp" {
                cc = set_condition(lines[i + 1])
                if len(cc) > 0 and lines[i + 2] == "    movzx rax, al" and lines[i + 3] == "    cmp rax, 0" {
                    jump_line = lines[i + 4]
                    jump_taken_when_false = 0
                    target = ""
                    if len(jump_line) > 7 and str_sub(jump_line, 0, 7) == "    je " {
                        jump_taken_when_false = 1
                        target = str_sub(jump_line, 7, len(jump_line))
                    } elif len(jump_line) > 8 and str_sub(jump_line, 0, 8) == "    jne " {
                        target = str_sub(jump_line, 8, len(jump_line))
                    }
                    if len(target) > 0 and is_stmt_exit_label(target) == 1 {
                        final_cc = cc
                        if jump_taken_when_false == 1 { final_cc = invert_condition(cc) }
                        if len(final_cc) > 0 {
                            result.append(line)
                            result.append("    j" + final_cc + " " + target)
                            i = i + 5
                            continue
                        }
                    }
                }
            }
        }

        if i + 1 < n {
            nxt = lines[i + 1]

            if len(line) > 9 and len(nxt) > 8 {
                if str_sub(line, 0, 9) == "    push " and str_sub(nxt, 0, 8) == "    pop " {
                    a = str_sub(line, 9, len(line))
                    b = str_sub(nxt, 8, len(nxt))
                    if regs.has(a) and regs.has(b) {
                        if a != b {
                            result.append("    mov " + b + ", " + a)
                        }
                        i = i + 2
                        continue
                    }
                }
            }

            if len(line) > 8 and len(nxt) > 8 {
                if str_sub(line, 0, 8) == "    mov " and str_sub(nxt, 0, 8) == "    mov " {
                    ca = find_comma(line)
                    cb = find_comma(nxt)
                    if ca > 0 and cb > 0 {
                        d1 = str_sub(line, 8, ca)
                        s1 = str_sub(line, ca + 2, len(line))
                        d2 = str_sub(nxt, 8, cb)
                        s2 = str_sub(nxt, cb + 2, len(nxt))
                        if regs.has(d1) and regs.has(s1) and d1 == s2 and s1 == d2 {
                            result.append(line)
                            i = i + 2
                            continue
                        }
                    }
                }
            }

            if len(line) > 8 and len(nxt) > 1 {
                if str_sub(line, 0, 8) == "    jmp " {
                    target = str_sub(line, 8, len(line))
                    want = str_sub(nxt, 0, len(nxt) - 1)
                    if want + ":" == nxt and want == target {
                        i = i + 1
                        continue
                    }
                }
            }
        }

        if len(line) > 8 and str_sub(line, 0, 8) == "    mov " {
            c = find_comma(line)
            if c > 0 {
                d = str_sub(line, 8, c)
                s = str_sub(line, c + 2, len(line))
                if d == s and regs.has(d) {
                    i = i + 1
                    continue
                }
            }
        }

        result.append(line)
        if line == "    ret" {
            dead = 1
        } elif len(line) > 8 {
            if str_sub(line, 0, 8) == "    jmp " { dead = 1 }
        }
        i = i + 1
    }
    return result
}

def optimize(lines: list) -> list {
    regs = gp_regs()
    out = optimize_pass(lines, regs)
    out = optimize_pass(out, regs)
    return out
}
