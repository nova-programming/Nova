# Portable time helpers.
import system

extern def time_now_us() -> int
extern def time_now_ms() -> int
extern def sleep_ms(ms: int)

# Defined as time_now (not `now`): `now()` is also the builtin, which this wrapper calls.
def time_now() -> string {
    return now()
}

def ticks() -> int {
    return get_tick_count()
}

def nowUs() -> int {
    return time_now_us()
}

def nowMs() -> int {
    return time_now_ms()
}

def sleep(durationMs: int) {
    sleep_ms(durationMs)
}
