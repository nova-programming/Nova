# Portable time helpers.
import system

extern def time_now_us() -> int
extern def time_now_ms() -> int
extern def sleep_ms(ms: int)

def time_now() -> string {
    return now()
}

def time_ticks_ms() -> int {
    return get_tick_count()
}

def now_us() -> int {
    return time_now_us()
}

def now_ms() -> int {
    return time_now_ms()
}

def sleep(ms: int) {
    sleep_ms(ms)
}
