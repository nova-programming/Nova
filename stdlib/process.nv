# Process boundary. `exit` is portable; shell execution is explicit.
import system
import text

def exit(exitCode: int) {
    system_exit(exitCode)
}

def shell(commandString: string) {
    system_exec(commandString)
}

def run(commandArgs: list) -> int {
    return system_process_run(commandArgs)
}

# Runs `commandString` through the shell and captures its stdout, same as shell but
# returning the output instead of running inherited to this process's own stdio.
#
# Returns the raw "<exit_code>\n<captured stdout>" the runtime encodes into one string.
def capture(commandString: string) -> string {
    return system_process_capture(commandString)
}

# The captured stdout from a capture() result.
def captureOutput(rawResult: string) -> string {
    nl = text.indexOf(rawResult, "\n")
    if nl < 0 { return "" }
    return str_sub(rawResult, nl + 1, len(rawResult))
}

# The exit code from a capture() result.
def captureCode(rawResult: string) -> int {
    nl = text.indexOf(rawResult, "\n")
    if nl < 0 { return -1 }
    return text.toInt(str_sub(rawResult, 0, nl))
}
