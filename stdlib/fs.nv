# Simple cross-platform filesystem API.
# Operations return 1/0 for success where the runtime exposes status, and
# empty/zero values for failed reads or metadata queries.
import system

def exists(filePath: string) -> int {
    return file_exists(filePath)
}

def size(filePath: string) -> int {
    return file_size(filePath)
}

def kind(filePath: string) -> string {
    return file_type(filePath)
}

def makeDir(directoryPath: string) -> int {
    return file_mkdir(directoryPath)
}

def delete(targetPath: string) -> int {
    return file_delete(targetPath)
}

def listDir(directoryPath: string) -> list[string] {
    return file_listdir(directoryPath)
}

def copy(sourcePath: string, destinationPath: string) -> int {
    return file_copy(sourcePath, destinationPath)
}

def move(sourcePath: string, destinationPath: string) -> int {
    return file_move(sourcePath, destinationPath)
}

def read(filePath: string) -> string {
    fd = file_open(filePath, "r")
    if fd == 0 {
        return ""
    }
    value = file_read(fd)
    file_close(fd)
    return value
}

def write(filePath: string, fileContent: string) -> int {
    fd = file_open(filePath, "w")
    if fd == 0 {
        return 0
    }
    file_write(fd, fileContent)
    file_close(fd)
    return 1
}

# Atomic file write: writes payload to a temporary file then atomically renames to target
def writeAtomic(filePath: string, fileContent: string) -> int {
    tmp_path = filePath + ".tmp"
    ok = write(tmp_path, fileContent)
    if ok == 0 {
        return 0
    }
    res = move(tmp_path, filePath)
    if res == 0 {
        delete(filePath)
        res = move(tmp_path, filePath)
    }
    return res
}
