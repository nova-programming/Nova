# ============================================================
# Nova System Library (stdlib/system.nv)
# Clean, Cross-Platform OS Abstractions
# ============================================================

import os_impl

def file_open(path: string, mode: string) -> int {
    return os_impl.sys_open(path, mode)
}

def file_read(fd: int) -> string {
    return os_impl.sys_read(fd)
}

def file_write(fd: int, content) {
    os_impl.sys_write(fd, content)
}

def file_write_raw(fd: int, content: list) {
    os_impl.sys_write_raw(fd, content)
}

def file_close(fd: int) {
    os_impl.sys_close(fd)
}

def file_mkdir(path: string) -> int {
    return os_impl.sys_mkdir(path)
}

def file_delete(path: string) -> int {
    return os_impl.sys_delete(path)
}

def file_copy(source: string, destination: string) -> int {
    return os_impl.sys_copy(source, destination)
}

def file_move(source: string, destination: string) -> int {
    return os_impl.sys_move(source, destination)
}

def system_alloc(size: int) -> int {
    return os_impl.sys_alloc(size)
}

def system_free(ptr: int) {
    os_impl.sys_free(ptr)
}

def platform() -> string {
    return os_impl.sys_platform()
}

def flush() {
    os_impl.sys_flush()
}

def get_args() -> list[string] {
    return os_impl.sys_get_args()
}

def get_tick_count() -> int {
    return os_impl.sys_get_tick_count()
}

def system_env_get(name: string) -> string {
    return os_impl.sys_env_get(name)
}

def system_env_set(name: string, value: string) -> int {
    return os_impl.sys_env_set(name, value)
}


def system_exit(code: int) {
    os_impl.sys_exit(code)
}


def system_exec(cmd: string) {
    os_impl.sys_system(cmd)
}

def system_process_run(args: list) -> int {
    return os_impl.sys_process_run(args)
}
