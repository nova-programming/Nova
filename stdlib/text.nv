# Portable text helpers (use as `import text` then `text.trim(s)`).
# Written in plain Nova so behavior is identical in the VM and in native builds.

def toInt(targetString: string) -> int {
    n = len(targetString)
    i = 0
    while i < n and (targetString[i] == " " or targetString[i] == "\t" or targetString[i] == "\n" or targetString[i] == "\r") {
        i = i + 1
    }
    negative = 0
    if i < n and targetString[i] == "-" {
        negative = 1
        i = i + 1
    } elif i < n and targetString[i] == "+" {
        i = i + 1
    }
    result = 0
    zero = char_code("0", 0)
    while i < n {
        ch = targetString[i]
        if ch < "0" or ch > "9" { break }
        result = result * 10 + (char_code(ch, 0) - zero)
        i = i + 1
    }
    if negative == 1 { return 0 - result }
    return result
}

def isSpace(charString: string) -> int {
    if charString == " " or charString == "\t" or charString == "\n" or charString == "\r" { return 1 }
    return 0
}

def trim(targetString: string) -> string {
    start = 0
    end = len(targetString)
    while start < end and isSpace(targetString[start]) == 1 {
        start = start + 1
    }
    while end > start and isSpace(targetString[end - 1]) == 1 {
        end = end - 1
    }
    return str_sub(targetString, start, end)
}

def startsWith(targetString: string, prefixString: string) -> int {
    n = len(prefixString)
    if n > len(targetString) { return 0 }
    if str_sub(targetString, 0, n) == prefixString { return 1 }
    return 0
}

def endsWith(targetString: string, suffixString: string) -> int {
    n = len(suffixString)
    total = len(targetString)
    if n > total { return 0 }
    if str_sub(targetString, total - n, total) == suffixString { return 1 }
    return 0
}

# Index of the first occurrence of needle in s, or -1.
def indexOf(targetString: string, searchTarget: string) -> int {
    n = len(searchTarget)
    total = len(targetString)
    if n == 0 { return 0 }
    i = 0
    while i + n <= total {
        if str_sub(targetString, i, i + n) == searchTarget { return i }
        i = i + 1
    }
    return -1
}

def contains(targetString: string, searchTarget: string) -> int {
    if indexOf(targetString, searchTarget) >= 0 { return 1 }
    return 0
}

def replace(targetString: string, oldSubstring: string, replacementString: string) -> string {
    n = len(oldSubstring)
    if n == 0 { return targetString }
    total = len(targetString)
    result = ""
    i = 0
    while i < total {
        if i + n <= total and str_sub(targetString, i, i + n) == oldSubstring {
            result = result + replacementString
            i = i + n
        } else {
            result = result + targetString[i]
            i = i + 1
        }
    }
    return result
}

def split(targetString: string, separatorString: string) -> list[string] {
    parts = []
    n = len(separatorString)
    total = len(targetString)
    if n == 0 {
        parts.append(targetString)
        return parts
    }
    start = 0
    i = 0
    while i + n <= total {
        if str_sub(targetString, i, i + n) == separatorString {
            parts.append(str_sub(targetString, start, i))
            i = i + n
            start = i
        } else {
            i = i + 1
        }
    }
    parts.append(str_sub(targetString, start, total))
    return parts
}

def join(stringParts: list[string], separatorString: string) -> string {
    result = ""
    i = 0
    while i < len(stringParts) {
        if i > 0 { result = result + separatorString }
        result = result + stringParts[i]
        i = i + 1
    }
    return result
}

def repeat(targetString: string, repeatCount: int) -> string {
    result = ""
    i = 0
    while i < repeatCount {
        result = result + targetString
        i = i + 1
    }
    return result
}

def swapCase(targetString: string, fromSet: string, toSet: string) -> string {
    result = ""
    i = 0
    while i < len(targetString) {
        ch = targetString[i]
        k = indexOf(fromSet, ch)
        if k >= 0 {
            result = result + str_sub(toSet, k, k + 1)
        } else {
            result = result + ch
        }
        i = i + 1
    }
    return result
}

def upper(targetString: string) -> string {
    return swapCase(targetString, "abcdefghijklmnopqrstuvwxyz", "ABCDEFGHIJKLMNOPQRSTUVWXYZ")
}

def lower(targetString: string) -> string {
    return swapCase(targetString, "ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz")
}

# Split on runs of whitespace ("  a  b " -> ["a", "b"]).
def words(targetString: string) -> list[string] {
    parts = []
    n = len(targetString)
    i = 0
    while i < n {
        while i < n and isSpace(targetString[i]) == 1 {
            i = i + 1
        }
        if i >= n { break }
        start = i
        while i < n and isSpace(targetString[i]) == 0 {
            i = i + 1
        }
        parts.append(str_sub(targetString, start, i))
    }
    return parts
}

# Split on newlines like Python's splitlines (a trailing newline adds no empty last line; \r is dropped).
def lines(targetString: string) -> list[string] {
    parts = []
    n = len(targetString)
    start = 0
    i = 0
    while i < n {
        if targetString[i] == "\n" {
            stop = i
            if stop > start and targetString[stop - 1] == "\r" { stop = stop - 1 }
            parts.append(str_sub(targetString, start, stop))
            start = i + 1
        }
        i = i + 1
    }
    if start < n { parts.append(str_sub(targetString, start, n)) }
    return parts
}

def padLeft(targetString: string, targetWidth: int, fillChar: string) -> string {
    if len(fillChar) == 0 { fillChar = " " }
    missing = targetWidth - len(targetString)
    if missing <= 0 { return targetString }
    return repeat(str_sub(fillChar, 0, 1), missing) + targetString
}

def padRight(targetString: string, targetWidth: int, fillChar: string) -> string {
    if len(fillChar) == 0 { fillChar = " " }
    missing = targetWidth - len(targetString)
    if missing <= 0 { return targetString }
    return targetString + repeat(str_sub(fillChar, 0, 1), missing)
}

# Non-overlapping occurrences of part in s (0 when part is empty).
def count(targetString: string, searchPart: string) -> int {
    n = len(searchPart)
    total = len(targetString)
    if n == 0 { return 0 }
    found = 0
    i = 0
    while i + n <= total {
        if str_sub(targetString, i, i + n) == searchPart {
            found = found + 1
            i = i + n
        } else {
            i = i + 1
        }
    }
    return found
}

# First letter upper case, the rest lower case.
def capitalize(targetString: string) -> string {
    if len(targetString) == 0 { return targetString }
    return upper(str_sub(targetString, 0, 1)) + lower(str_sub(targetString, 1, len(targetString)))
}

# Safe string slice view helper with clamped boundaries
def slice(targetString: string, startIndex: int, sliceLength: int) -> string {
    total = len(targetString)
    if startIndex < 0 { startIndex = 0 }
    if startIndex >= total or sliceLength <= 0 { return "" }
    end = startIndex + sliceLength
    if end > total { end = total }
    return str_sub(targetString, startIndex, end)
}
