def get_externs() -> list {
    return ["_printf", "_malloc", "_free", "_realloc", "_fopen", "_fclose",
            "_fread", "_fwrite", "_fputs", "_fputc", "_fseek", "_ftell",
            "_fflush", "_exit", "_system_c", "_strlen", "_strcmp", "_strcpy",
            "_strcat", "_strstr", "_memset", "_memcpy", "_sprintf",
            "_dict_new", "_dict_get", "_dict_set", "_dict_has", "_dict_remove",
            "_dict_keys", "_dict_values", "_dict_items", "_dict_free",
            "_abs", "_min", "_max", "_file_exists", "_file_size", "_file_type", "_now", "_call",
            "_str_sub", "_nova_str_concat", "_nova_str_append", "_slice_list", "_char_code", "_list_insert", "_list_clear", "_list_wrap", "_as_list", "_sys_awrite_c",
            "_nova_arc_alloc", "_nova_inc_ref", "_nova_dec_ref",
            "_random", "_random_range", "_chacha20_init", "_api_open_internal",
            "_try_catch_sp", "_catch_ip", "_try_depth", "_exception_val",
            "_oob_file_ptr", "_oob_line",
            "_out_of_bounds",
            "arena_init", "arena_alloc", "arena_reset", "arena_free",
            "_slice_cmp", "_slice_eq", "_slice_find", "_slice_to_str",
            "_slice_from_str", "_slice_from_list_data", "_slice_byte_at",
            "_ffi_open", "_ffi_sym", "_ffi_close",
            "_ffi_call0", "_ffi_call1", "_ffi_call2", "_ffi_call3",
            "_ffi_call4", "_ffi_call5", "_ffi_call6",
            "_nova_task_spawn", "_nova_task_await",
            "_peek_u8", "_peek_u16", "_peek_u32", "_peek_u64",
            "_poke_u8", "_poke_u16", "_poke_u32", "_poke_u64",
            "_cpu_cli", "_cpu_sti", "_cpu_hlt",
            "_cpu_inb", "_cpu_inw", "_cpu_ind",
            "_cpu_outb", "_cpu_outw", "_cpu_outd",
            "_cpu_read_cr3", "_cpu_write_cr3", "_cpu_invlpg"]
}

def get_data_strings() -> list {
    return ["fmt_int: .asciz \"%d\\n\"",
            "fmt_int_pure: .asciz \"%d\"",
            "fmt_str: .asciz \"%s\\n\"",
            "fmt_float: .asciz \"%f\\n\"",
            "fmt_float_pure: .asciz \"%f\"",
            "str_type_int: .asciz \"int\"",
            "str_type_string: .asciz \"string\"",
            "str_type_float: .asciz \"float\"",
            "str_type_bool: .asciz \"bool\"",
            "str_type_list: .asciz \"list\"",
            "str_type_dict: .asciz \"dict\"",
            "str_type_unknown: .asciz \"unknown\"",
            "debug_prefix: .asciz \"debug - [line \"",
            "debug_suffix: .asciz \"]: \"",
            "L_oob_source: .asciz \"unknown\"",
            "str_fmode_a: .asciz \"a\"",
            "str_fmode_w: .asciz \"w\"",
            "str_fmode_r: .asciz \"r\"",
            "str_fmode_rw: .asciz \"r+\"",
            "str_fmode_wp: .asciz \"w+\""]
}


def method_name_to_id(name: string) -> int {
    switch name {
        case "append" { return 1 }
        case "pop" { return 2 }
        case "get" { return 3 }
        case "set" { return 4 }
        case "has" { return 5 }
        case "remove" { return 6 }
        case "keys" { return 7 }
        case "values" { return 8 }
        case "items" { return 9 }
        case "write" { return 10 }
        case "awrite" { return 11 }
        case "read" { return 12 }
        case "close" { return 13 }
        case "flush" { return 14 }
        case "insert" { return 15 }
        case "clear" { return 16 }
        case "as_list" { return 17 }
    }
    return 0
}
