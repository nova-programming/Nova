# Portable JSON (use as `import json`, then json.stringify(v) / json.parse(text)).
#
# json.parse returns a typed tree (`Json`) written in plain Nova:
#   json.kind(v)      0 null, 1 bool, 2 number, 3 string, 4 array, 5 object, -1 parse error
#   json.asInt(v)     integer value (numbers are truncated to int; bools are 0/1)
#   json.asString(v)  string value (for numbers: the literal text; for errors: the message)
#   json.asBool(v)    1 or 0
#   json.size(v)      element count of an array or object
#   json.at(v, i)     array element (a null Json when out of range)
#   json.get(v, key)  object member (a null Json when missing); json.has(v, key) tests presence
#   json.keyAt(v, i)  i-th key of an object, in document order

def stringify(targetValue) -> string {
    return nova_json_stringify(targetValue)
}

@raw {
    "    .extern _nova_json_decode_string"
}

# Decode the raw body of a JSON string (the bytes between the quotes) in one allocation.
def decode(rawBytes: string, startIndex: int, endIndex: int) -> string {
    return nova_json_decode_string(rawBytes, startIndex, endIndex)
}

data Json {
    jtype: int
    jnum: int
    jstr: string
    jitems: list
    jkeys: list
}

data JsonCursor {
    src: string
    pos: int
    size: int
    failed: int
}

data JsonToken {
    kind: int
    text: string
    pos: int
}

# Typed accessor so indexing the source treats it as a string in every backend.
def src(cursor: JsonCursor) -> string {
    return cursor.src
}

def make(typeId: int) -> Json {
    v = Json()
    v.jtype = typeId
    v.jnum = 0
    v.jstr = ""
    v.jitems = []
    v.jkeys = []
    return v
}

def same(firstString: string, secondString: string) -> int {
    if firstString == secondString { return 1 }
    return 0
}

def fail(cursor: JsonCursor, errorMessage: string) -> Json {
    cursor.failed = 1
    v = make(-1)
    v.jstr = errorMessage
    return v
}

def skipSpace(cursor: JsonCursor) {
    source = src(cursor)
    while cursor.pos < cursor.size {
        ch = source[cursor.pos]
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r" {
            cursor.pos = cursor.pos + 1
        } else {
            break
        }
    }
}

def parseString(cursor: JsonCursor) -> string {
    source = src(cursor)
    cursor.pos = cursor.pos + 1
    startIndex = cursor.pos
    while cursor.pos < cursor.size {
        ch = source[cursor.pos]
        if ch == "\\" {
            cursor.pos = cursor.pos + 2
        } elif ch == "\"" {
            endIndex = cursor.pos
            cursor.pos = cursor.pos + 1
            return decode(source, startIndex, endIndex)
        } else {
            cursor.pos = cursor.pos + 1
        }
    }
    cursor.failed = 1
    return ""
}

def parseWord(cursor: JsonCursor, literalWord: string, typeId: int, numberValue: int) -> Json {
    n = len(literalWord)
    if cursor.pos + n <= cursor.size {
        if str_sub(cursor.src, cursor.pos, cursor.pos + n) == literalWord {
            cursor.pos = cursor.pos + n
            v = make(typeId)
            v.jnum = numberValue
            return v
        }
    }
    return fail(cursor, "invalid literal at position " + str(cursor.pos))
}

def parseNumber(cursor: JsonCursor) -> Json {
    source = src(cursor)
    startIndex = cursor.pos
    negative = 0
    if source[cursor.pos] == "-" {
        negative = 1
        cursor.pos = cursor.pos + 1
    }
    value = 0
    digits = 0
    zero = char_code("0", 0)
    while cursor.pos < cursor.size {
        ch = source[cursor.pos]
        if ch >= "0" and ch <= "9" {
            value = value * 10 + (char_code(ch, 0) - zero)
            digits = digits + 1
            cursor.pos = cursor.pos + 1
        } else {
            break
        }
    }
    if digits == 0 { return fail(cursor, "invalid number at position " + str(startIndex)) }
    if cursor.pos < cursor.size and source[cursor.pos] == "." {
        cursor.pos = cursor.pos + 1
        while cursor.pos < cursor.size and source[cursor.pos] >= "0" and source[cursor.pos] <= "9" { cursor.pos = cursor.pos + 1 }
    }
    if cursor.pos < cursor.size and (source[cursor.pos] == "e" or source[cursor.pos] == "E") {
        cursor.pos = cursor.pos + 1
        if cursor.pos < cursor.size and (source[cursor.pos] == "+" or source[cursor.pos] == "-") { cursor.pos = cursor.pos + 1 }
        while cursor.pos < cursor.size and source[cursor.pos] >= "0" and source[cursor.pos] <= "9" { cursor.pos = cursor.pos + 1 }
    }
    v = make(2)
    if negative == 1 { value = 0 - value }
    v.jnum = value
    v.jstr = str_sub(source, startIndex, cursor.pos)
    return v
}

def parseArray(cursor: JsonCursor) -> Json {
    source = src(cursor)
    v = make(4)
    cursor.pos = cursor.pos + 1
    skipSpace(cursor)
    if cursor.pos < cursor.size and source[cursor.pos] == "]" {
        cursor.pos = cursor.pos + 1
        return v
    }
    while cursor.pos < cursor.size {
        item = parseValue(cursor)
        if cursor.failed == 1 { return item }
        v.jitems.append(item)
        skipSpace(cursor)
        if cursor.pos >= cursor.size { break }
        ch = source[cursor.pos]
        if ch == "," {
            cursor.pos = cursor.pos + 1
        } elif ch == "]" {
            cursor.pos = cursor.pos + 1
            return v
        } else {
            return fail(cursor, "expected , or ] at position " + str(cursor.pos))
        }
    }
    return fail(cursor, "unterminated array")
}

def parseObject(cursor: JsonCursor) -> Json {
    source = src(cursor)
    v = make(5)
    cursor.pos = cursor.pos + 1
    skipSpace(cursor)
    if cursor.pos < cursor.size and source[cursor.pos] == "}" {
        cursor.pos = cursor.pos + 1
        return v
    }
    while cursor.pos < cursor.size {
        skipSpace(cursor)
        if cursor.pos >= cursor.size or source[cursor.pos] != "\"" {
            return fail(cursor, "expected object key at position " + str(cursor.pos))
        }
        key = parseString(cursor)
        if cursor.failed == 1 { return fail(cursor, "bad object key") }
        skipSpace(cursor)
        if cursor.pos >= cursor.size or source[cursor.pos] != ":" {
            return fail(cursor, "expected : at position " + str(cursor.pos))
        }
        cursor.pos = cursor.pos + 1
        item = parseValue(cursor)
        if cursor.failed == 1 { return item }
        v.jkeys.append(key)
        v.jitems.append(item)
        skipSpace(cursor)
        if cursor.pos >= cursor.size { break }
        ch = source[cursor.pos]
        if ch == "," {
            cursor.pos = cursor.pos + 1
        } elif ch == "}" {
            cursor.pos = cursor.pos + 1
            return v
        } else {
            return fail(cursor, "expected , or } at position " + str(cursor.pos))
        }
    }
    return fail(cursor, "unterminated object")
}

def parseValue(cursor: JsonCursor) -> Json {
    skipSpace(cursor)
    if cursor.pos >= cursor.size { return fail(cursor, "unexpected end of input") }
    source = src(cursor)
    ch = source[cursor.pos]
    if ch == "{" { return parseObject(cursor) }
    if ch == "[" { return parseArray(cursor) }
    if ch == "\"" {
        s = parseString(cursor)
        if cursor.failed == 1 { return fail(cursor, "unterminated string") }
        v = make(3)
        v.jstr = s
        return v
    }
    if ch == "t" { return parseWord(cursor, "true", 1, 1) }
    if ch == "f" { return parseWord(cursor, "false", 1, 0) }
    if ch == "n" { return parseWord(cursor, "null", 0, 0) }
    if ch == "-" or (ch >= "0" and ch <= "9") { return parseNumber(cursor) }
    return fail(cursor, "unexpected character at position " + str(cursor.pos))
}

def parse(jsonSource: string) -> Json {
    c = JsonCursor()
    c.src = jsonSource
    c.pos = 0
    c.size = len(jsonSource)
    c.failed = 0
    v = parseValue(c)
    if c.failed == 1 { return v }
    skipSpace(c)
    if c.pos < c.size { return fail(c, "unexpected trailing data at position " + str(c.pos)) }
    return v
}

def kind(targetJson: Json) -> int {
    return targetJson.jtype
}

def asInt(targetJson: Json) -> int {
    return targetJson.jnum
}

def asString(targetJson: Json) -> string {
    return targetJson.jstr
}

def asBool(targetJson: Json) -> int {
    if targetJson.jnum != 0 { return 1 }
    return 0
}

def size(targetJson: Json) -> int {
    return len(targetJson.jitems)
}

def at(targetJson: Json, itemIndex: int) -> Json {
    if itemIndex < 0 or itemIndex >= len(targetJson.jitems) { return make(0) }
    return targetJson.jitems[itemIndex]
}

def keyAt(targetJson: Json, keyIndex: int) -> string {
    if keyIndex < 0 or keyIndex >= len(targetJson.jkeys) { return "" }
    return targetJson.jkeys[keyIndex]
}

def find(targetJson: Json, targetKey: string) -> int {
    i = 0
    while i < len(targetJson.jkeys) {
        if same(targetJson.jkeys[i], targetKey) == 1 { return i }
        i = i + 1
    }
    return -1
}

def has(targetJson: Json, targetKey: string) -> int {
    if find(targetJson, targetKey) >= 0 { return 1 }
    return 0
}

def get(targetJson: Json, targetKey: string) -> Json {
    i = find(targetJson, targetKey)
    if i < 0 { return make(0) }
    return targetJson.jitems[i]
}

# --- Streaming / Incremental JSON Token Parser ---
def newCursor(sourceString: string) -> JsonCursor {
    c = JsonCursor()
    c.src = sourceString
    c.pos = 0
    c.size = len(sourceString)
    c.failed = 0
    return c
}

def nextToken(cursor: JsonCursor) -> JsonToken {
    skipSpace(cursor)
    tok = JsonToken()
    tok.pos = cursor.pos
    tok.text = ""
    if cursor.pos >= cursor.size {
        tok.kind = 0
        return tok
    }
    source = src(cursor)
    ch = source[cursor.pos]
    if ch == "{" {
        cursor.pos = cursor.pos + 1
        tok.kind = 1
        tok.text = "{"
        return tok
    }
    if ch == "}" {
        cursor.pos = cursor.pos + 1
        tok.kind = 2
        tok.text = "}"
        return tok
    }
    if ch == "[" {
        cursor.pos = cursor.pos + 1
        tok.kind = 3
        tok.text = "["
        return tok
    }
    if ch == "]" {
        cursor.pos = cursor.pos + 1
        tok.kind = 4
        tok.text = "]"
        return tok
    }
    if ch == ":" {
        cursor.pos = cursor.pos + 1
        tok.kind = 5
        tok.text = ":"
        return tok
    }
    if ch == "," {
        cursor.pos = cursor.pos + 1
        tok.kind = 6
        tok.text = ","
        return tok
    }
    if ch == "\"" {
        val = parseString(cursor)
        tok.kind = 7
        tok.text = val
        return tok
    }
    if ch == "t" {
        parseWord(cursor, "true", 1, 1)
        tok.kind = 9
        tok.text = "true"
        return tok
    }
    if ch == "f" {
        parseWord(cursor, "false", 1, 0)
        tok.kind = 10
        tok.text = "false"
        return tok
    }
    if ch == "n" {
        parseWord(cursor, "null", 0, 0)
        tok.kind = 11
        tok.text = "null"
        return tok
    }
    if ch == "-" or (ch >= "0" and ch <= "9") {
        v = parseNumber(cursor)
        tok.kind = 8
        tok.text = v.jstr
        return tok
    }
    cursor.pos = cursor.pos + 1
    tok.kind = -1
    tok.text = ch
    return tok
}

def tokenKind(targetToken: JsonToken) -> int {
    return targetToken.kind
}

def tokenText(targetToken: JsonToken) -> string {
    return targetToken.text
}

def tokenPos(targetToken: JsonToken) -> int {
    return targetToken.pos
}
