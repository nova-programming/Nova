}

# =============================================================================
# NSS Helper — Convenience wrappers for pure class-based (NSS) styling
# Use these when you want 100% visual styling in .nss files.
# Pass class names as a space-separated string in the "class" prop.
#
# Example:
#   btn("Save", {class: "btn-primary", on_click: "on_save"})
#   div([...], {class: "card"})
# =============================================================================

# cls() — builds a minimal props dict with just a class name
def cls(class_name: string) -> dict {
    return {"class": class_name}
}

# cls_id() — builds a props dict with class + id for NSS targeting
def cls_id(class_name: string, id_name: string) -> dict {
    return {"class": class_name, "id": id_name}
}

# =============================================================================
# Modern Declarative UI Engine (Two-Pass Layout, Auto Hit-Testing & Dispatch)
# =============================================================================

def gui_render_tree(w: Widget) {
    renderWidget(w)
}

def gui_dispatch_events(w: Widget, mx: int, my: int, is_clicked: int) -> int {
    hit = 0
    if mx >= w.pos_x and mx <= w.pos_x + w.width and my >= w.pos_y and my <= w.pos_y + w.height {
        hit = 1
    }

    w.is_hovered = hit
    if hit == 1 and is_clicked == 1 {
        w.is_pressed = 1
        if w.tag == "input" {
            w.props.set("is_focused", 1)
        }
    } else {
        w.is_pressed = 0
        if is_clicked == 1 and hit == 0 and w.tag == "input" {
            w.props.set("is_focused", 0)
        }
    }

    clicked_action = 0
    ci = 0
    while ci < len(w.children) {
        child = w.children[ci]
        c_hit = gui_dispatch_events(child, mx, my, is_clicked)
        if c_hit > 0 {
            clicked_action = c_hit
        }
        ci = ci + 1
    }

    if clicked_action > 0 {
        return clicked_action
    }

    if hit == 1 and is_clicked == 1 {
        if w.on_click_id > 0 {
            dispatchAction(w, w.on_click_id)
            return w.on_click_id
        }
        return 1
    }

    return 0
}

def gui_run(title: string, width: int, height: int, root: Widget, properties: dict) {
    p = _expand_props(properties)
    if p.has("style") == 1 or p.has("nss") == 1 {
        style_path = ""
        if p.has("style") == 1 { style_path = p.get("style") }
        else { style_path = p.get("nss") }
        st = nss.nss_load(style_path)
        if st.has("ID__window") == 1 {
            nss._merge_props(p, st.get("ID__window"))
        } elif st.has("CLS__window") == 1 {
            nss._merge_props(p, st.get("CLS__window"))
        } elif st.has("TAG__window") == 1 {
            nss._merge_props(p, st.get("TAG__window"))
        }
        nss.nss_apply(root, st)
    }

    ok = initWindow(title, width, height)
    if ok != 1 {
        print("ERROR: gui_init_window failed (returned " + str(ok) + "). Window could not be created.")
        return
    }

    bg_hex = 0x00181825
    if p.has("background-color") == 1 {
        bg_hex = parseColor(p.get("background-color"))
    } elif p.has("bg") == 1 {
        bg_hex = parseColor(p.get("bg"))
    }

    gui_measure(root)
    gui_layout(root, 0, 0, width, height)

    args = system.get_args()
    max_frames = 0
    screenshot_path = ""
    if properties.has("screenshot") == 1 {
        screenshot_path = properties.get("screenshot")
        max_frames = 5
    }
    if properties.has("test") == 1 {
        max_frames = 30
    }
    ai = 1
    while ai < len(args) {
        if args[ai] == "--test" {
            max_frames = 30
        }
        if args[ai] == "--screenshot" and (ai + 1) < len(args) {
            screenshot_path = args[ai + 1]
            max_frames = 5
        }
        ai = ai + 1
    }

    frame = 0
    running = 1
    while running == 1 {
        ev = pollEvents()
        if ev == -1 {
            print("gui_run: pollEvents returned -1 at frame " + str(frame))
            running = 0
            break
        }

        mx = gui_mouse_x()
        my = gui_mouse_y()
        clicked = gui_get_mouse_clicked()

        # Keyboard polling & dispatch to focused inputs
        k = gui_poll_char()
        while k > 0 {
            _dispatch_key_event(root, k)
            k = gui_poll_char()
        }

        gui_dispatch_events(root, mx, my, clicked)

        gui_clear(bg_hex)
        gui_render_tree(root)
        gui_present()

        if len(screenshot_path) > 0 and frame == 2 {
            sc_ok = saveScreenshot(screenshot_path)
            if sc_ok == 1 {
                print("Screenshot saved to: " + screenshot_path)
            } else {
                print("Screenshot FAILED for: " + screenshot_path)
            }
        }

        gui_sleep(16)
        frame = frame + 1
        if max_frames > 0 and frame >= max_frames {
            running = 0
            break
        }
    }
    closeWindow()
}
