def getMonoCharW() -> int {
    w = gui_mono_char_w()
    if w <= 0 { return 7 }
    return w
}

def ui_button(text: string, x: int, y: int, w: int, h: int, is_hover: int, is_active: int, accent_hex: int) {
    bg = 0x00313244
    border_col = accent_hex
    bw = 1
    if is_active == 1 {
        bg = 0x00585b70
        bw = 2
    } elif is_hover == 1 {
        bg = 0x0045475a
        bw = 2
    }
    gui_draw_rect(x, y, w, h, bg, 6)
    gui_draw_border(x, y, w, h, bw, border_col)
    t_len = len(text)
    tx = x + (w - t_len * 7) / 2
    ty = y + (h - 14) / 2
    gui_draw_text(text, tx, ty, 12, accent_hex, 1)
}

def ui_badge(text: string, x: int, y: int, bg_hex: int, fg_hex: int) {
    w = len(text) * 7 + 12
    gui_draw_rect(x, y, w, 20, bg_hex, 4)
    gui_draw_text(text, x + 6, y + 3, 10, fg_hex, 1)
}

def ui_panel(x: int, y: int, w: int, h: int, title: string, bg_hex: int, border_hex: int) {
    gui_draw_rect(x, y, w, h, bg_hex, 8)
    gui_draw_border(x, y, w, h, 1, border_hex)
    if len(title) > 0 {
        gui_draw_rect(x + 10, y + 10, len(title) * 7 + 14, 22, 0x0011111b, 4)
        gui_draw_text(title, x + 16, y + 14, 10, 0x00cba6f7, 1)
    }
}

