def badge(class: string, id: string, text: string, props: dict) -> Widget {
    p = _expand_props(props)
    if len(class) > 0 { p.set("class", class) }
    if len(id) > 0 { p.set("id", id) }
    if p.has("border-radius") == 0 { p.set("border-radius", 10) }
    p.set("padding-left", 8)  p.set("padding-right", 8)
    p.set("padding-top",  3)  p.set("padding-bottom", 3)
    inner = Text(text, {"font-weight": "bold", "font-size": 11})
    return Container([inner], p)
}

