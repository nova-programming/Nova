}

def strLen(s: string) -> int {
    return len(s)
}

def pollChar() -> int {
    return gui_poll_char()
}

def charToStr(c: int) -> string {
    return gui_char_to_str(c)
}

def _str_delete_last(s: string) -> string {
    if len(s) <= 1 { return "" }
    return str_sub(s, 0, len(s) - 1)
}

# --- Color Conversion Helper ---
def hexCharToVal(ch: string) -> int {
    if len(ch) == 0 { return 0 }
    c = char_code(ch)
    if c >= 48 and c <= 57 { return c - 48 }
    if c >= 65 and c <= 70 { return c - 55 }
    if c >= 97 and c <= 102 { return c - 87 }
    return 0
}

def parseColor(c: string) -> int {
    if len(c) == 0 { return 0 }
    start = 0
    if c[0] == "#" { start = 1 }
    res = 0
    k = start
    while k < len(c) {
        val = hexCharToVal(c[k])
        res = res * 16 + val
        k = k + 1
    }
    return res
}

def parse_color(c: string) -> int {
    return parseColor(c)
}

# --- Widget Data Structure ---
data Widget {
    tag: string
    text: string
    props: dict
    children: list
    on_click_id: int
    pos_x: int
    pos_y: int
    width: int
    height: int
    is_hovered: int
    is_pressed: int
    flex: int
    measured_w: int
    measured_h: int
}

# --- Reactive State Abstraction ---
data State {
    id: int
    kind: string
    val_int: int
    val_str: string
    targets: list
    prefixes: list
    suffixes: list
}

def StateInt(initial_val: int) -> State {
    s = State()
    s.id = gui_next_click_id()
    s.kind = "int"
    s.val_int = initial_val
    s.val_str = ""
    s.targets = []
    s.prefixes = []
    s.suffixes = []
    return s
}

def StateStr(initial_val: string) -> State {
    s = State()
    s.id = gui_next_click_id()
    s.kind = "str"
    s.val_int = 0
    s.val_str = initial_val
    s.targets = []
    s.prefixes = []
    s.suffixes = []
    return s
}

def state_int(initial_val: int) -> State {
    return StateInt(initial_val)
}

def state_str(initial_val: string) -> State {
    return StateStr(initial_val)
}

def state_get_int(s: State) -> int {
    return s.val_int
}

def state_get_str(s: State) -> string {
    return s.val_str
}

def state_notify(s: State) {
    ti = 0
    while ti < len(s.targets) {
        tgt = s.targets[ti]
        pfx = ""
        sfx = ""
        if ti < len(s.prefixes) { pfx = s.prefixes[ti] }
        if ti < len(s.suffixes) { sfx = s.suffixes[ti] }

        if s.kind == "int" {
            val_text = pfx + str(s.val_int) + sfx
            if tgt.tag == "checkbox" {
                tgt.props.set("checked", s.val_int)
            } elif tgt.tag == "toggle" {
                tgt.props.set("is_on", s.val_int)
                tgt.props.set("checked", s.val_int)
            } elif tgt.tag == "slider" {
                tgt.props.set("value", s.val_int)
            } elif tgt.tag == "dropdown" {
                tgt.props.set("selected", s.val_int)
            } else {
                tgt.text = val_text
            }
        } else {
            tgt.text = pfx + s.val_str + sfx
        }
        ti = ti + 1
    }
}

def state_set_int(s: State, new_val: int) {
    s.val_int = new_val
    state_notify(s)
}

def state_set_str(s: State, new_val: string) {
    s.val_str = new_val
    state_notify(s)
}

def state_bind(s: State, w: Widget, prefix: string, suffix: string) {
    s.targets.append(w)
    s.prefixes.append(prefix)
    s.suffixes.append(suffix)
    w.props.set("state", s)
    w.props.set("bind", s)
    
    if s.kind == "int" {
        if w.tag == "checkbox" {
            w.props.set("checked", s.val_int)
        } elif w.tag == "toggle" {
            w.props.set("is_on", s.val_int)
            w.props.set("checked", s.val_int)
        } elif w.tag == "slider" {
            w.props.set("value", s.val_int)
        } elif w.tag == "dropdown" {
            w.props.set("selected", s.val_int)
        } else {
            w.text = prefix + str(s.val_int) + suffix
        }
    } else {
        w.text = prefix + s.val_str + suffix
    }
}

def _check_state_binding(w: Widget, p: dict) {
    if p.has("bind") == 1 {
        s = p.get("bind")
        pfx = ""
        sfx = ""
        if p.has("prefix") == 1 { pfx = p.get("prefix") }
        if p.has("suffix") == 1 { sfx = p.get("suffix") }
        state_bind(s, w, pfx, sfx)
    } elif p.has("state") == 1 and p.has("action") == 0 {
        s = p.get("state")
        pfx = ""
        sfx = ""
        if p.has("prefix") == 1 { pfx = p.get("prefix") }
        if p.has("suffix") == 1 { sfx = p.get("suffix") }
        state_bind(s, w, pfx, sfx)
    }
}

# --- Theme System (Dark & Light Palettes) ---
_gui_active_theme = "dark"

def set_theme(name: string) {
    if name == "light" or name == "latte" {
        _gui_active_theme = "light"
    } else {
        _gui_active_theme = "dark"
    }
}

def get_theme() -> string {
    return _gui_active_theme
}

def toggle_theme() -> string {
    if _gui_active_theme == "dark" {
        _gui_active_theme = "light"
    } else {
        _gui_active_theme = "dark"
    }
    return _gui_active_theme
}

def get_theme_color(token: string) -> string {
    if _gui_active_theme == "light" {
        if token == "text" { return "#4c4f69" }
        if token == "accent" { return "#1e66f5" }
        if token == "surface" { return "#dce0e8" }
        if token == "mantle" { return "#e6e9ef" }
        if token == "border" { return "#bcc0cc" }
        if token == "bg" { return "#eff1f5" }
        return "#4c4f69"
    }
    if token == "text" { return "#cdd6f4" }
    if token == "accent" { return "#89b4fa" }
    if token == "surface" { return "#1e1e2e" }
    if token == "mantle" { return "#181825" }
    if token == "border" { return "#45475a" }
    if token == "bg" { return "#11111b" }
    return "#cdd6f4"
}

# --- Centralized Default Component Styling ---
def _apply_default_props(tag: string, user_props: dict) -> dict {
    res = {}
    c_text = "#cdd6f4"
    c_accent = "#89b4fa"
    c_surface = "#1e1e2e"
    c_mantle = "#181825"
    c_border = "#45475a"
    c_surface_alt = "#313244"
    if _gui_active_theme == "light" {
        c_text = "#4c4f69"
        c_accent = "#1e66f5"
        c_surface = "#dce0e8"
        c_mantle = "#e6e9ef"
        c_border = "#bcc0cc"
        c_surface_alt = "#ccd0da"
    }

    if tag == "title" {
        res.set("font-size", 22)
        res.set("font-weight", "bold")
        res.set("padding-bottom", 8)
        if user_props.has("color") == 0 {
            res.set("color", c_text)
        }
    } elif tag == "heading" {
        res.set("font-size", 16)
        res.set("font-weight", "bold")
        res.set("padding-bottom", 6)
        if user_props.has("color") == 0 {
            res.set("color", c_accent)
        }
    } elif tag == "text" {
        res.set("font-size", 14)
        if user_props.has("color") == 0 {
            res.set("color", c_text)
        }
    } elif tag == "button" {
        res.set("border-radius", 6)
        res.set("padding-left", 14)
        res.set("padding-right", 14)
        res.set("padding-top", 8)
        res.set("padding-bottom", 8)
        if user_props.has("bg") == 0 and user_props.has("background-color") == 0 and user_props.has("color") == 0 {
            res.set("background-color", c_accent)
            btn_fg = "#11111b"
            if _gui_active_theme == "light" { btn_fg = "#ffffff" }
            res.set("color", btn_fg)
            res.set("hover-background-color", get_theme_color("accent_hover"))
            res.set("pressed-background-color", get_theme_color("accent_press"))
        }
    } elif tag == "card" {
        res.set("background-color", c_surface)
        res.set("border-width", 1)
        res.set("border-color", c_surface_alt)
        res.set("border-radius", 8)
        res.set("padding", 16)
        res.set("gap", 10)
        res.set("flex-direction", "column")
    } elif tag == "divider" {
        res.set("height", 1)
        res.set("background-color", c_surface_alt)
        res.set("margin-top", 8)
        res.set("margin-bottom", 8)
    } elif tag == "input" {
        res.set("height", 34)
        res.set("background-color", c_mantle)
        res.set("border-width", 1)
        res.set("border-color", c_border)
        res.set("border-radius", 6)
        res.set("padding-left", 10)
        res.set("padding-right", 10)
        res.set("color", get_theme_color("muted"))
        res.set("text-color", c_text)
        res.set("focus-border-color", c_accent)
    } elif tag == "textarea" {
        res.set("height", 80)
        res.set("background-color", c_mantle)
        res.set("border-width", 1)
        res.set("border-color", c_border)
        res.set("border-radius", 6)
        res.set("padding", 10)
        res.set("color", c_text)
    } elif tag == "checkbox" {
        res.set("padding-left", 4)
        res.set("padding-top", 4)
        res.set("color", c_text)
    } elif tag == "toggle" {
        res.set("padding-left", 4)
        res.set("padding-top", 4)
    } elif tag == "slider" {
        res.set("padding-left", 4)
        res.set("padding-top", 4)
        res.set("track-bg", c_surface_alt)
        res.set("fill-color", c_accent)
    } elif tag == "dropdown" {
        res.set("background-color", c_mantle)
        res.set("border-width", 1)
        res.set("border-color", c_border)
        res.set("border-radius", 6)
        res.set("padding-left", 8)
        res.set("color", c_text)
    }

    expanded = _expand_props(user_props)
    keys = expanded.keys()
    ki = 0
    while ki < len(keys) {
        k = keys[ki]
        res.set(k, expanded.get(k))
        ki = ki + 1
    }
    return res
}

# --- Unified Widget Allocator ---
def _new_widget(tag: string, text: string, p: dict, children: list, click_id: int) -> Widget {
    w = Widget()
    w.tag = tag
    w.text = text
    w.props = p
    w.children = children
    w.on_click_id = click_id
    w.pos_x = 0
    w.pos_y = 0
    w.width = 0
    w.height = 0
    w.is_hovered = 0
    w.is_pressed = 0
    w.flex = 0
    w.measured_w = 0
    w.measured_h = 0
    if p.has("flex") == 1 { w.flex = p.get("flex") }
    _check_state_binding(w, p)
    return w
}

# --- Widget Factory Functions ---
def Text(content: string, properties: dict) -> Widget {
    p = _apply_default_props("text", properties)
    return _new_widget("text", content, p, [], 0)
}

def Title(content: string, properties: dict) -> Widget {
    p = _apply_default_props("title", properties)
    return _new_widget("text", content, p, [], 0)
}

def Heading(content: string, properties: dict) -> Widget {
    p = _apply_default_props("heading", properties)
    return _new_widget("text", content, p, [], 0)
}

def Button(label: string, click_id: int, properties: dict) -> Widget {
    p = _apply_default_props("button", properties)
    cid = click_id
    if cid <= 0 { cid = gui_next_click_id() }
    return _new_widget("button", label, p, [], cid)
}

def Container(child_list: list, properties: dict) -> Widget {
    p = _expand_props(properties)
    return _new_widget("container", "", p, child_list, 0)
}

def Row(child_list: list, properties: dict) -> Widget {
    p = _expand_props(properties)
    if p.has("flex-direction") == 0 { p.set("flex-direction", "row") }
    return _new_widget("row", "", p, child_list, 0)
}

def Col(child_list: list, properties: dict) -> Widget {
    p = _expand_props(properties)
    if p.has("flex-direction") == 0 { p.set("flex-direction", "column") }
    return _new_widget("column", "", p, child_list, 0)
}

def Column(child_list: list, properties: dict) -> Widget {
    return Col(child_list, properties)
}

def Card(child_list: list, properties: dict) -> Widget {
    p = _apply_default_props("card", properties)
    return _new_widget("card", "", p, child_list, 0)
}

def Divider(properties: dict) -> Widget {
    p = _apply_default_props("divider", properties)
    return _new_widget("divider", "", p, [], 0)
}

def Input(placeholder: string, properties: dict) -> Widget {
    p = _apply_default_props("input", properties)
    if p.has("placeholder") == 0 { p.set("placeholder", placeholder) }
    return _new_widget("input", "", p, [], 0)
}

def TextArea(text: string, properties: dict) -> Widget {
    p = _apply_default_props("textarea", properties)
    return _new_widget("textarea", text, p, [], 0)
}

def Checkbox(label: string, checked: int, click_id: int, properties: dict) -> Widget {
    p = _apply_default_props("checkbox", properties)
    p.set("checked", checked)
    cid = click_id
    if cid <= 0 { cid = gui_next_click_id() }
    return _new_widget("checkbox", label, p, [], cid)
}

def Toggle(label: string, is_on: int, click_id: int, properties: dict) -> Widget {
    p = _apply_default_props("toggle", properties)
    p.set("is_on", is_on)
    p.set("checked", is_on)
    cid = click_id
    if cid <= 0 { cid = gui_next_click_id() }
    return _new_widget("toggle", label, p, [], cid)
}

def Slider(value: int, min_val: int, max_val: int, click_id: int, properties: dict) -> Widget {
    p = _apply_default_props("slider", properties)
    p.set("value", value)
    p.set("min", min_val)
    p.set("max", max_val)
    cid = click_id
    if cid <= 0 { cid = gui_next_click_id() }
    return _new_widget("slider", "", p, [], cid)
}

def Dropdown(options: list, selected_index: int, click_id: int, properties: dict) -> Widget {
    p = _apply_default_props("dropdown", properties)
    p.set("options", options)
    p.set("selected", selected_index)
    cid = click_id
    if cid <= 0 { cid = gui_next_click_id() }
    return _new_widget("dropdown", "", p, [], cid)
}

def Image(path: string, properties: dict) -> Widget {
    p = _apply_default_props("image", properties)
    p.set("src", path)
    return _new_widget("image", path, p, [], 0)
}

def Scroll(child_list: list, properties: dict) -> Widget {
    p = _apply_default_props("scroll", properties)
    return _new_widget("scroll", "", p, child_list, 0)
}

def List(child_list: list, properties: dict) -> Widget {
    p = _apply_default_props("list", properties)
    return _new_widget("list", "", p, child_list, 0)
}

def Spacer(properties: dict) -> Widget {
    p = _expand_props(properties)
    if p.has("flex") == 0 and p.has("width") == 0 and p.has("height") == 0 and p.has("w") == 0 and p.has("h") == 0 {
        p.set("flex", 1)
    }
    return _new_widget("spacer", "", p, [], 0)
}

def Canvas(render_fn: any, properties: dict) -> Widget {
    p = _expand_props(properties)
    return _new_widget("canvas", "", p, [], 0)
}

# Ergonomic shorthand helpers (zero property dict required)
def title(content: string) -> Widget {
    return Title(content, {})
}

def heading(content: string) -> Widget {
    return Heading(content, {})
}

def divider_v() -> Widget {
    return Divider({})
}

def spacer_v() -> Widget {
    return Spacer({})
}



# --- Window & App State ---
data WindowApp {
    title: string
    width: int
    height: int
    props: dict
    root: Widget
}

def window(title: string, width: int, height: int, root: Widget, properties: dict) -> WindowApp {
    app = WindowApp()
    app.title = title
    app.width = width
    app.height = height
    app.props = properties
    app.root = root
    return app
}

def createWindow(title: string, width: int, height: int, properties: dict) -> WindowApp {
    app = WindowApp()
    app.title = title
    app.width = width
    app.height = height
    app.props = properties
    app.root = Container([], properties)
    return app
}

def create_window(title: string, width: int, height: int, properties: dict) -> WindowApp {
    return createWindow(title, width, height, properties)
}

def Window(title: string, root: Widget, width: int, height: int, properties: dict) -> WindowApp {
    return window(title, width, height, root, properties)
}

def App(title: string, root: Widget, width: int, height: int, properties: dict) -> int {
    gui_run(title, width, height, root, properties)
    return 0
}

def app_run(title: string, root: Widget) -> int {
    return App(title, root, 800, 600, {})
}

# --- Layout Engine ---
def gui_measure(w: Widget) {
    p = w.props

    pad = 0
    if p.has("padding") == 1 { pad = p.get("padding") }
    pad_l = pad
    pad_r = pad
    pad_t = pad
    pad_b = pad
    if p.has("padding-left") == 1 { pad_l = p.get("padding-left") }
    if p.has("padding-right") == 1 { pad_r = p.get("padding-right") }
    if p.has("padding-top") == 1 { pad_t = p.get("padding-top") }
    if p.has("padding-bottom") == 1 { pad_b = p.get("padding-bottom") }

    w.flex = 0
    if p.has("flex") == 1 { w.flex = p.get("flex") }

    req_w = -1
    if p.has("width") == 1 { req_w = p.get("width") }
    elif p.has("w") == 1 { req_w = p.get("w") }

    req_h = -1
    if p.has("height") == 1 { req_h = p.get("height") }
    elif p.has("h") == 1 { req_h = p.get("h") }

    tag = w.tag

    if tag == "text" {
        fs = 14
        if p.has("font-size") == 1 { fs = p.get("font-size") }
        elif p.has("size") == 1 { fs = p.get("size") }
        t_len = strLen(w.text)
        is_mono = 0
        if p.has("mono") == 1 and p.get("mono") == 1 { is_mono = 1 }
        char_w = fs / 2 + 1
        if is_mono == 1 {
            char_w = gui_mono_char_w()
            if char_w <= 0 { char_w = 7 }
        }
        w.measured_w = t_len * char_w + pad_l + pad_r
        w.measured_h = fs + 6 + pad_t + pad_b
    } elif tag == "button" {
        fs = 14
        if p.has("font-size") == 1 { fs = p.get("font-size") }
        elif p.has("size") == 1 { fs = p.get("size") }
        t_len = strLen(w.text)
        w.measured_w = t_len * (fs / 2 + 1) + 28 + pad_l + pad_r
        w.measured_h = fs + 14 + pad_t + pad_b
    } elif tag == "spacer" {
        w.measured_w = 0
        w.measured_h = 0
    } elif tag == "canvas" {
        w.measured_w = 200 + pad_l + pad_r
        w.measured_h = 150 + pad_t + pad_b
    } elif tag == "divider" {
        w.measured_w = 100 + pad_l + pad_r
        w.measured_h = 1 + pad_t + pad_b
    } elif tag == "input" {
        t_w = strLen(w.text) * 8
        if t_w < 100 { t_w = 100 }
        w.measured_w = t_w + 30 + pad_l + pad_r
        w.measured_h = 34 + pad_t + pad_b
    } elif tag == "textarea" {
        w.measured_w = 200 + pad_l + pad_r
        w.measured_h = 80 + pad_t + pad_b
    } elif tag == "checkbox" {
        w.measured_w = strLen(w.text) * 8 + 26 + pad_l + pad_r
        w.measured_h = 24 + pad_t + pad_b
    } elif tag == "toggle" {
        w.measured_w = 44 + pad_l + pad_r
        w.measured_h = 24 + pad_t + pad_b
    } elif tag == "slider" {
        w.measured_w = 140 + pad_l + pad_r
        w.measured_h = 24 + pad_t + pad_b
    } elif tag == "dropdown" {
        w.measured_w = 120 + pad_l + pad_r
        w.measured_h = 30 + pad_t + pad_b
    } elif tag == "image" {
        w.measured_w = 160 + pad_l + pad_r
        w.measured_h = 120 + pad_t + pad_b
    } else {
        gap = 0
        if p.has("gap") == 1 { gap = p.get("gap") }

        is_row = 0
        if tag == "row" or (p.has("flex-direction") == 1 and p.get("flex-direction") == "row") {
            is_row = 1
        }

        total_w = 0
        total_h = 0
        max_w = 0
        max_h = 0

        ci = 0
        while ci < len(w.children) {
            child = w.children[ci]
            gui_measure(child)

            cw = child.measured_w
            ch = child.measured_h

            if is_row == 1 {
                total_w = total_w + cw
                if ci > 0 { total_w = total_w + gap }
                if ch > max_h { max_h = ch }
            } else {
                total_h = total_h + ch
                if ci > 0 { total_h = total_h + gap }
                if cw > max_w { max_w = cw }
            }
            ci = ci + 1
        }

        if is_row == 1 {
            w.measured_w = total_w + pad_l + pad_r
            w.measured_h = max_h + pad_t + pad_b
        } else {
            w.measured_w = max_w + pad_l + pad_r
            w.measured_h = total_h + pad_t + pad_b
        }
    }

    if req_w >= 0 { w.measured_w = req_w }
    if req_h >= 0 { w.measured_h = req_h }

    if p.has("min_w") == 1 and w.measured_w < p.get("min_w") { w.measured_w = p.get("min_w") }
    if p.has("max_w") == 1 and w.measured_w > p.get("max_w") { w.measured_w = p.get("max_w") }
    if p.has("min_h") == 1 and w.measured_h < p.get("min_h") { w.measured_h = p.get("min_h") }
    if p.has("max_h") == 1 and w.measured_h > p.get("max_h") { w.measured_h = p.get("max_h") }
}

def gui_layout(w: Widget, avail_x: int, avail_y: int, avail_w: int, avail_h: int) {
    w.pos_x = avail_x
    w.pos_y = avail_y

    p = w.props

    w.width = avail_w
    w.height = avail_h
    if p.has("width") == 1 { w.width = p.get("width") }
    elif p.has("w") == 1 { w.width = p.get("w") }
    elif w.measured_w > 0 and (w.tag == "text" or w.tag == "button") {
        w.width = w.measured_w
    }

    if p.has("height") == 1 { w.height = p.get("height") }
    elif p.has("h") == 1 { w.height = p.get("h") }
    elif w.measured_h > 0 and (w.tag == "text" or w.tag == "button") {
        w.height = w.measured_h
    }

    if len(w.children) == 0 {
        return
    }

    pad = 0
    if p.has("padding") == 1 { pad = p.get("padding") }
    pad_l = pad
    pad_r = pad
    pad_t = pad
    pad_b = pad
    if p.has("padding-left") == 1 { pad_l = p.get("padding-left") }
    if p.has("padding-right") == 1 { pad_r = p.get("padding-right") }
    if p.has("padding-top") == 1 { pad_t = p.get("padding-top") }
    if p.has("padding-bottom") == 1 { pad_b = p.get("padding-bottom") }

    gap = 0
    if p.has("gap") == 1 { gap = p.get("gap") }

    inner_x = w.pos_x + pad_l
    inner_y = w.pos_y + pad_t
    inner_w = w.width - pad_l - pad_r
    if inner_w < 0 { inner_w = 0 }
    inner_h = w.height - pad_t - pad_b
    if inner_h < 0 { inner_h = 0 }

    is_row = 0
    if w.tag == "row" or (p.has("flex-direction") == 1 and p.get("flex-direction") == "row") {
        is_row = 1
    }

    total_flex = 0
    fixed_space = 0
    num_children = len(w.children)
    num_gaps = 0
    if num_children > 1 { num_gaps = num_children - 1 }
    total_gap_space = num_gaps * gap

    ci = 0
    while ci < num_children {
        child = w.children[ci]
        cf = child.flex
        if cf > 0 {
            total_flex = total_flex + cf
        } else {
            if is_row == 1 {
                fixed_space = fixed_space + child.measured_w
            } else {
                fixed_space = fixed_space + child.measured_h
            }
        }
        ci = ci + 1
    }

    avail_primary = inner_w
    if is_row == 0 { avail_primary = inner_h }

    free_space = avail_primary - fixed_space - total_gap_space
    if free_space < 0 { free_space = 0 }

    align_items = "start"
    if p.has("align-items") == 1 { align_items = p.get("align-items") }
    elif p.has("align") == 1 { align_items = p.get("align") }

    justify_content = "start"
    if p.has("justify-content") == 1 { justify_content = p.get("justify-content") }
    elif p.has("justify") == 1 { justify_content = p.get("justify") }

    curr_x = inner_x
    curr_y = inner_y
    extra_gap = 0
    if total_flex == 0 and free_space > 0 {
        if justify_content == "center" {
            if is_row == 1 { curr_x = inner_x + free_space / 2 }
            else { curr_y = inner_y + free_space / 2 }
        } elif justify_content == "end" or justify_content == "flex-end" {
            if is_row == 1 { curr_x = inner_x + free_space }
            else { curr_y = inner_y + free_space }
        } elif justify_content == "space-between" {
            if num_children > 1 {
                extra_gap = free_space / (num_children - 1)
            }
        } elif justify_content == "space-around" {
            if num_children > 0 {
                unit_space = free_space / num_children
                if is_row == 1 { curr_x = inner_x + unit_space / 2 }
                else { curr_y = inner_y + unit_space / 2 }
                extra_gap = unit_space
            }
        }
    }

    ci = 0
    while ci < num_children {
        child = w.children[ci]
        child_w = child.measured_w
        child_h = child.measured_h

        if is_row == 1 {
            if child.flex > 0 and total_flex > 0 {
                child_w = (free_space * child.flex) / total_flex
            }
            child_y = curr_y
            child_avail_h = child_h
            if align_items == "stretch" {
                child_avail_h = inner_h
            } elif align_items == "center" {
                child_y = inner_y + (inner_h - child_h) / 2
                if child_y < inner_y { child_y = inner_y }
            } elif align_items == "end" or align_items == "flex-end" {
                child_y = inner_y + inner_h - child_h
                if child_y < inner_y { child_y = inner_y }
            }
            gui_layout(child, curr_x, child_y, child_w, child_avail_h)
            curr_x = curr_x + child.width + gap + extra_gap
        } else {
            if child.flex > 0 and total_flex > 0 {
                child_h = (free_space * child.flex) / total_flex
            }
            child_x = curr_x
            child_avail_w = child_w
            if align_items == "stretch" {
                child_avail_w = inner_w
            } elif align_items == "center" {
                child_x = inner_x + (inner_w - child_w) / 2
                if child_x < inner_x { child_x = inner_x }
            } elif align_items == "end" or align_items == "flex-end" {
                child_x = inner_x + inner_w - child_w
                if child_x < inner_x { child_x = inner_x }
            }
            gui_layout(child, child_x, curr_y, child_avail_w, child_h)
            curr_y = curr_y + child.height + gap + extra_gap
        }
        ci = ci + 1
    }
}


def layoutWidget(w: Widget, availX: int, availY: int, availW: int, availH: int) {
    gui_measure(w)
    gui_layout(w, availX, availY, availW, availH)
}

def layout_widget(w: Widget, avail_x: int, avail_y: int, avail_w: int, avail_h: int) {
    layoutWidget(w, avail_x, avail_y, avail_w, avail_h)
}


# --- Renderer ---
def renderWidget(w: Widget) {
    p = w.props

    bg_color = -1
    if p.has("background-color") == 1 {
        bg_color = parseColor(p.get("background-color"))
    }

    # On hover / press styling — applies to buttons AND any container/row
    # that declares hover-background-color (enables hover on file rows, sidebar items, etc.)
    has_hover_style = p.has("hover-background-color")
    if w.is_pressed == 1 {
        if p.has("pressed-background-color") == 1 {
            bg_color = parseColor(p.get("pressed-background-color"))
        } elif w.tag == "button" and bg_color >= 0 {
            bg_color = bg_color - 1579032
            if bg_color < 0 { bg_color = 0 }
        }
    } elif w.is_hovered == 1 {
        if p.has("hover-background-color") == 1 {
            bg_color = parseColor(p.get("hover-background-color"))
        } elif w.tag == "button" and bg_color >= 0 {
            bg_color = bg_color + 1381653
        }
    }

    radius = 0
    if p.has("border-radius") == 1 { radius = p.get("border-radius") }

    if bg_color >= 0 {
        drawRect(w.pos_x, w.pos_y, w.width, w.height, bg_color, radius)
    }

    bw = 0
    if p.has("border-width") == 1 { bw = p.get("border-width") }
    if w.is_pressed == 1 and p.has("pressed-border-width") == 1 {
        bw = p.get("pressed-border-width")
    } elif w.is_hovered == 1 and p.has("hover-border-width") == 1 {
        bw = p.get("hover-border-width")
    }

    if bw > 0 {
        bc = -1
        if p.has("border-color") == 1 { bc = parseColor(p.get("border-color")) }
        if w.is_pressed == 1 and p.has("pressed-border-color") == 1 {
            bc = parseColor(p.get("pressed-border-color"))
        } elif w.is_hovered == 1 and p.has("hover-border-color") == 1 {
            bc = parseColor(p.get("hover-border-color"))
        }
        if bc >= 0 {
            drawBorder(w.pos_x, w.pos_y, w.width, w.height, bw, bc)
        }
    }

    if w.tag == "text" {
        fg_color = 0xffffff
        if p.has("color") == 1 { fg_color = parseColor(p.get("color")) }
        if w.is_pressed == 1 and p.has("pressed-color") == 1 {
            fg_color = parseColor(p.get("pressed-color"))
        } elif w.is_hovered == 1 and p.has("hover-color") == 1 {
            fg_color = parseColor(p.get("hover-color"))
        }
        fs = 16
        if p.has("font-size") == 1 { fs = p.get("font-size") }
        fw = 0
        if p.has("font-weight") == 1 and p.get("font-weight") == "bold" { fw = 1 }
        text_y = w.pos_y
        if p.has("padding-top") == 1 { text_y = text_y + p.get("padding-top") }
        drawText(w.text, w.pos_x, text_y, fs, fg_color, fw)
    } elif w.tag == "button" {
        # If button has children, they are rendered by the children loop below
        if len(w.children) == 0 {
            fg_color = 0x11111b
            if p.has("color") == 1 { fg_color = parseColor(p.get("color")) }
            if w.is_pressed == 1 and p.has("pressed-color") == 1 {
                fg_color = parseColor(p.get("pressed-color"))
            } elif w.is_hovered == 1 and p.has("hover-color") == 1 {
                fg_color = parseColor(p.get("hover-color"))
            }
            fs = 16
            if p.has("font-size") == 1 { fs = p.get("font-size") }
            fw = 1
            if p.has("font-weight") == 1 and p.get("font-weight") == "normal" { fw = 0 }
            text_len = strLen(w.text)
            text_w = text_len * (fs / 2 + 1)
            text_x = w.pos_x + (w.width - text_w) / 2
            text_y = w.pos_y + (w.height - fs) / 2 - 2
            if w.is_pressed == 1 { text_y = text_y + 1 }
            drawText(w.text, text_x, text_y, fs, fg_color, fw)
        }
    } elif w.tag == "checkbox" {
        pad_l = 0
        if p.has("padding-left") == 1 { pad_l = p.get("padding-left") }
        pad_t = 0
        if p.has("padding-top") == 1 { pad_t = p.get("padding-top") }

        box_sz = 18
        if p.has("box-size") == 1 { box_sz = p.get("box-size") }
        box_x = w.pos_x + pad_l
        box_y = w.pos_y + pad_t + (w.height - pad_t - box_sz) / 2

        chk_bg = 0x1e1e2e
        if p.has("background-color") == 1 { chk_bg = parseColor(p.get("background-color")) }
        if w.is_hovered == 1 and p.has("hover-background-color") == 1 { chk_bg = parseColor(p.get("hover-background-color")) }

        chk_border = 0x45475a
        if p.has("border-color") == 1 { chk_border = parseColor(p.get("border-color")) }
        if w.is_hovered == 1 and p.has("hover-border-color") == 1 { chk_border = parseColor(p.get("hover-border-color")) }

        is_chk = 0
        if p.has("checked") == 1 { is_chk = p.get("checked") }

        drawRect(box_x, box_y, box_sz, box_sz, chk_bg, 4)
        drawBorder(box_x, box_y, box_sz, box_sz, 1, chk_border)

        if is_chk == 1 {
            accent_col = 0x89b4fa
            if p.has("active-color") == 1 { accent_col = parseColor(p.get("active-color")) }
            drawRect(box_x + 3, box_y + 3, box_sz - 6, box_sz - 6, accent_col, 2)
        }

        if len(w.text) > 0 {
            fs = 14
            if p.has("font-size") == 1 { fs = p.get("font-size") }
            lbl_col = 0xcdd6f4
            if p.has("color") == 1 { lbl_col = parseColor(p.get("color")) }
            if w.is_hovered == 1 and p.has("hover-color") == 1 { lbl_col = parseColor(p.get("hover-color")) }
            lbl_x = box_x + box_sz + 8
            lbl_y = w.pos_y + pad_t + (w.height - pad_t - fs) / 2 - 1
            drawText(w.text, lbl_x, lbl_y, fs, lbl_col, 0)
        }
    } elif w.tag == "toggle" {
        pad_l = 0
        if p.has("padding-left") == 1 { pad_l = p.get("padding-left") }
        pad_t = 0
        if p.has("padding-top") == 1 { pad_t = p.get("padding-top") }

        is_on = 0
        if p.has("is_on") == 1 { is_on = p.get("is_on") }
        elif p.has("checked") == 1 { is_on = p.get("checked") }

        track_w = 44
        track_h = 24
        track_x = w.pos_x + pad_l
        track_y = w.pos_y + pad_t + (w.height - pad_t - track_h) / 2

        track_col = 0x313244
        if is_on == 1 {
            track_col = 0xa6e3a1
            if p.has("active-color") == 1 { track_col = parseColor(p.get("active-color")) }
        } else {
            if p.has("inactive-color") == 1 { track_col = parseColor(p.get("inactive-color")) }
        }

        drawRect(track_x, track_y, track_w, track_h, track_col, track_h / 2)

        thumb_sz = track_h - 4
        thumb_col = 0xffffff
        if is_on == 1 {
            thumb_col = 0x11111b
            if p.has("thumb-color") == 1 { thumb_col = parseColor(p.get("thumb-color")) }
            thumb_x = track_x + track_w - thumb_sz - 2
        } else {
            if p.has("thumb-color") == 1 { thumb_col = parseColor(p.get("thumb-color")) }
            thumb_x = track_x + 2
        }
        thumb_y = track_y + 2
        drawRect(thumb_x, thumb_y, thumb_sz, thumb_sz, thumb_col, thumb_sz / 2)
    } elif w.tag == "slider" {
        pad_l = 0
        if p.has("padding-left") == 1 { pad_l = p.get("padding-left") }
        pad_t = 0
        if p.has("padding-top") == 1 { pad_t = p.get("padding-top") }

        val = 0
        if p.has("value") == 1 { val = p.get("value") }
        min_v = 0
        if p.has("min") == 1 { min_v = p.get("min") }
        max_v = 100
        if p.has("max") == 1 { max_v = p.get("max") }
        if max_v <= min_v { max_v = min_v + 1 }

        if val < min_v { val = min_v }
        if val > max_v { val = max_v }

        track_h = 6
        track_y = w.pos_y + pad_t + (w.height - pad_t - track_h) / 2
        track_x = w.pos_x + pad_l
        track_w = w.width - pad_l
        if p.has("padding-right") == 1 { track_w = track_w - p.get("padding-right") }
        if track_w < 20 { track_w = 20 }

        track_bg = 0x313244
        if p.has("track-bg") == 1 { track_bg = parseColor(p.get("track-bg")) }
        drawRect(track_x, track_y, track_w, track_h, track_bg, 3)

        fill_col = 0x89b4fa
        if p.has("fill-color") == 1 { fill_col = parseColor(p.get("fill-color")) }
        range_span = max_v - min_v
        fill_w = ((val - min_v) * track_w) / range_span
        if fill_w > 0 {
            drawRect(track_x, track_y, fill_w, track_h, fill_col, 3)
        }

        thumb_sz = 16
        thumb_x = track_x + fill_w - (thumb_sz / 2)
        if thumb_x < track_x { thumb_x = track_x }
        if thumb_x > (track_x + track_w - thumb_sz) { thumb_x = track_x + track_w - thumb_sz }
        thumb_y = track_y + (track_h - thumb_sz) / 2
        thumb_col = 0xcdd6f4
        if w.is_hovered == 1 or w.is_pressed == 1 { thumb_col = 0xffffff }
        if p.has("thumb-color") == 1 { thumb_col = parseColor(p.get("thumb-color")) }
        drawRect(thumb_x, thumb_y, thumb_sz, thumb_sz, thumb_col, thumb_sz / 2)
    } elif w.tag == "dropdown" {
        pad_l = 8
        if p.has("padding-left") == 1 { pad_l = p.get("padding-left") }

        dd_bg = 0x2d2d3d
        if p.has("background-color") == 1 { dd_bg = parseColor(p.get("background-color")) }
        if w.is_hovered == 1 and p.has("hover-background-color") == 1 { dd_bg = parseColor(p.get("hover-background-color")) }

        dd_border = 0x45475a
        if p.has("border-color") == 1 { dd_border = parseColor(p.get("border-color")) }
        if w.is_hovered == 1 and p.has("hover-border-color") == 1 { dd_border = parseColor(p.get("hover-border-color")) }

        drawRect(w.pos_x, w.pos_y, w.width, w.height, dd_bg, 4)
        drawBorder(w.pos_x, w.pos_y, w.width, w.height, 1, dd_border)

        sel_idx = 0
        if p.has("selected") == 1 { sel_idx = p.get("selected") }
        opts = []
        if p.has("options") == 1 { opts = p.get("options") }

        sel_text = "Select..."
        if sel_idx >= 0 and sel_idx < len(opts) {
            sel_text = opts[sel_idx]
        }

        fs = 13
        if p.has("font-size") == 1 { fs = p.get("font-size") }
        fg = 0xcdd6f4
        if p.has("color") == 1 { fg = parseColor(p.get("color")) }
        ty = w.pos_y + (w.height - fs) / 2 - 1
        drawText(sel_text, w.pos_x + pad_l, ty, fs, fg, 0)

        arr_x = w.pos_x + w.width - 20
        drawText("v", arr_x, ty, fs - 2, 0x6c7086, 1)
    } elif w.tag == "canvas" {
        cv_bg = -1
        if p.has("background-color") == 1 { cv_bg = parseColor(p.get("background-color")) }
        if cv_bg >= 0 {
            drawRect(w.pos_x, w.pos_y, w.width, w.height, cv_bg, 4)
        }
        if p.has("border-color") == 1 {
            drawBorder(w.pos_x, w.pos_y, w.width, w.height, 1, parseColor(p.get("border-color")))
        }
    } elif w.tag == "input" {
        # Text input field — renders placeholder or value text with cursor indicator
        is_focused = 0
        if p.has("is_focused") == 1 { is_focused = p.get("is_focused") }

        if is_focused == 1 {
            focus_border = 0x89b4fa
            if p.has("focus-border-color") == 1 { focus_border = parseColor(p.get("focus-border-color")) }
            drawBorder(w.pos_x, w.pos_y, w.width, w.height, 2, focus_border)
        }

        fg_color = 0x9d9d9d
        if p.has("color") == 1 { fg_color = parseColor(p.get("color")) }
        fs = 13
        if p.has("font-size") == 1 { fs = p.get("font-size") }
        pad_l = 12
        if p.has("padding-left") == 1 { pad_l = p.get("padding-left") }
        tx = w.pos_x + pad_l
        ty = w.pos_y + (w.height - fs) / 2 - 1
        display = w.text
        if display == "" {
            if is_focused == 1 {
                display = "|"
                fg_color = 0x89b4fa
            } else {
                display = w.props.get("placeholder")
            }
        } else {
            fg_color = 0xffffff
            if p.has("text-color") == 1 { fg_color = parseColor(p.get("text-color")) }
            if is_focused == 1 {
                display = display + "|"
            }
        }
        drawText(display, tx, ty, fs, fg_color, 0)
    } elif w.tag == "textarea" {
        fs = 13
        if p.has("font-size") == 1 { fs = p.get("font-size") }
        fg_col = 0xcdd6f4
        if p.has("color") == 1 { fg_col = parseColor(p.get("color")) }
        pad_l = 10
        if p.has("padding-left") == 1 { pad_l = p.get("padding-left") }
        pad_t = 10
        if p.has("padding-top") == 1 { pad_t = p.get("padding-top") }
        drawText(w.text, w.pos_x + pad_l, w.pos_y + pad_t, fs, fg_col, 0)
    } elif w.tag == "image" {
        img_bg = 0x181825
        if p.has("background-color") == 1 { img_bg = parseColor(p.get("background-color")) }
        drawRect(w.pos_x, w.pos_y, w.width, w.height, img_bg, 4)
        drawBorder(w.pos_x, w.pos_y, w.width, w.height, 1, 0x45475a)
        drawText("[Image: " + w.text + "]", w.pos_x + 6, w.pos_y + (w.height - 12) / 2, 11, 0x6c7086, 0)
    }

    # Render children
    ci = 0
    while ci < len(w.children) {
        child = w.children[ci]
        renderWidget(child)
        ci = ci + 1
    }
}

def render_widget(w: Widget) {
    renderWidget(w)
}

# --- Hit Testing ---
def hitTestEx(w: Widget, mx: int, my: int, isClick: int, isMouseDown: int) -> int {
    clicked_id = 0
    if mx >= w.pos_x and mx <= (w.pos_x + w.width) and my >= w.pos_y and my <= (w.pos_y + w.height) {
        w.is_hovered = 1
        if isMouseDown == 1 {
            w.is_pressed = 1
        } else {
            w.is_pressed = 0
        }
        if isClick == 1 and w.on_click_id > 0 {
            clicked_id = w.on_click_id
        }
        if isClick == 1 and w.tag == "input" {
            w.props.set("is_focused", 1)
        }

        # Slider interaction on click or mouse drag
        if w.tag == "slider" and (isClick == 1 or isMouseDown == 1) {
            p = w.props
            min_v = 0
            if p.has("min") == 1 { min_v = p.get("min") }
            max_v = 100
            if p.has("max") == 1 { max_v = p.get("max") }
            if max_v <= min_v { max_v = min_v + 1 }
            pad_l = 0
            if p.has("padding-left") == 1 { pad_l = p.get("padding-left") }
            track_w = w.width - pad_l
            if p.has("padding-right") == 1 { track_w = track_w - p.get("padding-right") }
            if track_w < 10 { track_w = 10 }
            rel_x = mx - (w.pos_x + pad_l)
            if rel_x < 0 { rel_x = 0 }
            if rel_x > track_w { rel_x = track_w }
            calc_val = min_v + (rel_x * (max_v - min_v)) / track_w
            p.set("value", calc_val)
            if p.has("target") == 1 {
                tgt = p.get("target")
                pfx = ""
                sfx = ""
                if p.has("prefix") == 1 { pfx = p.get("prefix") }
                if p.has("suffix") == 1 { sfx = p.get("suffix") }
                tgt.text = pfx + str(calc_val) + sfx
            }
            if p.has("on_change") == 1 {
                call(p.get("on_change"), [calc_val])
            }
        }
    } else {
        w.is_hovered = 0
        w.is_pressed = 0
        if isClick == 1 and w.tag == "input" {
            w.props.set("is_focused", 0)
        }
    }

    ci = 0
    while ci < len(w.children) {
        child = w.children[ci]
        child_res = hitTestEx(child, mx, my, isClick, isMouseDown)
        if child_res > 0 {
            clicked_id = child_res
        }
        ci = ci + 1
    }
    return clicked_id
}

def hitTest(w: Widget, mx: int, my: int, isClick: int) -> int {
    return hitTestEx(w, mx, my, isClick, gui_get_mouse_down())
}

def hit_test_and_dispatch(w: Widget, mx: int, my: int, is_click: int) -> int {
    return hitTest(w, mx, my, is_click)
}

# --- Action Dispatcher ---
def dispatchAction(w: Widget, clickedId: int) {
    if w.on_click_id == clickedId {
        p = w.props
        clicks = 0
        if p.has("clicks") == 1 { clicks = p.get("clicks") }
        clicks = clicks + 1
        p.set("clicks", clicks)

        # Checkbox toggle
        if w.tag == "checkbox" {
            chk = 0
            if p.has("checked") == 1 { chk = p.get("checked") }
            chk = 1 - chk
            p.set("checked", chk)
            if p.has("bind") == 1 {
                s = p.get("bind")
                state_set_int(s, chk)
            } elif p.has("state") == 1 {
                s = p.get("state")
                state_set_int(s, chk)
            }
            if p.has("on_toggle") == 1 {
                call(p.get("on_toggle"), [chk])
            }
        }

        # Toggle switch toggle
        if w.tag == "toggle" {
            cur_on = 0
            if p.has("is_on") == 1 { cur_on = p.get("is_on") }
            elif p.has("checked") == 1 { cur_on = p.get("checked") }
            cur_on = 1 - cur_on
            p.set("is_on", cur_on)
            p.set("checked", cur_on)
            if p.has("bind") == 1 {
                s = p.get("bind")
                state_set_int(s, cur_on)
            } elif p.has("state") == 1 {
                s = p.get("state")
                state_set_int(s, cur_on)
            }
            if p.has("on_toggle") == 1 {
                call(p.get("on_toggle"), [cur_on])
            }
        }

        # Dropdown selection advance
        if w.tag == "dropdown" {
            sel = 0
            if p.has("selected") == 1 { sel = p.get("selected") }
            opts = []
            if p.has("options") == 1 { opts = p.get("options") }
            if len(opts) > 0 {
                sel = (sel + 1) % len(opts)
                p.set("selected", sel)
                if p.has("bind") == 1 {
                    s = p.get("bind")
                    state_set_int(s, sel)
                } elif p.has("state") == 1 {
                    s = p.get("state")
                    state_set_int(s, sel)
                }
                if p.has("on_change") == 1 {
                    call(p.get("on_change"), [sel])
                }
            }
        }

        # User-defined callback or action via onClick / on_click
        click_handler = ""
        has_click_handler = 0
        if p.has("onClick") == 1 {
            click_handler = p.get("onClick")
            has_click_handler = 1
        } elif p.has("on_click") == 1 {
            click_handler = p.get("on_click")
            has_click_handler = 1
        }

        if has_click_handler == 1 {
            if click_handler == "submit" or click_handler == "copy_text" or click_handler == "clear" or click_handler == "increment" or click_handler == "reset" or click_handler == "toggle" {
                if p.has("action") == 0 {
                    p.set("action", click_handler)
                }
            }
        }

        # Built-in named actions (kept for convenience)
        if p.has("action") == 1 {
            act = p.get("action")
            if act == "increment" {
                if p.has("state") == 1 {
                    s = p.get("state")
                    state_set_int(s, s.val_int + 1)
                } elif p.has("bind") == 1 {
                    s = p.get("bind")
                    state_set_int(s, s.val_int + 1)
                } elif p.has("target") == 1 {
                    tgt = p.get("target")
                    target_count = 0
                    if tgt.props.has("action-count") == 1 {
                        target_count = tgt.props.get("action-count")
                    }
                    target_count = target_count + 1
                    tgt.props.set("action-count", target_count)
                    pfx = ""
                    sfx = ""
                    if p.has("prefix") == 1 { pfx = p.get("prefix") }
                    if p.has("suffix") == 1 { sfx = p.get("suffix") }
                    tgt.text = pfx + str(target_count) + sfx
                }
            } elif act == "reset" {
                if p.has("state") == 1 {
                    s = p.get("state")
                    state_set_int(s, 0)
                } elif p.has("bind") == 1 {
                    s = p.get("bind")
                    state_set_int(s, 0)
                } elif p.has("target") == 1 {
                    tgt = p.get("target")
                    p.set("clicks", 0)
                    tgt.props.set("action-count", 0)
                    if p.has("linked-button") == 1 {
                        lbtn = p.get("linked-button")
                        lbtn_p = lbtn.props
                        lbtn_p.set("clicks", 0)
                    }
                    pfx = ""
                    sfx = ""
                    if p.has("prefix") == 1 { pfx = p.get("prefix") }
                    if p.has("suffix") == 1 { sfx = p.get("suffix") }
                    tgt.text = pfx + "0" + sfx
                }
            } elif act == "toggle" {
                if p.has("state") == 1 {
                    s = p.get("state")
                    state_set_int(s, 1 - s.val_int)
                } elif p.has("bind") == 1 {
                    s = p.get("bind")
                    state_set_int(s, 1 - s.val_int)
                } elif p.has("target") == 1 {
                    tgt = p.get("target")
                    t1 = p.get("state1")
                    t2 = p.get("state2")
                    if tgt.text == t1 {
                        tgt.text = t2
                    } else {
                        tgt.text = t1
                    }
                }
            } elif act == "submit" or act == "copy_text" {
                src_text = ""
                if p.has("source") == 1 {
                    src_w = p.get("source")
                    src_text = src_w.text
                }
                pfx = ""
                sfx = ""
                if p.has("prefix") == 1 { pfx = p.get("prefix") }
                if p.has("suffix") == 1 { sfx = p.get("suffix") }
                out_val = pfx + src_text + sfx
                if p.has("state") == 1 {
                    s = p.get("state")
                    state_set_str(s, out_val)
                } elif p.has("bind") == 1 {
                    s = p.get("bind")
                    state_set_str(s, out_val)
                }
                if p.has("target") == 1 {
                    tgt_w = p.get("target")
                    tgt_w.text = out_val
                } else {
                    w.text = out_val
                }
            } elif act == "clear" {
                if p.has("state") == 1 {
                    s = p.get("state")
                    state_set_str(s, "")
                } elif p.has("bind") == 1 {
                    s = p.get("bind")
                    state_set_str(s, "")
                }
                if p.has("target") == 1 {
                    tgt_w = p.get("target")
                    tgt_w.text = ""
                }
            } elif act == "set_text" or act == "set_val" {
                val_to_set = ""
                if p.has("value") == 1 { val_to_set = p.get("value") }
                if p.has("state") == 1 {
                    s = p.get("state")
                    state_set_str(s, val_to_set)
                } elif p.has("bind") == 1 {
                    s = p.get("bind")
                    state_set_str(s, val_to_set)
                }
                if p.has("target") == 1 {
                    tgt_w = p.get("target")
                    tgt_w.text = val_to_set
                }
            } elif act == "toggle_theme" {
                new_theme = toggle_theme()
                if p.has("target") == 1 {
                    tgt_w = p.get("target")
                    pfx = ""
                    if p.has("prefix") == 1 { pfx = p.get("prefix") }
                    tgt_w.text = pfx + new_theme
                }
            }
        }
        if p.has("log-target") == 1 {
            log_w = p.get("log-target")
            log_w.text = "  [ACTION] " + w.text + " clicked! Total: " + str(clicks)
        }
    }

    ci = 0
    while ci < len(w.children) {
        child = w.children[ci]
        dispatchAction(child, clickedId)
        ci = ci + 1
    }
}

# --- Keyboard Event Dispatcher ---
def _dispatch_key_event(w: Widget, key: int) {
    if w.tag == "input" {
        p = w.props
        if p.has("is_focused") == 1 and p.get("is_focused") == 1 {
            text_changed = 0
            if key == 8 {
                # Backspace
                w.text = _str_delete_last(w.text)
                text_changed = 1
            } elif key == 127 {
                # Delete: clear text
                w.text = ""
                text_changed = 1
            } elif key == 13 {
                # Enter / Return
                if p.has("on_submit") == 1 {
                    call(p.get("on_submit"), [w.text])
                }
            } elif key >= 32 and key <= 126 {
                ch_str = gui_char_to_str(key)
                w.text = w.text + ch_str
                text_changed = 1
            }

            if text_changed == 1 {
                if p.has("bind") == 1 {
                    s = p.get("bind")
                    s.val_str = w.text
                    state_notify(s)
                } elif p.has("state") == 1 {
                    s = p.get("state")
                    s.val_str = w.text
                    state_notify(s)
                }
            }
        }
    }

    ci = 0
    while ci < len(w.children) {
        _dispatch_key_event(w.children[ci], key)
        ci = ci + 1
    }
}

# --- Interactive App Step ---
def runAppStep(app: WindowApp, mx: int, my: int, isClick: int) -> int {
    win_w = gui_get_window_w()
    win_h = gui_get_window_h()
    if win_w > 0 and win_h > 0 {
        app.width = win_w
        app.height = win_h
    }

    # Layout must precede hit testing so every widget has current bounds.
    layoutWidget(app.root, 0, 0, app.width, app.height)

    # Poll keyboard events and route to focused inputs
    k = gui_poll_char()
    while k > 0 {
        _dispatch_key_event(app.root, k)
        k = gui_poll_char()
    }

    is_down = gui_get_mouse_down()
    clicked = hitTestEx(app.root, mx, my, isClick, is_down)

    if clicked > 0 {
        dispatchAction(app.root, clicked)
    }

    # Clear window background
    bg = 0x1e1e2e
    if app.props.has("background-color") == 1 {
        bg = parseColor(app.props.get("background-color"))
    }
    gui_clear(bg)

    # Render widget tree
    renderWidget(app.root)

    # Present backbuffer
    gui_present()
    return clicked
}

def run_app_step(app: WindowApp, mx: int, my: int, is_click: int) -> int {
    return runAppStep(app, mx, my, is_click)
}

# --- Automatic Lifecycle GUI Entry Point ---
def gui(title: string, width: int, height: int, root: Widget, properties: dict) {
    # Apply NSS styling if style or nss path is provided in properties
    if properties.has("style") == 1 or properties.has("nss") == 1 {
        style_path = ""
        if properties.has("style") == 1 { style_path = properties.get("style") }
        else { style_path = properties.get("nss") }
        st = nss.nss_load(style_path)
        if st.has("ID__window") == 1 {
            nss._merge_props(properties, st.get("ID__window"))
        } elif st.has("CLS__window") == 1 {
            nss._merge_props(properties, st.get("CLS__window"))
        } elif st.has("TAG__window") == 1 {
            nss._merge_props(properties, st.get("TAG__window"))
        }
        nss.nss_apply(root, st)
    }

    ok = initWindow(title, width, height)
    if ok != 1 {
        print("ERROR: gui_init_window failed (returned " + str(ok) + "). Window could not be created.")
        return
    }

    app = window(title, width, height, root, properties)

    # Check for --test and --screenshot modes
    args = system.get_args()
    max_frames = 0
    screenshot_path = ""
    if properties.has("screenshot") == 1 {
        screenshot_path = properties.get("screenshot")
        max_frames = 5
    }
    if properties.has("test") == 1 {
        max_frames = 30
    }
    ai = 1
    while ai < len(args) {
        if args[ai] == "--test" {
            max_frames = 30
        }
        if args[ai] == "--screenshot" and (ai + 1) < len(args) {
            screenshot_path = args[ai + 1]
            max_frames = 5
        }
        ai = ai + 1
    }

    frame = 0
    running = 1
    while running == 1 {
        ev = pollEvents()
        if ev == -1 {
            print("gui_run: pollEvents returned -1 at frame " + str(frame))
            running = 0
            break
        }

        cords = get_mouseCord()
        mx = cords[0]
        my = cords[1]
        clicked = gui_get_mouse_clicked()

        runAppStep(app, mx, my, clicked)

        if len(screenshot_path) > 0 and frame == 2 {
            sc_ok = saveScreenshot(screenshot_path)
            if sc_ok == 1 {
                print("Screenshot saved to: " + screenshot_path)
            } else {
                print("Screenshot FAILED for: " + screenshot_path)
            }
        }

        gui_sleep(4)
        frame = frame + 1
        if max_frames > 0 and frame >= max_frames {
            running = 0
            break
        }
    }
    closeWindow()
    print("Demo completed successfully!")
}

# =============================================================================
# NEW DECLARATIVE API  -  Nova GUI v2
# =============================================================================
# Shorthand props:  bg, hover, press, color, size, bold, r (radius),
#                   p/px/py/pl/pr/pt/pb, gap, w, h,
#                   border, border_color, align, justify,
#                   action/on_click, target, prefix, suffix,
#                   placeholder, id, flex, log, state1, state2
#
# Constructors: div, row, col, btn, h1, h2, h3, txt, label, badge,
#               spacer, gap_w, divider, input_field, icon_btn, nav_item, card
# =============================================================================

def _expand_props(p: dict) -> dict {
    out = {}
    all_k = p.keys()
    aki = 0
    while aki < len(all_k) {
        k = all_k[aki]
        v = p.get(k)
        if k == "bg" { out.set("background-color", v) }
        elif k == "hover" { out.set("hover-background-color", v) }
        elif k == "press" { out.set("pressed-background-color", v) }
        elif k == "color" { out.set("color", v) }
        elif k == "size" { out.set("font-size", v) }
        elif k == "bold" { if v == 1 { out.set("font-weight", "bold") } }
        elif k == "r" { out.set("border-radius", v) }
        elif k == "border" { out.set("border-width", v) }
        elif k == "border_color" { out.set("border-color", v) }
        elif k == "gap" { out.set("gap", v) }
        elif k == "w" { out.set("width", v) }
        elif k == "h" { out.set("height", v) }
        elif k == "min_w" { out.set("min_w", v) }
        elif k == "max_w" { out.set("max_w", v) }
        elif k == "min_h" { out.set("min_h", v) }
        elif k == "max_h" { out.set("max_h", v) }
        elif k == "align" { out.set("align-items", v) }
        elif k == "justify" { out.set("justify-content", v) }
        elif k == "action" { out.set("action", v) }
        elif k == "onClick" or k == "onclick" or k == "on_click" { out.set("on_click", v) out.set("onClick", v) }
        elif k == "log" { out.set("log-target", v) }
        elif k == "p" { out.set("padding", v) }
        elif k == "px" { out.set("padding-left", v) out.set("padding-right", v) }
        elif k == "py" { out.set("padding-top", v) out.set("padding-bottom", v) }
        elif k == "pl" { out.set("padding-left", v) }
        elif k == "pr" { out.set("padding-right", v) }
        elif k == "pt" { out.set("padding-top", v) }
        elif k == "pb" { out.set("padding-bottom", v) }
        else { out.set(k, v) }
        aki = aki + 1
    }
    return out
}

def checkbox(text: string, is_checked: int, props: dict) -> Widget {
    return Checkbox(text, is_checked, 0, props)
}

def toggle(is_on: int, props: dict) -> Widget {
    return Toggle("", is_on, 0, props)
}

def slider(value: int, min_val: int, max_val: int, props: dict) -> Widget {
    return Slider(value, min_val, max_val, 0, props)
}

def dropdown(options: list, selected_index: int, props: dict) -> Widget {
    return Dropdown(options, selected_index, 0, props)
}

def canvas(children: list, props: dict) -> Widget {
    p = _expand_props(props)
    w = Container(children, p)
    w.tag = "canvas"
    return w
}

def div(class: string, id: string, children: list, props: dict) -> Widget {
    p = _expand_props(props)
    if len(class) > 0 { p.set("class", class) }
    if len(id) > 0 { p.set("id", id) }
    return Container(children, p)
}

def row(class: string, id: string, children: list, props: dict) -> Widget {
    p = _expand_props(props)
    if len(class) > 0 { p.set("class", class) }
    if len(id) > 0 { p.set("id", id) }
    if p.has("flex-direction") == 0 { p.set("flex-direction", "row") }
    return Container(children, p)
}

def col(class: string, id: string, children: list, props: dict) -> Widget {
    p = _expand_props(props)
    if len(class) > 0 { p.set("class", class) }
    if len(id) > 0 { p.set("id", id) }
    if p.has("flex-direction") == 0 { p.set("flex-direction", "column") }
    return Container(children, p)
}

def btn(class: string, id: string, onClick: string, text: string, props: dict) -> Widget {
    p = _expand_props(props)
    if len(class) > 0 { p.set("class", class) }
    if len(id) > 0 { p.set("id", id) }
    if len(onClick) > 0 {
        p.set("onClick", onClick)
        p.set("on_click", onClick)
        p.set("action", onClick)
    }
    return Button(text, gui_next_click_id(), p)
}

def h1(class: string, id: string, text: string, props: dict) -> Widget {
    p = _expand_props(props)
    if len(class) > 0 { p.set("class", class) }
    if len(id) > 0 { p.set("id", id) }
    return Title(text, p)
}

def h2(class: string, id: string, text: string, props: dict) -> Widget {
    p = _expand_props(props)
    if len(class) > 0 { p.set("class", class) }
    if len(id) > 0 { p.set("id", id) }
    return Heading(text, p)
}

