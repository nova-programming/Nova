{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nova",
  "scopeName": "source.nova",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#decorators" },
    { "include": "#function-declarations" },
    { "include": "#type-declarations" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.nova",
          "match": "#.*$"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "entity.name.function.decorator.nova",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "\\b(def)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.function.nova" },
            "2": { "name": "entity.name.function.nova" }
          }
        }
      ]
    },
    "type-declarations": {
      "patterns": [
        {
          "match": "\\b(class|data)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.type.nova" },
            "2": { "name": "entity.name.type.class.nova" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nova",
          "match": "\\b(if|elif|else|while|for|in|return|break|continue|try|except|finally|raise|defer)\\b"
        },
        {
          "name": "keyword.control.import.nova",
          "match": "\\b(import|as)\\b"
        },
        {
          "name": "keyword.operator.logical.nova",
          "match": "\\b(and|or|not|is)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.nova",
          "match": "\\b(int|float|string|bool|list|dict|any|void)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.nova",
          "match": "\\b(True|False|None|true|false|null)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.nova",
          "match": "\\b(print|len|str|int|float|range|append|char_code|str_sub|file_open|file_read|file_write|file_close|alloc|free|sizeof|random)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.nova",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.nova",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.float.nova",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.decimal.nova",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nova",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nova",
              "match": "\\\\([\\\\\"'nrtbfv]|u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2})"
            },
            {
              "name": "meta.interpolation.nova",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.nova" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.nova" } },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.nova",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.nova",
              "match": "\\\\([\\\\\"'nrtbfv]|u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2})"
            }
          ]
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.nova",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.nova",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.nova",
          "match": "(=|\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.arithmetic.nova",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.nova",
          "match": "(,|:)"
        },
        {
          "name": "punctuation.bracket.nova",
          "match": "(\\{|\\}|\\[|\\]|\\(|\\))"
        }
      ]
    }
  }
}

